---
import '../styles/global.css';
import '../styles/editorial-ui.css';
import Logo from '../components/Logo.astro';
import LegalNotice from '../components/LegalNotice.astro';
import {getLaunchReadiness} from '../lib/launch-readiness.mjs';
import {getSiteOrigin} from '../lib/site-origin.mjs';
import AgeConfirmation from '../components/AgeConfirmation.astro';import {adultSectionSlugs,tobaccoGuides} from '../data/tobacco-information';
import {shop, mainPages, pathFor, text} from '../data/shop';
const {title=shop.name,description='',lang='it',slug='',theme='',noindex=false,alternate=true,schema=null,image='/images/hero/portico.webp'}=Astro.props;
const launch=getLaunchReadiness({siteUrl:import.meta.env.PUBLIC_SITE_URL,launchRequested:import.meta.env.PUBLIC_LAUNCH_READY,shop});
const configured=getSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const ready=launch.ready;
const canonicalPath=Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname;
const canonical=new URL(canonicalPath,configured).href;
const storeId=new URL('/#store',configured).href;
const websiteId=new URL('/#website',configured).href;
const webpageId=`${canonical}#webpage`;
const breadcrumbId=`${canonical}#breadcrumb`;
const other=lang==='it'?'en':'it';
const nav=['il-negozio','catalogo'];
const menuGroups=[{it:'Scopri il negozio',en:'Discover the shop',slugs:['il-negozio','il-quartiere','storia-e-serrande','marchi-e-competenze','recensioni','contatti']},{it:'Articoli e occasioni',en:'Items and occasions',slugs:['catalogo','idee-regalo','profumi-raptus','giochi-e-giocattoli','cartoleria','souvenir-bologna','feste-e-compleanni','dolciumi','sale-di-cervia','accessori-telefono','piccole-necessita']},{it:'Servizi e informazioni',en:'Services and information',slugs:['servizi','deposito-bagagli','ricevitoria','sigari','pipe-e-tabacchi-da-pipa','accendini-e-accessori']}];
const json=(o:any)=>JSON.stringify(o).replace(/</g,'\\u003c');
const entity={'@context':'https://schema.org','@type':'Store','@id':storeId,name:shop.name,url:configured,logo:{'@type':'ImageObject',url:new URL('/brand/guerrazzi-logo.webp',configured).href},address:{'@type':'PostalAddress',streetAddress:shop.address,postalCode:shop.postcode,addressLocality:shop.city,addressCountry:'IT'},...(shop.phone?{telephone:shop.phone}:{}),description:text(lang,'Giochi e giocattoli, cartoleria, idee regalo, souvenir di Bologna, profumi, dolciumi e servizi in Via Guerrazzi 10/F.','Toys and games, stationery, gift ideas, Bologna souvenirs, perfumes, sweets and services at Via Guerrazzi 10/F.'),...(shop.legalName?{legalName:shop.legalName}:{}),...(shop.vat?{vatID:shop.vat}:{}),...(shop.email?{email:shop.email}:{}),openingHoursSpecification:shop.hours.map(h=>({'@type':'OpeningHoursSpecification',dayOfWeek:h.days.map(d=>`https://schema.org/${d}`),opens:h.opens,closes:h.closes})),sameAs:[shop.instagram],hasMap:shop.maps,areaServed:{'@type':'City',name:'Bologna'}};
const website={'@context':'https://schema.org','@type':'WebSite','@id':websiteId,url:configured,name:shop.name,inLanguage:['it','en'],publisher:{'@id':storeId}};
const extraSchemas=(schema?(Array.isArray(schema)?schema:[schema]):[]).filter(Boolean).map((node:any,index:number)=>({'@id':`${canonical}#${String(node['@type']||'entity').toLowerCase()}-${index+1}`,...node}));
const pageName=mainPages.find(p=>p.slug===slug);
const parentSlug=slug.startsWith('assortimento/')||slug.startsWith('catalogo/')?'catalogo':slug.startsWith('marchi/')?'marchi-e-competenze':slug.startsWith('servizi/')?'servizi':slug.startsWith('sigari/')?'sigari':slug.startsWith('approfondimenti/')?'approfondimenti':slug.startsWith('schede/')?tobaccoGuides[slug.slice(7)]?.parent:'';
const parentPage=mainPages.find(p=>p.slug===parentSlug);
const breadcrumbEntries=[{name:'Home',item:new URL(pathFor('',lang),configured).href},...(parentSlug?[{name:parentPage?(lang==='it'?parentPage.it:parentPage.en):text(lang,'Il diario','Journal'),item:new URL(pathFor(parentSlug,lang),configured).href}]:[]),{name:pageName?(lang==='it'?pageName.it:pageName.en):title,item:canonical}];
const webpage={'@context':'https://schema.org','@type':'WebPage','@id':webpageId,url:canonical,name:title,description,inLanguage:lang,about:{'@id':storeId},isPartOf:{'@id':websiteId},primaryImageOfPage:{'@type':'ImageObject',contentUrl:new URL(image,configured).href},...(slug?{breadcrumb:{'@id':breadcrumbId}}:{})};
const breadcrumb=slug?{'@context':'https://schema.org','@type':'BreadcrumbList','@id':breadcrumbId,itemListElement:breadcrumbEntries.map((entry,position)=>({'@type':'ListItem',position:position+1,...entry}))}:null;
const adultSection=adultSectionSlugs.includes(slug)||slug.startsWith('sigari/');
const guideParent=slug.startsWith('schede/')?tobaccoGuides[slug.slice(7)]?.parent:'';
const noticeKind=slug==='ricevitoria'?'gambling':slug==='accendini-e-accessori'?'accessories':slug==='pipe-e-tabacchi-da-pipa'||guideParent==='pipe-e-tabacchi-da-pipa'?'pipe':'tobacco';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0645c0"/><title>{title.includes(shop.name)?title:`${title} | Guerrazzi`}</title><meta name="description" content={description}/><meta name="robots" content={noindex||!ready?'noindex,nofollow':'index,follow'}/>{canonical&&<link rel="canonical" href={canonical}/>}{configured&&alternate&&<><link rel="alternate" hreflang="it" href={new URL(pathFor(slug,'it'),configured).href}/><link rel="alternate" hreflang="en" href={new URL(pathFor(slug,'en'),configured).href}/><link rel="alternate" hreflang="x-default" href={new URL(pathFor(slug,'it'),configured).href}/></>}
<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/><link rel="preload" href="/fonts/bodoni-moda-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/manrope-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/>
{adultSection&&<script is:inline>try{if(sessionStorage.getItem('guerrazzi-adult-session-v1')!=='yes')document.documentElement.classList.add('age-pending')}catch{document.documentElement.classList.add('age-pending')}</script>}
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content={lang==='it'?'it_IT':'en_GB'}/>{canonical&&<meta property="og:url" content={canonical}/>}
{configured&&<><meta property="og:image" content={new URL(image,configured).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={new URL(image,configured).href}/></>}
<script type="application/ld+json" set:html={json([entity,website,webpage,...(breadcrumb?[breadcrumb]:[]),...extraSchemas])}/>
</head><body class={theme?`theme-${theme}`:''}>
<a class="skip-link" href="#main">{text(lang,'Vai al contenuto','Skip to content')}</a>
<header class="site-header centered-header"><nav class="desktop-nav" aria-label={text(lang,'Navigazione principale','Main navigation')}>{nav.map(s=>{const p=mainPages.find(p=>p.slug===s)!;return <a href={pathFor(s,lang)} aria-current={slug===s?'page':undefined}>{lang==='it'?p.it:p.en}</a>})}<details class="category-menu"><summary>{text(lang,'Esplora','Explore')} <span aria-hidden="true">⌄</span></summary><div class="category-dropdown">{menuGroups.map(group=><section><p>{text(lang,group.it,group.en)}</p>{group.slugs.map(s=>{const p=mainPages.find(p=>p.slug===s)!;return <a href={pathFor(s,lang)} aria-current={slug===s?'page':undefined}>{lang==='it'?p.it:p.en}{adultSectionSlugs.includes(s)&&<small>18+</small>}</a>})}</section>)}</div></details></nav><a class="home-logo" href={pathFor('',lang)} aria-label={shop.name}><Logo/></a><div class="header-actions"><a class="desktop-header-link" href={pathFor('servizi',lang)}>{text(lang,'Servizi','Services')}</a><a class="desktop-header-link luggage-header-link" href={pathFor('deposito-bagagli',lang)}>{text(lang,'Deposito bagagli','Luggage storage')} </a>{alternate&&<a class="language" href={pathFor(slug,other)} hreflang={other} lang={other} aria-label={lang==='it'?'Read in English':'Leggi in italiano'}>{other.toUpperCase()}</a>}<button class="menu-toggle" aria-expanded="false" aria-controls="site-menu"><span></span><span></span><span class="sr-only">{text(lang,'Apri menu','Open menu')}</span></button></div></header>
<dialog id="site-menu" class="site-menu"><div class="menu-top"><Logo/><button data-close-menu aria-label={text(lang,'Chiudi menu','Close menu')}>×</button></div><nav class="grouped-menu" aria-label={text(lang,'Tutte le pagine','All pages')}>{menuGroups.map(group=><section><h2>{text(lang,group.it,group.en)}</h2><div>{group.slugs.map(s=>{const p=mainPages.find(p=>p.slug===s)!;return <a href={pathFor(s,lang)} aria-current={slug===s?'page':undefined}>{lang==='it'?p.it:p.en}{['sigari','pipe-e-tabacchi-da-pipa','ricevitoria','accendini-e-accessori'].includes(s)&&<small>18+</small>}</a>})}</div></section>)}<a class="menu-journal" href="/approfondimenti/">{text(lang,'Il diario di Guerrazzi','Guerrazzi journal (Italian)')}</a></nav><a class="menu-address" href={shop.maps} target="_blank" rel="noopener">{shop.address}<br/>{shop.postcode} {shop.city}</a></dialog>
<main id="main"><slot/>{adultSection&&<div class="wrap"><LegalNotice kind={noticeKind} lang={lang}/></div>}</main>
{adultSection&&<AgeConfirmation lang={lang}/>}
<footer class="site-footer"><div class="footer-main wrap"><div class="footer-brand"><Logo large/><p>{text(lang,'Un luogo, molte piccole scoperte.','One place, many little discoveries.')}</p></div><div><h2>{text(lang,'Ci trovi qui','Find us here')}</h2><address>{shop.address}<br/>{shop.postcode} {shop.city}</address><a class="text-link" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Apri le indicazioni','Open directions')}</a>{shop.phone&&<a href={`tel:${shop.phone.replace(/\s/g,'')}`}>{shop.phone}</a>}<p class="footer-hours">{shop.hours.map(h=><span>{lang==='it'?h.day:h.dayEn}: {h.hours}<br/></span>)}</p></div><div><h2>{text(lang,'Esplora','Explore')}</h2>{['il-negozio','il-quartiere','servizi','catalogo','contatti'].map(s=>{const p=mainPages.find(p=>p.slug===s)!;return <a href={pathFor(s,lang)}>{lang==='it'?p.it:p.en}</a>})}<a href="/approfondimenti/">{text(lang,'Il diario','Journal (Italian)')}</a></div></div><div class="footer-image-note wrap"><p>{text(lang,'Alcune immagini sono ricostruzioni illustrative create con IA. I marchi identificano i prodotti trattati dal negozio; la loro presenza non implica, di per sé, sponsorizzazioni o collaborazioni con i rispettivi titolari.','Some images are illustrative reconstructions created with AI. Trademarks identify products carried by the shop; their presence does not in itself imply sponsorship or collaboration with their respective owners.')}</p></div><div class="footer-bottom wrap"><p>© {new Date().getFullYear()} {shop.legalName||shop.name}{shop.vat&&` · P. IVA ${shop.vat}`}</p><div><a href="/privacy/">Privacy</a><a href="/cookie/">Cookie</a><a href={shop.instagram} target="_blank" rel="noopener">Instagram</a><a href="https://www.dogostudio.it/" target="_blank" rel="noopener">Powered by DOGO Studio</a><a href="https://www.dogostudio.it/case-studies/guerrazzi" target="_blank" rel="noopener">{text(lang,'Il progetto Guerrazzi','The Guerrazzi project')}</a></div></div></footer>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#site-menu');const trigger=document.querySelector<HTMLButtonElement>('.menu-toggle');
 trigger?.addEventListener('click',()=>{dialog?.showModal();trigger.setAttribute('aria-expanded','true');document.documentElement.style.overflow='hidden'});
 const close=()=>dialog?.close();dialog?.querySelector('[data-close-menu]')?.addEventListener('click',close);
 dialog?.addEventListener('click',e=>{if(e.target===dialog)close()});dialog?.addEventListener('close',()=>{trigger?.setAttribute('aria-expanded','false');document.documentElement.style.overflow='';trigger?.focus()});
 const categories=document.querySelector<HTMLDetailsElement>('.category-menu');
 document.addEventListener('click',e=>{if(categories&&!categories.contains(e.target as Node))categories.open=false});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&categories?.open){categories.open=false;categories.querySelector('summary')?.focus()}});
 document.querySelectorAll<HTMLVideoElement>('video[data-hero]').forEach(v=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)v.pause()});
</script>
</body></html>
