---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import {shop, mainPages, pathFor, text} from '../data/shop';
const {title=shop.name,description='',lang='it',slug='',theme='',noindex=false,alternate=true,schema=null,image='/images/scelta.webp'}=Astro.props;
const configured=import.meta.env.PUBLIC_SITE_URL||'';
const ready=import.meta.env.PUBLIC_LAUNCH_READY==='true'&&!!configured;
const canonical=configured?new URL(Astro.url.pathname,configured).href:null;
const other=lang==='it'?'en':'it';
const nav=['il-negozio','servizi','idee-regalo','giochi-e-giocattoli','catalogo'];
const json=(o:any)=>JSON.stringify(o).replace(/</g,'\\u003c');
const entity={'@context':'https://schema.org','@type':'Store',name:shop.name,address:{'@type':'PostalAddress',streetAddress:shop.address,postalCode:shop.postcode,addressLocality:shop.city,addressCountry:'IT'},...(shop.phone?{telephone:shop.phone}:{}),...(configured?{url:configured}:{}),sameAs:[shop.instagram]};
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0645c0"/><title>{title.includes(shop.name)?title:`${title} | Guerrazzi`}</title><meta name="description" content={description}/><meta name="robots" content={noindex||!ready?'noindex,nofollow':'index,follow'}/>{canonical&&<link rel="canonical" href={canonical}/>}{configured&&alternate&&<><link rel="alternate" hreflang="it" href={new URL(pathFor(slug,'it'),configured).href}/><link rel="alternate" hreflang="en" href={new URL(pathFor(slug,'en'),configured).href}/><link rel="alternate" hreflang="x-default" href={new URL(pathFor(slug,'it'),configured).href}/></>}
<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/><link rel="preload" href="/fonts/bodoni-moda-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/manrope-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content={lang==='it'?'it_IT':'en_GB'}/>{canonical&&<meta property="og:url" content={canonical}/>}
{configured&&<><meta property="og:image" content={new URL(image,configured).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={new URL(image,configured).href}/></>}
<script type="application/ld+json" set:html={json([entity,...(canonical?[{'@context':'https://schema.org','@type':'WebPage',url:canonical,name:title,description,inLanguage:lang,about:entity},...(slug?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:new URL(pathFor('',lang),configured).href},{'@type':'ListItem',position:2,name:title,item:canonical}]}]:[])]:[]),...(schema?(Array.isArray(schema)?schema:[schema]):[])])}/>
</head><body class={theme?`theme-${theme}`:''}>
<a class="skip-link" href="#main">{text(lang,'Vai al contenuto','Skip to content')}</a>
<header class="site-header"><a class="home-logo" href={pathFor('',lang)} aria-label={shop.name}><Logo/></a><nav class="desktop-nav" aria-label={text(lang,'Navigazione principale','Main navigation')}>{nav.map(s=>{const p=mainPages.find(p=>p.slug===s)!;return <a href={pathFor(s,lang)} aria-current={slug===s?'page':undefined}>{lang==='it'?p.it:p.en}</a>})}</nav><div class="header-actions">{alternate&&<a class="language" href={pathFor(slug,other)} hreflang={other} lang={other} aria-label={lang==='it'?'Read in English':'Leggi in italiano'}>{other.toUpperCase()}</a>}<a class="header-visit" href={pathFor('contatti',lang)}>{text(lang,'Vieni a trovarci','Visit us')}</a><button class="menu-toggle" aria-expanded="false" aria-controls="site-menu"><span></span><span></span><span class="sr-only">{text(lang,'Apri menu','Open menu')}</span></button></div></header>
<dialog id="site-menu" class="site-menu"><div class="menu-top"><Logo/><button data-close-menu aria-label={text(lang,'Chiudi menu','Close menu')}>×</button></div><nav aria-label={text(lang,'Tutte le pagine','All pages')}>{mainPages.filter(p=>p.slug!=='').map(p=><a href={pathFor(p.slug,lang)} aria-current={slug===p.slug?'page':undefined}>{lang==='it'?p.it:p.en}</a>)}<a href="/approfondimenti/">{text(lang,'Il diario di Guerrazzi','Guerrazzi journal (Italian)')}</a></nav><a class="menu-address" href={shop.maps} target="_blank" rel="noopener">{shop.address}<br/>{shop.postcode} {shop.city}</a></dialog>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="footer-main wrap"><div class="footer-brand"><Logo large/><p>{text(lang,'Un luogo, molte piccole scoperte.','One place, many little discoveries.')}</p></div><div><h2>{text(lang,'Ci trovi qui','Find us here')}</h2><address>{shop.address}<br/>{shop.postcode} {shop.city}</address><a class="text-link" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Apri le indicazioni','Open directions')}</a>{shop.phone&&<a href={`tel:${shop.phone}`}>{shop.phone}</a>}</div><div><h2>{text(lang,'Esplora','Explore')}</h2>{['il-negozio','servizi','catalogo','contatti'].map(s=>{const p=mainPages.find(p=>p.slug===s)!;return <a href={pathFor(s,lang)}>{lang==='it'?p.it:p.en}</a>})}<a href="/approfondimenti/">{text(lang,'Il diario','Journal (Italian)')}</a></div></div><div class="footer-bottom wrap"><p>© {new Date().getFullYear()} {shop.name}{shop.vat&&` · P. IVA ${shop.vat}`}</p><div><a href="/privacy/">Privacy</a><a href="/cookie/">Cookie</a><a href={shop.instagram} target="_blank" rel="noopener">Instagram</a></div></div></footer>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#site-menu');const trigger=document.querySelector<HTMLButtonElement>('.menu-toggle');
 trigger?.addEventListener('click',()=>{dialog?.showModal();trigger.setAttribute('aria-expanded','true');document.documentElement.style.overflow='hidden'});
 const close=()=>dialog?.close();dialog?.querySelector('[data-close-menu]')?.addEventListener('click',close);
 dialog?.addEventListener('click',e=>{if(e.target===dialog)close()});dialog?.addEventListener('close',()=>{trigger?.setAttribute('aria-expanded','false');document.documentElement.style.overflow='';trigger?.focus()});
 document.querySelectorAll<HTMLVideoElement>('video[data-hero]').forEach(v=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)v.pause()});
</script>
</body></html>
