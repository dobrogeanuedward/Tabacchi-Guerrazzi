---
import Admin from '../../layouts/Admin.astro';import Logo from '../../components/Logo.astro';import {sessionValid} from '../../lib/auth.mjs';
if(sessionValid(Astro.cookies))return Astro.redirect('/admin/');
---
<Admin login title="Accesso al catalogo Guerrazzi"><div class="login-box"><Logo/><h1>Il tuo catalogo.</h1><p style="margin-bottom:25px">Accedi per inserire e aggiornare i prodotti del negozio.</p><div id="login-error" class="error-message" role="alert" hidden></div><form id="login-form"><label class="field">Nome utente<input name="username" autocomplete="username" required/></label><label class="field">Password<input name="password" type="password" autocomplete="current-password" required/></label><button class="button primary" type="submit">Accedi</button></form><a class="text-link" href="/" style="margin-top:30px">Torna al sito</a></div></Admin>
<script>document.querySelector<HTMLFormElement>('#login-form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const b=form.querySelector<HTMLButtonElement>('button')!;const error=document.querySelector<HTMLElement>('#login-error')!;b.disabled=true;error.hidden=true;try{const response=await fetch('/api/login',{method:'POST',body:new FormData(form)});const r=await response.json();if(!response.ok)throw new Error(r.error||'Accesso non riuscito.');location.assign('/admin/')}catch(e:any){error.textContent=e.message;error.hidden=false;}finally{b.disabled=false;}});</script>
