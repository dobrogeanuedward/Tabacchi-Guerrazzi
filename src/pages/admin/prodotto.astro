---
import Admin from '../../layouts/Admin.astro';import {sessionValid} from '../../lib/auth.mjs';import {getProduct} from '../../lib/store.mjs';import {categories} from '../../data/shop';
if(!sessionValid(Astro.cookies))return Astro.redirect('/admin/login/');
const id=Astro.url.searchParams.get('id');const p=id?getProduct(id):null;
if(id&&!p)return Astro.redirect('/admin/');
---
<Admin title="Scheda prodotto | Guerrazzi"><a class="text-link" href="/admin/" style="margin-bottom:25px">Torna ai prodotti</a><h1 class="admin-title">{p?'Modifica la scheda.':'Una nuova scelta.'}</h1><div id="editor-error" class="error-message" role="alert" hidden></div><form id="product-form"><input type="hidden" name="id" value={p?.id||''}/><input type="hidden" name="version" value={p?.version||''}/><input type="hidden" name="image" value={p?.image||''}/><input type="hidden" name="gallery" value={JSON.stringify(p?.gallery||[])}/><section class="admin-panel"><h2>Le informazioni.</h2><div class="admin-form-grid"><label class="field">Categoria<select name="category">{categories.map(c=><option value={c.id} selected={p?.category===c.id}>{c.it}</option>)}</select></label><label class="field">Marchio<input name="brand" value={p?.brand||''} maxlength="200"/></label><section><h2>Italiano</h2><label class="field">Nome del prodotto<input name="nameIt" value={p?.nameIt||''} required maxlength="200"/></label><label class="field" style="margin-top:20px">Descrizione<textarea name="descriptionIt" maxlength="6000">{p?.descriptionIt||''}</textarea></label></section><section><h2>English</h2><label class="field">Product name<input name="nameEn" value={p?.nameEn||''} maxlength="200"/></label><label class="field" style="margin-top:20px">Description<textarea name="descriptionEn" maxlength="6000">{p?.descriptionEn||''}</textarea></label></section></div></section><section class="admin-panel"><h2>Le fotografie.</h2><div class="admin-form-grid"><label class="field">Immagine principale<input id="upload-main" type="file" accept="image/jpeg,image/png,image/webp"/><small>JPG, PNG o WebP. Massimo 8 MB. Verrà ottimizzata automaticamente.</small></label><label class="field">Galleria<input id="upload-gallery" type="file" accept="image/jpeg,image/png,image/webp" multiple/><small>Fino a 5 immagini aggiuntive. Una nuova selezione sostituisce la galleria.</small></label></div><div id="photo-previews" class="upload-previews">{[p?.image,...(p?.gallery||[])].filter(Boolean).map(src=><img src={src} alt="Anteprima della foto caricata"/>)}</div><p id="upload-status" class="save-status" aria-live="polite"></p></section><section class="admin-panel"><h2>Disponibilità e pubblicazione.</h2><div class="admin-form-grid"><label class="field">Disponibilità<select name="availability"><option value="on-request" selected={!p||p.availability==='on-request'}>Da verificare</option><option value="available" selected={p?.availability==='available'}>Disponibile</option><option value="unavailable" selected={p?.availability==='unavailable'}>Non disponibile</option></select></label><label class="field">Prezzo, facoltativo<input name="price" type="number" min="0" max="100000" step="0.01" value={p?.price??''}/><small>Inserisci il prezzo soltanto quando vuoi mostrarlo sul sito.</small></label><label class="field">Stato<select name="status"><option value="draft" selected={!p||p.status==='draft'}>Bozza</option><option value="published" selected={p?.status==='published'}>Pubblicato</option><option value="archived" selected={p?.status==='archived'}>Archiviato</option></select><small>Per ritirare una scheda dal sito, torna in bozza oppure archiviala.</small></label></div></section><div class="editor-actions"><button class="button primary" type="submit">Salva la scheda</button><span id="save-status" class="save-status" aria-live="polite"></span>{p?.status==='published'&&<a class="button quiet" href={`/catalogo/${p.slug}/`} target="_blank" rel="noopener">Vedi la scheda sul sito</a>}</div></form></Admin>
<script>
 const form=document.querySelector<HTMLFormElement>('#product-form')!;let uploading=0;
 const error=document.querySelector<HTMLElement>('#editor-error')!;const uploadStatus=document.querySelector<HTMLElement>('#upload-status')!;
 const renderPhotos=()=>{const div=document.querySelector('#photo-previews')!;div.replaceChildren();const gallery=JSON.parse((form.elements.namedItem('gallery') as HTMLInputElement).value);const main=(form.elements.namedItem('image') as HTMLInputElement).value;[main,...gallery].filter(Boolean).forEach(src=>{const img=document.createElement('img');img.src=src;img.alt='Anteprima della foto caricata';div.append(img)});};
 async function upload(file:File){const fd=new FormData();fd.set('image',file);const response=await fetch('/api/upload',{method:'POST',body:fd});const r=await response.json();if(!response.ok)throw new Error(r.error||'Caricamento non riuscito.');return r.url;}
 for(const type of ['main','gallery'])document.querySelector<HTMLInputElement>(`#upload-${type}`)?.addEventListener('change',async e=>{const input=e.target as HTMLInputElement;const files=Array.from(input.files||[]);error.hidden=true;if(!files.length)return;if(type==='gallery'&&files.length>5){error.textContent='Seleziona al massimo 5 immagini per la galleria.';error.hidden=false;input.value='';return}uploading++;uploadStatus.textContent='Caricamento fotografie…';try{const urls=[];for(const f of files)urls.push(await upload(f));(form.elements.namedItem(type==='main'?'image':'gallery') as HTMLInputElement).value=type==='main'?urls[0]:JSON.stringify(urls);renderPhotos();uploadStatus.textContent='Fotografie caricate. Salva la scheda per confermare.';}catch(e:any){error.textContent=e.message;error.hidden=false;uploadStatus.textContent='';}finally{uploading--;input.value='';}});
 form.addEventListener('submit',async e=>{e.preventDefault();error.hidden=true;const saveStatus=document.querySelector<HTMLElement>('#save-status')!;if(uploading){saveStatus.textContent='Attendi il caricamento delle fotografie.';return;}const b=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;b.disabled=true;saveStatus.textContent='Salvataggio…';try{const values=Object.fromEntries(new FormData(form));const data:Record<string,unknown>={...values,gallery:JSON.parse(String(values.gallery))};if(!data.id)delete data.id;const response=await fetch('/api/products',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const r=await response.json();if(!response.ok)throw new Error(r.error||'Salvataggio non riuscito.');(form.elements.namedItem('id') as HTMLInputElement).value=r.product.id;(form.elements.namedItem('version') as HTMLInputElement).value=String(r.product.version);history.replaceState(null,'',`?id=${r.product.id}`);saveStatus.textContent=r.product.status==='published'?'Scheda pubblicata sul sito.':r.product.status==='archived'?'Scheda archiviata.':'Bozza salvata.';}catch(e:any){error.textContent=e.message;error.hidden=false;saveStatus.textContent='';}finally{b.disabled=false;}});
</script>
