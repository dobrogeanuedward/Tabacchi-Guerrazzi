---
import Product from '../../components/Product.astro';import {getProducts,getProductBySlug} from '../../lib/catalog.mjs';
export function getStaticPaths(){return getProducts({publicOnly:true}).map(p=>({params:{slug:p.slug}}));}
if(!getProductBySlug(Astro.params.slug))return new Response(null,{status:404});
---
<Product slug={Astro.params.slug} lang="it"/>
