---
import Base from '../../layouts/Base.astro';import {articles,clusters,articleCategoryLinks} from '../../data/articles';import {guides,pages} from '../../data/pages';
import {materialArticles} from '../../data/materials-education';
import {tobaccoArticles} from '../../data/tobacco-information';
import OfficialSources from '../../components/OfficialSources.astro';import {mainPages} from '../../data/shop';
export const prerender=true;
export function getStaticPaths(){return articles.map(a=>({params:{slug:a.slug},props:{a}}))}
const {a}=Astro.props;const c=clusters.find(c=>c.id===a.cluster)!;const domain=import.meta.env.PUBLIC_SITE_URL;
const research=materialArticles.some(b=>b.slug===a.slug);const information=tobaccoArticles.some(b=>b.slug===a.slug);
const schema={'@context':'https://schema.org','@type':'Article',headline:a.title,description:a.summary,inLanguage:'it',citation:(a.sources||[]).map(s=>s.url),author:{'@type':'Organization',name:'Tabaccheria Guerrazzi di Angela'},...(domain?{url:new URL(`/approfondimenti/${a.slug}/`,domain).href}:{})};
---
<Base image={information?`/images/materials/${c.theme==='radica'?'forest':'wood'}.webp`:undefined} title={a.title} description={a.summary} slug={`approfondimenti/${a.slug}`} alternate={false} theme={c.theme} schema={schema}>
<div class="breadcrumb wrap"><a href="/">Home</a><span>/</span><a href="/approfondimenti/">Il diario</a><span>/</span><a href={`/approfondimenti/#${c.id}`}>{c.label}</a></div>
<header class:list={["article-head",information&&"information-article-head"]}><p>{c.label}</p><h1>{a.title}</h1><p class="standfirst">{a.summary}</p></header><div class:list={["article-body",information&&"information-article-body"]}><nav class="article-toc" aria-label="In questo articolo">{information&&<h2>In questo articolo</h2>}{a.sections.map((s:any,i:number)=><a href={`#sezione-${i}`}>{s[0]}</a>)}</nav><article>{a.sections.map((s:any,i:number)=><section id={`sezione-${i}`}><h2>{s[0]}</h2><p>{s[1]}</p></section>)}<OfficialSources sources={a.sources||[]} lang="it" research={research} checked={research?"11 ottobre 2026":undefined}/><div class="article-related"><h2>Per continuare.</h2><a href={`/schede/${a.guide}/`}>{guides[a.guide].title[0]}</a><a href={`/${c.parent}/`}>Esplora {c.label.toLowerCase()}</a>{(articleCategoryLinks[a.slug]||[]).map(s=><a href={`/${s}/`}>{mainPages.find(p=>p.slug===s)?.it||pages[s].title[0]}</a>)}{articles.filter(b=>b.cluster===a.cluster&&b.slug!==a.slug).map(b=><a href={`/approfondimenti/${b.slug}/`}>{b.title}</a>)}</div></article></div>
</Base>

<style>
 .information-article-head>p:first-child{font:600 1rem var(--sans);color:var(--accent)}
 .information-article-head h1{font-size:clamp(2.8rem,4.6vw,4.6rem);max-width:20ch;color:var(--accent)}
 .information-article-head .standfirst{padding:24px 28px;border-left:3px solid var(--accent);background:#f3eee3;max-width:70ch;font-size:1.1rem;line-height:1.8}
 .information-article-body .article-toc{align-self:start;border:1px solid #d7d1c5;background:#f3eee3;padding:22px}
 .information-article-body .article-toc h2{font:600 1rem var(--sans);color:var(--accent);margin-bottom:20px}
 .information-article-body .article-toc a{color:var(--accent);line-height:1.7;min-height:44px;display:flex;align-items:center;border-top:1px solid #d7d1c5;padding-top:14px}
 .information-article-body article>section{border-top:1px solid #d7d1c5;padding-top:24px}
 .information-article-body article h2{font-size:clamp(2rem,3vw,2.7rem)}
 .information-article-body article p{line-height:1.9;max-width:68ch}
 .information-article-body .article-related a{color:var(--accent);padding:15px;border:1px solid #d7d1c5;background:#f3eee3;line-height:1.6;font-size:.95rem}
 @media(max-width:680px){.information-article-head .standfirst{padding:20px;font-size:1rem}.information-article-head h1{font-size:clamp(2.6rem,10vw,3.6rem)}.information-article-body .article-toc{padding:20px}}
</style>
