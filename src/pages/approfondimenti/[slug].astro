---
import NeighborhoodLinks from '../../components/NeighborhoodLinks.astro';
import Base from '../../layouts/Base.astro';import {articles,clusters,articleCategoryLinks,type Article} from '../../data/articles';import {guides,pages} from '../../data/pages';
import {materialArticles} from '../../data/materials-education';import {tobaccoArticles} from '../../data/tobacco-information';
import {visualForArticle} from '../../data/editorial-visuals';
import OfficialSources from '../../components/OfficialSources.astro';import {mainPages} from '../../data/shop';
import EditorialArt from '../../components/EditorialArt.astro';import ReadingIndex from '../../components/ReadingIndex.astro';
export const prerender=true;
export function getStaticPaths(){return articles.map(a=>({params:{slug:a.slug},props:{a}}))}
const {a}=Astro.props as {a:Article};const c=clusters.find(c=>c.id===a.cluster)!;const domain=import.meta.env.PUBLIC_SITE_URL;
const research=materialArticles.some(b=>b.slug===a.slug);const information=research||tobaccoArticles.some(b=>b.slug===a.slug);
const visual=visualForArticle(a.slug,a.cluster);
const schema={'@context':'https://schema.org','@type':'Article',headline:a.title,description:a.summary,inLanguage:'it',citation:(a.sources||[]).map(s=>s.url),author:{'@type':'Organization',name:'Tabaccheria Guerrazzi di Angela'},...(domain?{url:new URL('/approfondimenti/'+a.slug+'/',domain).href}:{})};
const readingMinutes=Math.max(1,Math.ceil([a.summary,...a.sections.flat()].join(' ').trim().split(/\s+/).length/190));
const categoryTitle=(slug:string)=>mainPages.find(p=>p.slug===slug)?.it||pages[slug].title[0];
const categoryLink=(slug:string)=>({href:'/'+slug+'/',kind:information?'Area informativa':'Categoria',title:categoryTitle(slug),action:information?'Apri l’area':'Esplora la categoria'});
const continuation=[
 {href:'/schede/'+a.guide+'/',kind:'Guida',title:guides[a.guide].title[0],action:'Apri la guida'},
 categoryLink(c.parent),
 ...(articleCategoryLinks[a.slug]||[]).map(categoryLink),
 ...articles.filter(b=>b.cluster===a.cluster&&b.slug!==a.slug).map(b=>({href:'/approfondimenti/'+b.slug+'/',kind:'Articolo',title:b.title,action:'Leggi l’articolo'}))
].filter((link,index,all)=>all.findIndex(item=>item.href===link.href)===index);
const indexEntries=a.sections.map((s,i)=>({href:'#sezione-'+i,title:s[0]}));
---
<Base image={visual.src} title={a.title} description={a.summary} slug={'approfondimenti/'+a.slug} alternate={false} theme={c.theme} schema={schema}>
<div class="editorial-document">
 <div class="breadcrumb wrap"><a href="/">Home</a><span>/</span><a href="/approfondimenti/">Il diario</a><span>/</span><a href={'/approfondimenti/#'+c.id}>{c.label}</a></div>
 <header class="editorial-cover wrap">
  <div class="editorial-cover-top"><p class="editorial-kind">{information?'Articolo informativo':'Articolo'}{information&&<span>18+</span>}</p><a href={'/approfondimenti/#'+c.id}>{c.label} </a></div>
  <h1>{a.title}</h1>
  <div class="editorial-deck"><div class="editorial-deck-copy"><p class="editorial-standfirst">{a.summary}</p><div class="editorial-meta"><span>{readingMinutes} min di lettura</span></div><a class="editorial-start" href="#sezione-0">Leggi l’articolo </a></div><div class="editorial-cover-art"><EditorialArt visual={visual} loading="eager" compact/></div></div>
 </header>
 <div class="editorial-reading wrap">
  <ReadingIndex entries={indexEntries} title="In questo articolo"/>
  <article class="editorial-content">
   {a.sections.map((s,i)=><section class="editorial-section" id={'sezione-'+i}><div class="editorial-section-heading"><h2>{s[0]}</h2></div>{s.slice(1).flatMap(p=>p.split("\n\n")).map(paragraph=><p>{paragraph}</p>)}</section>)}
   <OfficialSources sources={a.sources||[]} lang="it" research={research} checked={research?'11 ottobre 2026':undefined}/>
   {!information&&<NeighborhoodLinks topic={c.parent} lang="it"/>}
   <section class="editorial-continuation"><p class="editorial-section-label">Ti può interessare</p><h2>Continua a leggere.</h2><div class="continuation-grid">{continuation.map((link,i)=><a class:list={[i===0&&'continuation-primary']} href={link.href}><span class="continuation-kind">{link.kind}</span><h3>{link.title}</h3><span class="continuation-action">{link.action}</span></a>)}</div></section>
   <a class="editorial-return" href={'/approfondimenti/#'+c.id}> Torna a {c.label.toLowerCase()}</a>
  </article>
 </div>
</div>
</Base>
<style>
 .editorial-document{--editorial-line:color-mix(in srgb,var(--accent) 25%,#ded6c8);color:var(--ink)}
 .editorial-document .breadcrumb{display:flex;flex-wrap:wrap;gap:10px;font-size:.95rem;line-height:1.6}
 .editorial-cover{padding-block:25px 44px;border-bottom:1px solid var(--editorial-line)}
 .editorial-cover-top{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:22px;border-bottom:2px solid var(--accent);margin-bottom:30px}
 .editorial-kind{display:flex;flex-wrap:wrap;align-items:center;gap:14px;font:600 .95rem/1.6 var(--sans);color:var(--accent)}
 .editorial-kind>span{font-size:.95rem;line-height:1.4;padding:2px 9px;border:1px solid currentColor}
 .editorial-cover-top>a{display:inline-flex;align-items:center;gap:18px;min-height:44px;font-size:.95rem;color:var(--accent)}
 .editorial-cover h1{font:400 clamp(2.8rem,4.8vw,4.7rem)/1.05 var(--display);letter-spacing:-.04em;max-width:25ch;color:var(--accent);margin:0 0 30px}
 .editorial-deck{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:65px;align-items:center}
 .editorial-deck-copy{min-width:0;padding-block:15px}
 .editorial-standfirst{padding:0 0 0 22px;border-left:2px solid var(--accent);font:400 1.18rem/1.85 var(--sans);max-width:45ch}
 .editorial-meta{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:26px;font-size:.95rem;line-height:1.6;color:#686157}
 .editorial-meta>span+span{padding-left:24px;border-left:1px solid var(--editorial-line)}
 .editorial-start{display:inline-flex;align-items:center;gap:35px;min-height:44px;margin-top:23px;border-bottom:1px solid var(--accent);font:600 .95rem/1.6 var(--sans);color:var(--accent)}
 .editorial-start>span{font-size:1.25rem}.editorial-cover-art{min-width:0;max-width:680px;justify-self:end;width:100%}
 .editorial-reading{display:grid;grid-template-columns:240px minmax(0,1fr);align-items:start;gap:72px;padding-block:54px 75px}
 .editorial-content{min-width:0}
 .editorial-section{padding:32px 0 36px;border-top:1px solid var(--editorial-line);scroll-margin-top:30px}
 .editorial-section:first-child{border-top:3px solid var(--accent)}
 .editorial-section-heading{display:block;margin-bottom:22px}
 .editorial-number{font:400 3.15rem/.95 var(--display);letter-spacing:-.045em;color:var(--accent);padding-top:2px}
 .editorial-section h2,.editorial-continuation>h2{font:400 clamp(1.95rem,2.8vw,2.8rem)/1.14 var(--display);letter-spacing:-.025em;color:var(--accent);margin:0}
 .editorial-section>p{font-size:1.05rem;line-height:1.95;max-width:67ch;margin:0 0 18px}
 .editorial-section:first-child>p{font-size:1.1rem}
 .editorial-continuation{padding-top:30px;margin-top:35px;border-top:2px solid var(--accent)}
 .editorial-section-label{font:600 .95rem/1.6 var(--sans);color:var(--accent);margin-bottom:13px}
 .continuation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin-top:27px}
 .continuation-grid>a{display:flex;flex-direction:column;min-width:0;gap:15px;padding:25px 0;border-top:1px solid var(--editorial-line);color:var(--accent)}
 .continuation-grid>a.continuation-primary{grid-column:1/-1;display:grid;grid-template-columns:100px minmax(0,1fr);gap:14px 22px;padding:26px;margin-bottom:16px;border-top:0;background:var(--surface)}
 .continuation-primary .continuation-kind{grid-column:1;grid-row:1/3;align-self:start}
 .continuation-primary h3,.continuation-primary .continuation-action{grid-column:2}
 .continuation-kind{font-size:.95rem;line-height:1.6;color:#686157}
 .continuation-grid h3{font:400 1.6rem/1.23 var(--display);letter-spacing:-.02em;margin:0}
 .continuation-action{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:auto;font:600 .95rem/1.6 var(--sans)}
 .continuation-action>span{font-size:1.15rem}
 .continuation-grid>a:hover .continuation-action{text-decoration:underline;text-underline-offset:4px}
 .editorial-return{display:inline-flex;align-items:center;gap:14px;min-height:44px;margin-top:24px;font-size:.95rem;color:var(--accent);text-decoration:underline;text-underline-offset:4px}
 @media(max-width:1100px){.editorial-deck{gap:35px}.editorial-reading{grid-template-columns:210px minmax(0,1fr);gap:35px}.editorial-section-heading{display:block}.editorial-section>p{margin-left:0}.editorial-number{font-size:2.7rem}}
 @media(max-width:820px){.editorial-cover h1{font-size:clamp(2.6rem,7.5vw,3.8rem)}.editorial-deck{grid-template-columns:1fr;gap:28px}.editorial-deck-copy{padding:0}.editorial-standfirst{max-width:65ch;font-size:1.1rem}.editorial-cover-art{max-width:620px}.editorial-reading{grid-template-columns:1fr;gap:34px;padding-block:35px 55px}}
 @media(max-width:520px){.editorial-cover{padding-top:12px;padding-bottom:32px}.editorial-cover-top{align-items:flex-start;flex-direction:column;gap:9px;padding-bottom:17px;margin-bottom:25px}.editorial-cover-top>a{min-height:35px}.editorial-cover h1{font-size:2.55rem}.editorial-standfirst{font-size:1rem;padding-left:16px}.editorial-meta{gap:8px 16px}.editorial-meta>span+span{padding-left:16px}.editorial-section{padding-block:26px}.editorial-section-heading{display:block;margin-bottom:18px}.editorial-number{font-size:2.15rem}.editorial-section h2{font-size:1.95rem}.editorial-section>p,.editorial-section:first-child>p{font-size:1rem;margin-left:0;line-height:1.9}.continuation-grid{grid-template-columns:1fr;gap:0}.continuation-grid>a.continuation-primary{display:flex;padding:23px}.continuation-primary .continuation-kind{align-self:auto}}
 @media(max-width:370px){.editorial-meta{display:grid;gap:5px}.editorial-meta>span+span{padding:0;border:0}.editorial-cover h1{font-size:2.4rem}}
</style>
