---
import Base from '../../layouts/Base.astro';
import {articles,clusters} from '../../data/articles';
import {tobaccoArticles} from '../../data/tobacco-information';
import {materialArticles} from '../../data/materials-education';
import {clusterIntroductions,clusterVisuals} from '../../data/editorial-visuals';
import EditorialArt from '../../components/EditorialArt.astro';
export const prerender=true;
const adultArticleSlugs=new Set([...tobaccoArticles,...materialArticles].map(a=>a.slug));
---
<Base title="Il diario di Guerrazzi" description="Idee regalo, giochi, servizi pratici, il negozio e informazioni sul tabacco: approfondimenti documentati da Guerrazzi a Bologna." slug="approfondimenti" alternate={false} theme="utility" image="/images/studies/archive-folio.webp">
<div class="wrap journal-shell">
 <header class="journal-cover">
  <div class="journal-cover-copy">
   <p class="journal-kicker">Quaderni Guerrazzi</p>
   <h1>Il diario</h1>
   <p class="journal-intro">Storie e approfondimenti sul negozio, i servizi e i materiali. Scegli un argomento, poi apri l’articolo che ti interessa.</p>
   <p class="journal-count"><span>{clusters.length} argomenti</span><span>{articles.length} articoli</span></p>
   <a class="journal-start" href="#argomenti">Sfoglia gli argomenti <span aria-hidden="true">↓</span></a>
  </div>
  <EditorialArt visual={clusterVisuals['lessico-e-fonti']} lang="it" loading="eager" compact />
 </header>
 <nav class="journal-index" id="argomenti" aria-label="Argomenti del diario">
  <div class="journal-index-heading"><h2>Da dove vuoi partire?</h2><p>Un indice per trovare il tuo argomento.</p></div>
  <ol>{clusters.map((c,i)=>{
   const count=articles.filter(a=>a.cluster===c.id).length;
   return <li><a href={'#'+c.id}><span class="journal-index-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{c.label}<small>{count} {count===1?'articolo':'articoli'}</small></span><span aria-hidden="true">↓</span></a></li>
  })}</ol>
 </nav>
 {clusters.map((c,i)=>{
  const entries=articles.filter(a=>a.cluster===c.id);
  const [featured,...others]=entries;
  return featured&&<section class:list={['journal-topic','theme-'+c.theme]} id={c.id} aria-labelledby={'cluster-'+c.id}>
   <header class="journal-topic-heading">
    <div><p class="journal-topic-label">Argomento {String(i+1).padStart(2,'0')}</p><h2 id={'cluster-'+c.id}>{c.label}</h2></div>
    <p>{clusterIntroductions[c.id]}</p>
   </header>
   <div class:list={['journal-topic-content',{'journal-topic-single':others.length===0}]}>
    <div class="journal-feature">
     <EditorialArt visual={clusterVisuals[c.id]} lang="it" compact />
     <a class="journal-feature-link" href={'/approfondimenti/'+featured.slug+'/'}>
      <p class="journal-entry-label">Articolo{adultArticleSlugs.has(featured.slug)&&<span>Informazione per adulti · 18+</span>}</p>
      <h3>{featured.title}</h3>
      <p class="journal-entry-summary">{featured.summary}</p>
      <span class="journal-entry-action">Leggi l’articolo <span aria-hidden="true">↗</span></span>
     </a>
    </div>
    {others.length>0&&<div class="journal-related"><p class="journal-related-heading">Altri articoli su questo argomento</p>{others.map(a=><a class="journal-entry" href={'/approfondimenti/'+a.slug+'/'}>
     <p class="journal-entry-label">Articolo{adultArticleSlugs.has(a.slug)&&<span>Informazione per adulti · 18+</span>}</p>
     <h3>{a.title}</h3>
     <p class="journal-entry-summary">{a.summary}</p>
     <span class="journal-entry-action">Leggi l’articolo <span aria-hidden="true">↗</span></span>
    </a>)}</div>}
   </div>
  </section>
 })}
 <footer class="journal-footer"><p>Hai un’esigenza pratica?</p><a href="/servizi/">Consulta i servizi <span aria-hidden="true">→</span></a></footer>
</div>
</Base>
<style>
 .journal-shell{padding-bottom:70px}
 .journal-cover{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:70px;padding-block:55px 72px}
 .journal-kicker,.journal-topic-label,.journal-entry-label,.journal-related-heading{font:600 .95rem/1.6 var(--sans)}
 .journal-kicker{color:var(--blue);margin:0 0 22px}
 .journal-cover h1{font-size:clamp(3.4rem,6vw,6rem);line-height:1.05;color:var(--blue);margin:0 0 30px}
 .journal-intro{font-size:1.1rem;line-height:1.85;max-width:49ch}
 .journal-count{display:flex;flex-wrap:wrap;gap:15px 28px;margin:26px 0 20px;padding-top:20px;border-top:1px solid var(--line);font-size:.95rem;line-height:1.6;color:#445267}
 .journal-start{display:inline-flex;align-items:center;gap:35px;min-height:44px;font-size:.95rem;font-weight:600;color:var(--blue)}
 .journal-index{scroll-margin-top:28px;margin-bottom:90px;padding-block:26px 0;border-top:2px solid var(--blue)}
 .journal-index-heading{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:24px}
 .journal-index-heading h2{font-size:clamp(1.8rem,2.7vw,2.4rem);color:var(--blue);line-height:1.2;margin:0}
 .journal-index-heading>p{font-size:.95rem;line-height:1.7;color:#445267;margin:0}
 .journal-index ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 30px;list-style:none;padding:0;margin:0}
 .journal-index li{border-bottom:1px solid var(--line);min-width:0}
 .journal-index a{display:flex;align-items:center;gap:16px;min-height:93px;padding:16px 0;font-size:1rem;line-height:1.55;color:var(--blue)}
 .journal-index a>span:last-child{margin-left:auto}
 .journal-index-number{font:400 1.6rem/1 var(--display);color:#53637b;align-self:flex-start;padding-top:7px}
 .journal-index small{display:block;font-size:.95rem;line-height:1.6;color:#536176;margin-top:3px}
 .journal-topic{padding-block:32px 75px;border-top:1px solid color-mix(in srgb,var(--accent) 32%,#e8e0d2);scroll-margin-top:28px}
 .journal-topic-heading{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:60px;margin-bottom:34px}
 .journal-topic-label{margin:0 0 10px;color:var(--accent)}
 .journal-topic-heading h2{font-size:clamp(2.2rem,3.6vw,3.4rem);line-height:1.13;color:var(--accent);max-width:22ch;margin:0}
 .journal-topic-heading>p{font-size:1rem;line-height:1.8;max-width:55ch;color:#475267;margin:0 0 3px}
 .journal-topic-content{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
 .journal-feature{min-width:0}
 .journal-feature-link{display:flex;flex-direction:column;gap:17px;padding:25px 25px 20px;margin-top:24px;border:1px solid color-mix(in srgb,var(--accent) 25%,#e8e0d2);border-top:3px solid var(--accent);background:color-mix(in srgb,var(--surface) 38%,#fffdf8)}
 .journal-entry-label{display:flex;flex-wrap:wrap;align-items:center;gap:6px 20px;color:var(--accent);margin:0}
 .journal-entry-label>span{font-size:.95rem;font-weight:400;color:#525e6e}
 .journal-feature-link h3{font-size:clamp(1.8rem,2.7vw,2.65rem);line-height:1.2;color:var(--accent);margin:0;max-width:28ch}
 .journal-entry-summary{font-size:1rem;line-height:1.85;color:#475267;margin:0}
 .journal-entry-action{display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:44px;border-top:1px solid color-mix(in srgb,var(--accent) 22%,#e8e0d2);padding-top:15px;margin-top:8px;font-size:.95rem;font-weight:600;line-height:1.6;color:var(--accent)}
 .journal-entry-action>span{font-size:1.2rem}
 .journal-related{min-width:0;padding-top:2px}
 .journal-related-heading{color:var(--accent);padding-bottom:17px;border-bottom:2px solid var(--accent);margin:0}
 .journal-entry{display:flex;flex-direction:column;gap:17px;padding:27px 0 24px;border-bottom:1px solid color-mix(in srgb,var(--accent) 25%,#e8e0d2)}
 .journal-entry h3{font-size:clamp(1.65rem,2.2vw,2.15rem);line-height:1.25;color:var(--accent);margin:0;max-width:28ch}
 .journal-entry .journal-entry-action{border-top:0;padding-top:0}
 .journal-topic-single{grid-template-columns:1fr}
 .journal-topic-single .journal-feature{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px}
 .journal-topic-single .journal-feature-link{margin:0}
 .journal-footer{display:flex;align-items:baseline;justify-content:space-between;gap:24px;border-top:2px solid var(--blue);padding-top:25px}
 .journal-footer p{font-size:1rem;line-height:1.7;color:#475267;margin:0}
 .journal-footer a{display:flex;align-items:center;justify-content:space-between;gap:45px;min-height:44px;font-size:1rem;font-weight:600;color:var(--blue)}
 .journal-feature-link:hover,.journal-feature-link:focus-visible{background:var(--surface)}
 .journal-entry:hover .journal-entry-action,.journal-feature-link:hover .journal-entry-action,.journal-index a:hover,.journal-start:hover,.journal-footer a:hover{text-decoration:underline;text-underline-offset:.2em}
 .journal-feature-link:focus-visible,.journal-entry:focus-visible,.journal-index a:focus-visible,.journal-start:focus-visible,.journal-footer a:focus-visible{outline:3px solid var(--blue);outline-offset:5px}
 @media(max-width:1100px){.journal-cover{gap:38px}.journal-index ol{grid-template-columns:repeat(2,minmax(0,1fr))}.journal-topic-content,.journal-topic-heading,.journal-topic-single .journal-feature{gap:38px}}
 @media(max-width:820px){.journal-shell{padding-bottom:42px}.journal-cover{grid-template-columns:1fr;gap:35px;padding-block:30px 52px}.journal-cover h1{font-size:clamp(3.4rem,10vw,4.8rem)}.journal-intro{max-width:65ch}.journal-index{margin-bottom:55px}.journal-index-heading{display:block}.journal-index-heading>p{margin-top:12px}.journal-topic{padding-bottom:52px}.journal-topic-heading{grid-template-columns:1fr;gap:18px;margin-bottom:28px}.journal-topic-heading>p{max-width:65ch}.journal-topic-content,.journal-topic-single .journal-feature{grid-template-columns:1fr;gap:34px}.journal-topic-single .journal-feature-link{margin:0}.journal-feature-link h3{font-size:2.25rem;max-width:30ch}.journal-entry h3{font-size:2rem;max-width:32ch}.journal-related-heading{padding-top:7px}.journal-footer{align-items:flex-start;flex-direction:column;gap:12px}}
 @media(max-width:520px){.journal-cover h1{font-size:3.5rem}.journal-intro{font-size:1rem}.journal-index ol{grid-template-columns:1fr}.journal-index a{min-height:82px}.journal-index-heading h2{font-size:2rem}.journal-topic-heading h2{font-size:2.5rem}.journal-feature-link{padding:22px 19px 18px}.journal-feature-link h3{font-size:2rem}.journal-entry h3{font-size:1.85rem}.journal-entry-summary{font-size:.98rem}.journal-topic-single .journal-feature{gap:24px}}
 @media(max-width:370px){.journal-cover h1{font-size:3.1rem}.journal-topic-heading h2{font-size:2.2rem}.journal-feature-link h3{font-size:1.8rem}.journal-feature-link{padding-inline:16px}.journal-entry-label{gap:4px 14px}}
</style>
