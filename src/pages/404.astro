---
import Base from '../layouts/Base.astro';
export const prerender=true;
---
<Base title="Pagina non trovata" noindex alternate={false}><section class="recovery-page wrap"><div><p class="section-label">Pagina non trovata / 404</p><h1>Questa pagina non c’è.</h1><p>Puoi ripartire dal negozio oppure cercare una categoria nel catalogo.</p><div class="hero-buttons"><a class="button primary" href="/">Torna alla Home</a><a class="button quiet" href="/catalogo/">Apri il catalogo</a></div><a class="text-link" href="/contatti/">Cerchi il negozio? Via Guerrazzi 10/F <span aria-hidden="true">→</span></a></div><figure><span aria-hidden="true">404</span><img src="/brand/ui/portico-ink.webp" width="960" height="480" alt="" aria-hidden="true"/></figure></section></Base>
<style>.recovery-page{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:55px;align-items:center;padding-block:55px 80px}.recovery-page .section-label{font-size:1rem;margin-bottom:20px}.recovery-page h1{font:400 clamp(2.8rem,4.3vw,4.6rem)/1.1 var(--display);letter-spacing:-.04em;color:var(--blue);max-width:15ch;margin-bottom:25px}.recovery-page p{font:1rem/1.85 var(--sans);max-width:52ch}.recovery-page .hero-buttons{margin-top:28px}.recovery-page .button{font-size:.95rem}.recovery-page .text-link{margin-top:25px;font-size:.95rem}.recovery-page figure{margin:0;padding:35px;background:linear-gradient(#faf3e5d9,#faf3e5d9),url('/images/materials/paper-768.webp') center/cover;border:1px solid #cfccbf}.recovery-page figure>span{display:block;text-align:center;font:400 clamp(5rem,9vw,9rem)/1 var(--display);letter-spacing:-.06em;color:#0645c0}.recovery-page figure>img{width:100%;height:auto;mix-blend-mode:multiply;margin-top:25px}@media(max-width:680px){.recovery-page{grid-template-columns:minmax(0,1fr);gap:30px;padding-block:35px 55px}.recovery-page h1{font-size:3rem}.recovery-page figure{padding:25px}}</style>
