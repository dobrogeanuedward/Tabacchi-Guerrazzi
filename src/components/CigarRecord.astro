---
import Base from '../layouts/Base.astro';import BrandSignature from './BrandSignature.astro';import OfficialSources from './OfficialSources.astro';import {cigarRecords,type CigarRecord as RecordType} from '../data/cigar-records';import {tobaccoSources} from '../data/tobacco-information';import {shop,pathFor,text,type Lang} from '../data/shop';
const {record,lang='it'}=Astro.props as {record:RecordType;lang:Lang};const l=lang==='it'?0:1;const neighbours=cigarRecords.filter(r=>r.group===record.group&&r.slug!==record.slug).slice(0,4);
const faqs=[[text(lang,'Questa scheda conferma la disponibilità?','Does this record confirm availability?'),text(lang,'No. Documenta una denominazione osservata nelle foto del negozio; non rappresenta una giacenza aggiornata.','No. It documents a name observed in shop photographs, not current inventory.')],[text(lang,`Quali dati sono verificati per ${record.name}?`,`Which details are recorded for ${record.name}?`),record.detail[l]],[text(lang,'Posso ordinare dal sito?','Can I order through the website?'),text(lang,'Il sito non accetta ordini, prenotazioni di articoli o spedizioni di tabacco. Questa è una scheda informativa per adulti.','The website does not accept tobacco orders, item reservations or shipping requests. This is an informational record for adults.')]];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Base lang={lang} slug={`sigari/${record.slug}`} title={`${record.name} — ${text(lang,'scheda informativa','information record')}`} description={text(lang,`${record.name}: denominazione registrata nella ricognizione di Guerrazzi, Via Guerrazzi 10/F, Bologna. Dati osservati, limiti e riferimenti per adulti.`,`${record.name}: name recorded in the Guerrazzi survey, Via Guerrazzi 10/F, Bologna. Observations, limitations and references for adults.`)} schema={schema} image="/brand/ui/archive-reference.webp">
<div class="breadcrumb wrap"><a href={pathFor('',lang)}>Home</a><span>/</span><a href={pathFor('sigari',lang)}>{text(lang,'Informazioni sui sigari','Cigar information')}</a></div>
<section class="record-hero wrap"><p class="category-name eyebrow">{text(lang,'Denominazione documentata · 18+','Documented name · 18+')}</p><h1>{record.name}</h1><p>{record.detail[l]}</p><BrandSignature lang={lang}/></section>
<div class="record-content wrap"><section class="record-facts"><h2>{text(lang,'La traccia nel negozio.','The shop record.')}</h2><dl><div><dt>{text(lang,'Luogo della ricognizione','Survey location')}</dt><dd>{shop.address}, {shop.city}</dd></div><div><dt>{text(lang,'Riferimento fotografico','Photograph reference')}</dt><dd>IMG_{record.photo.split(';').join(', IMG_')}</dd></div><div><dt>{text(lang,'Voce del registro','Survey entry')}</dt><dd>{record.reference}</dd></div><div><dt>{text(lang,'Da completare','Still to establish')}</dt><dd>{text(lang,'Confezione esatta, formato e riscontro attuale.','Exact pack, size and current verification.')}</dd></div></dl></section><aside class="record-reading"><h2>{text(lang,'Leggere il nome, senza deduzioni.','Read the name without assumptions.')}</h2><p>{text(lang,'Il nome non è una descrizione della composizione e non dimostra proprietà sanitarie. Confezioni, avvertenze e informazioni del singolo articolo vanno considerate per intero.','The name does not describe composition or establish health properties. The complete individual pack, warnings and information need to be considered.')}</p><a class="text-link" href={pathFor('schede/tabacco-confezioni-avvertenze',lang)}>{text(lang,'Confezioni e avvertenze','Packs and warnings')}</a><a class="text-link" href={pathFor('schede/tabacco-minori-documenti',lang)}>{text(lang,'Maggiore età e documento','Adulthood and identification')}</a></aside></div>
<section class="faq wrap record-faq"><h2>{text(lang,'Domande sulla scheda.','Questions about this record.')}</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section class="wrap record-related"><h2>{text(lang,'Altre voci dello stesso gruppo.','Other records in this group.')}</h2><div>{neighbours.map(r=><a href={pathFor(`sigari/${r.slug}`,lang)}>{r.name}<span aria-hidden="true">↗</span></a>)}</div><a class="text-link" href={pathFor('sigari',lang)}>{text(lang,'Torna all’archivio delle denominazioni','Back to the name records')}</a><OfficialSources sources={tobaccoSources} lang={lang}/></section>
</Base>
<style>.record-hero{padding:2rem 0 3rem;max-width:1100px}.record-hero h1{font-size:clamp(3rem,6vw,5.8rem);color:var(--blue);margin:1rem 0 1.5rem}.record-hero>p:last-of-type{max-width:70ch;line-height:1.8}.record-content{display:grid;grid-template-columns:1.1fr 1fr;gap:3rem}.record-content h2,.record-related h2{font-size:2.5rem;color:var(--blue);margin-bottom:1.3rem}.record-facts dl>div{padding:1rem 0;border-top:1px solid var(--line)}.record-facts dt{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem}.record-facts dd{margin:0;line-height:1.7}.record-reading{background:#edf2fc;padding:2rem;align-self:start;border-radius:0 45px 0 0}.record-reading p{margin-bottom:1.5rem}.record-reading a{display:block;margin-top:1rem}.record-related{padding-bottom:4rem}.record-related>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-bottom:2rem}.record-related>div a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line);color:var(--blue)}@media(max-width:680px){.record-content{grid-template-columns:1fr;gap:2rem}.record-hero{padding:1rem 0 2rem}.record-reading{padding:1.5rem}.record-related>div{grid-template-columns:1fr}.record-faq{padding-block:3rem}}</style>
