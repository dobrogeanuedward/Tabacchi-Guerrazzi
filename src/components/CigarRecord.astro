---
import Base from '../layouts/Base.astro';import BrandSignature from './BrandSignature.astro';import OfficialSources from './OfficialSources.astro';import CigarPhoto from './CigarPhoto.astro';import {cigarRecords,type CigarRecord as RecordType} from '../data/cigar-records';import {tobaccoSources} from '../data/tobacco-information';import {pathFor,text,type Lang} from '../data/shop';
import {cigarPhotoForGroup} from '../data/cigar-photography';
import {referenceCigarPhotoForName} from '../data/cigar-reference-photos';
const {record,lang='it'}=Astro.props as {record:RecordType;lang:Lang};const l=lang==='it'?0:1;const neighbours=cigarRecords.filter(r=>r.group===record.group&&r.slug!==record.slug).slice(0,4);
const faqs=[[text(lang,'Questa scheda conferma la disponibilità?','Does this record confirm availability?'),text(lang,'No. La disponibilità può cambiare e questa pagina non è un inventario aggiornato.','No. Availability can change and this page is not a live inventory.')],[text(lang,`Quali dati sono verificati per ${record.name}?`,`Which details are recorded for ${record.name}?`),record.detail[l]],[text(lang,'Posso ordinare dal sito?','Can I order through the website?'),text(lang,'Il sito non accetta ordini, prenotazioni di articoli o spedizioni di tabacco. Questa è una scheda informativa per adulti.','The website does not accept tobacco orders, item reservations or shipping requests. This is an informational record for adults.')]];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const index=String(cigarRecords.findIndex(r=>r.slug===record.slug)+1).padStart(2,'0');
const photoPath=referenceCigarPhotoForName(record.name)?.path||cigarPhotoForGroup(record.group).path;
---
<Base lang={lang} theme="cedro" slug={`sigari/${record.slug}`} title={`${record.name} — ${text(lang,'scheda informativa','information record')}`} description={text(lang,`${record.name}: scheda informativa di Guerrazzi, Via Guerrazzi 10/F, Bologna. Denominazione, confezioni e avvertenze per adulti.`,`${record.name}: information from Guerrazzi, Via Guerrazzi 10/F, Bologna. Names, packs and warnings for adults.`)} schema={schema} image={photoPath}>
<div class="breadcrumb wrap"><a href={pathFor('',lang)}>Home</a><span>/</span><a href={pathFor('sigari',lang)}>{text(lang,'Informazioni sui sigari','Cigar information')}</a></div>
<section class="record-opening">
 <div class="record-hero wrap">
  <div class="record-copy">
   <div class="record-series"><span>{text(lang,'Archivio delle denominazioni','Name archive')}</span><span class="record-age">18+</span></div>
   <p class="record-reference">{text(lang,'Scheda informativa','Information record')} <span> / {index}</span></p>
   <h1>{record.name}</h1><p class="record-description">{record.detail[l]}</p>
   <a class="record-index-link" href={pathFor('sigari',lang)}>{text(lang,'Consulta l’indice dell’archivio','Browse the archive index')} </a>
  </div>
  <div class="record-plate"><CigarPhoto name={record.name} group={record.group} lang={lang} loading="eager"/></div>
 </div>
 <div class="record-colophon wrap"><span>{text(lang,'Denominazione e contesto','Name and context')}</span><span>{text(lang,'Confezioni · avvertenze · fonti','Packaging · warnings · sources')}</span></div>
</section>
<div class="record-content wrap"><section class="record-facts"><p class="record-section-label">01 / {text(lang,'La scheda','The record')}</p><h2>{text(lang,'Informazioni sulla denominazione','About this name')}</h2><p>{text(lang,'Formato, confezione e informazioni del produttore vanno letti sull’etichetta completa. Questa pagina non conferma la disponibilità e non consente ordini.','Read the complete label for size, pack and manufacturer information. This page does not confirm availability or accept orders.')}</p><BrandSignature lang={lang}/></section><aside class="record-reading"><p class="record-section-label">02 / {text(lang,'Come leggere','How to read')}</p><h2>{text(lang,'Leggere il nome, senza deduzioni.','Read the name without assumptions.')}</h2><p>{text(lang,'Il nome non è una descrizione della composizione e non dimostra proprietà sanitarie. Confezioni, avvertenze e informazioni del singolo articolo vanno considerate per intero.','The name does not describe composition or establish health properties. The complete individual pack, warnings and information need to be considered.')}</p><a class="text-link" href={pathFor('schede/tabacco-confezioni-avvertenze',lang)}>{text(lang,'Confezioni e avvertenze','Packs and warnings')}</a><a class="text-link" href={pathFor('schede/tabacco-minori-documenti',lang)}>{text(lang,'Maggiore età e documento','Adulthood and identification')}</a></aside></div>
<section class="faq wrap record-faq"><h2>{text(lang,'Domande sulla scheda.','Questions about this record.')}</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section class="wrap record-related"><h2>{text(lang,'Altre voci dello stesso gruppo.','Other records in this group.')}</h2><div>{neighbours.map(r=><a href={pathFor(`sigari/${r.slug}`,lang)}>{r.name}</a>)}</div><a class="text-link" href={pathFor('sigari',lang)}>{text(lang,'Torna all’archivio delle denominazioni','Back to the name records')}</a><OfficialSources sources={tobaccoSources} lang={lang}/></section>
</Base>
<style>
.record-opening{color:#493928;background:#f5efe3;background-image:linear-gradient(#f5efe3d9,#f5efe3d9),url('/images/materials/paper-768.webp');background-size:auto,1000px;border-block:1px solid #cdbda8;position:relative}
.record-opening:before{content:'';position:absolute;inset:0 auto 0 0;width:14px;background:#765037 url('/images/materials/wood-768.webp') center/cover}
.record-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:clamp(32px,5vw,80px);align-items:center;padding-block:52px 38px}
.record-copy{min-width:0}.record-series{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:20px;border-bottom:1px solid #9b826854;font:600 1rem/1.5 var(--sans)}
.record-age{border:1px solid #8c7459;border-radius:100px;padding:3px 10px;font-size:.95rem;white-space:nowrap}
.record-reference{margin-top:24px;font-size:1rem}.record-reference span{font:400 1.5rem var(--display);color:#754d29}
.record-hero h1{font-size:clamp(2.8rem,4.8vw,4.7rem);line-height:1.05;color:#5b402b;margin:22px 0 25px;overflow-wrap:anywhere;text-wrap:balance}
.record-description{max-width:58ch;line-height:1.8}.record-index-link{display:flex;justify-content:space-between;align-items:center;gap:20px;max-width:390px;padding:18px 0 8px;margin-top:20px;border-bottom:1px solid #754d29;font-weight:600;font-size:.95rem;color:#5b402b}
.record-plate{min-width:0}
.record-colophon{display:flex;justify-content:space-between;gap:20px;border-top:1px solid #9b826854;padding-block:18px;font-size:.95rem}
.record-content{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(30px,6vw,90px);padding-top:64px}
.record-content h2,.record-related h2{font-size:clamp(2rem,3vw,2.8rem);color:#5b402b;margin-bottom:22px}
.record-section-label{font:600 .95rem/1.5 var(--sans);color:#68513a;margin-bottom:20px}
.record-facts>p:not(.record-section-label){max-width:58ch}.record-reading{padding:32px;background:linear-gradient(#f6f0e5ed,#f6f0e5ed),url('/images/materials/wood-768.webp') center/cover;border-top:3px solid #977452;align-self:start}
.record-reading>p:not(.record-section-label){margin-bottom:22px}.record-reading a{display:block;width:fit-content;margin-top:16px;color:#5b402b;border-color:#977452}
.record-faq{padding-block:64px}.record-faq h2{color:#5b402b;font-size:clamp(2rem,3vw,2.8rem)}
.record-related{padding-bottom:64px}.record-related>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px;margin-bottom:28px}
.record-related>div a{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px 0;border-bottom:1px solid #cab9a1;color:#5b402b;min-width:0}
@media(max-width:960px){.record-hero{gap:32px}.record-hero h1{font-size:clamp(2.8rem,5vw,4rem)}}
@media(max-width:680px){.record-opening:before{width:5px}.record-hero{grid-template-columns:1fr;padding-block:28px 30px;gap:30px}.record-series{font-size:.95rem}.record-hero h1{font-size:clamp(2.6rem,10vw,3.8rem)}.record-plate{width:100%;max-width:480px;margin-inline:auto}.record-colophon{flex-direction:column;gap:5px;font-size:.95rem}.record-content{grid-template-columns:1fr;gap:30px;padding-top:40px}.record-reading{padding:24px}.record-related>div{grid-template-columns:1fr}.record-faq{padding-block:40px}}
</style>
