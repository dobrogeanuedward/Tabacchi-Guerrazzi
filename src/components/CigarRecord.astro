---
import Base from '../layouts/Base.astro';
import OfficialSources from './OfficialSources.astro';
import CommonsPhoto from './CommonsPhoto.astro';
import {cigarContextForRecord,cigarIdentityFacts,type CigarRecord as RecordType} from '../data/cigar-records';
import {pathFor,text,type Lang} from '../data/shop';
const {record,lang='it'}=Astro.props as {record:RecordType;lang:Lang};
const l=lang==='it'?0:1;const context=cigarContextForRecord(record);
const standalonePhoto=record.slug==='italico'?'orsago-campanile':record.slug==='villa-zamorano'?'danli':null;
---
<Base lang={lang} theme="cedro" slug={'sigari/'+record.slug} title={record.name+' — '+text(lang,'nomi e storia','names and history')} description={record.detail[l]||text(lang,record.name+': persone, luoghi e storia del nome.',record.name+': people, places and the name’s history.')}>
 <div class="breadcrumb wrap"><a href={pathFor('',lang)}>Home</a><span>/</span><a href={pathFor('sigari',lang)}>{text(lang,'Sigari','Cigars')}</a></div>
 <article class="record-document wrap">
  <header><p class="eyebrow">{text(lang,'Nomi e storie · 18+','Names and stories · 18+')}</p><h1>{record.name}</h1>{record.detail[l]&&<p>{record.detail[l]}</p>}{cigarIdentityFacts[record.slug]&&<OfficialSources sources={cigarIdentityFacts[record.slug].sources} lang={lang}/>}</header>
  {!context&&standalonePhoto&&<section class="record-context-photo"><CommonsPhoto id={standalonePhoto} lang={lang}/></section>}
  {context&&<section class:list={['record-context',context.photo&&'record-context--illustrated']}><div><h2>{context.title[l]}</h2>{context.paragraphs.map(paragraph=><p>{paragraph[l]}</p>)}<OfficialSources sources={context.sources} lang={lang}/></div>{context.photo&&<CommonsPhoto id={context.photo} lang={lang}/>}</section>}
  <nav class="record-reading" aria-label={text(lang,'Indice dei sigari','Cigar index')}><a href={pathFor('sigari',lang)}>{text(lang,'Torna ai nomi e alle storie','Back to names and histories')}</a></nav>
 </article>
</Base>
<style>
 .record-context-photo{max-width:640px}

 .record-document{max-width:1050px;padding-block:32px 64px;color:#493928}.record-document header{padding-bottom:30px;border-bottom:1px solid #d0c4b4}.record-document h1{font:400 clamp(2.2rem,4vw,3.2rem)/1.15 var(--display);overflow-wrap:anywhere;margin:20px 0 24px}.record-document h2{font:400 clamp(1.7rem,3vw,2.2rem)/1.2 var(--display);margin-bottom:20px}.record-document p{max-width:68ch;line-height:1.85}.record-document section{padding-block:30px;border-bottom:1px solid #d0c4b4}.record-document p+p{margin-top:18px}.record-context--illustrated{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:35px}.record-reading{padding-top:24px}.record-reading a{display:block;width:fit-content;min-height:44px;padding-block:12px;text-decoration:underline;text-underline-offset:4px}.record-reading a:focus-visible{outline:2px solid var(--blue);outline-offset:4px}@media(max-width:760px){.record-context--illustrated{grid-template-columns:1fr}}
</style>
