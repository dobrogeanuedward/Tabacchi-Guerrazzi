---
import {cigarBrandStories} from '../data/cigar-brand-stories';
import {pathFor,text,type Lang} from '../data/shop';
import CommonsPhoto from './CommonsPhoto.astro';
const {lang='it'}=Astro.props as {lang?:Lang};const l=lang==='it'?0:1;
---
<section class="brand-stories" id="storie-dei-marchi" aria-labelledby="brand-stories-title">
 <div class="brand-stories-heading"><p class="eyebrow">{text(lang,'Nomi e storie','Names and stories')}</p><h2 id="brand-stories-title">{text(lang,'Le persone dietro i nomi.','The people behind the names.')}</h2><p>{text(lang,'Una bottega di Ginevra, una famiglia partita dalle Canarie, una manifattura a Santiago. I nomi dei marchi custodiscono storie che attraversano paesi e generazioni.','A Geneva shop, a family from the Canary Islands, a factory in Santiago. Brand names preserve stories that cross countries and generations.')}</p></div>
 <div class="brand-story-grid">{cigarBrandStories.slice(0,4).map(story=><article class="brand-story-card"><CommonsPhoto id={story.photo} lang={lang} compact/><p class="brand-story-place">{story.place[l]}</p><h3><a href={pathFor(`sigari/storie/${story.slug}`,lang)}>{story.names.join(' · ')}</a></h3><p class="brand-story-summary">{story.summary[l]}</p><a class="brand-story-link" href={pathFor(`sigari/storie/${story.slug}`,lang)}>{text(lang,'Leggi la storia','Read the story')}<span class="sr-only"> {story.names.join(' · ')}</span></a></article>)}</div>
 <details class="more-brand-stories"><summary>{text(lang,'La Aurora, León Jimenes, A. Flores, Montosa e Parcero','La Aurora, León Jimenes, A. Flores, Montosa and Parcero')}</summary><div class="brand-story-grid">{cigarBrandStories.slice(4).map(story=><article class="brand-story-card"><CommonsPhoto id={story.photo} lang={lang} compact/><p class="brand-story-place">{story.place[l]}</p><h3><a href={pathFor(`sigari/storie/${story.slug}`,lang)}>{story.names.join(' · ')}</a></h3><p class="brand-story-summary">{story.summary[l]}</p><a class="brand-story-link" href={pathFor(`sigari/storie/${story.slug}`,lang)}>{text(lang,'Leggi la storia','Read the story')}<span class="sr-only"> {story.names.join(' · ')}</span></a></article>)}</div></details>
</section>
<style>
 .brand-stories{margin:0 0 60px;color:#493928}
 .brand-stories-heading{max-width:760px;margin:0 0 32px}
 .brand-stories-heading .eyebrow{margin:0 0 18px}
 .brand-stories-heading h2{font:400 clamp(2.1rem,3.5vw,3.2rem)/1.14 var(--display);letter-spacing:-.025em;margin:0 0 20px;color:#5b402b}
 .brand-stories-heading>p:last-child{line-height:1.85;max-width:65ch;margin:0}
 .brand-story-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
 .brand-story-card{display:flex;flex-direction:column;min-width:0;border-top:3px solid #896543;padding:16px;background:#f7f2e9}
 .brand-story-place{font-size:.78rem;line-height:1.6;margin:24px 0 10px;color:#6b5b49}
 .brand-story-card h3{font:400 clamp(1.6rem,2.5vw,2rem)/1.2 var(--display);letter-spacing:-.02em;margin:0 0 16px;overflow-wrap:anywhere}
 .brand-story-card h3 a{color:#5b402b;text-decoration:none}
 .brand-story-summary{font-size:.9rem;line-height:1.85;margin:0 0 24px}
 .brand-story-link{min-height:44px;align-content:center;border-top:1px solid #d0c4b4;margin-top:auto;padding-top:12px;font-size:.85rem;font-weight:600;color:#5b402b}
 .brand-story-link:hover,.brand-story-card h3 a:hover{text-decoration:underline;text-underline-offset:4px}
 .brand-story-link:focus-visible,.brand-story-card h3 a:focus-visible,.more-brand-stories summary:focus-visible{outline:2px solid var(--blue);outline-offset:4px}
 .more-brand-stories{margin-top:30px;border-block:1px solid #d0c4b4}
 .more-brand-stories>summary{min-height:64px;padding:20px 0;cursor:pointer;font-size:.95rem;line-height:1.7;font-weight:600}
 .more-brand-stories .brand-story-grid{padding:8px 0 30px}
 @media(max-width:1100px){.brand-story-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.brand-story-card{padding:20px}}
 @media(max-width:620px){.brand-stories{margin-bottom:40px}.brand-story-grid{grid-template-columns:1fr;gap:28px}.brand-story-card{padding:18px}.brand-stories-heading h2{font-size:2.1rem}.brand-story-card h3{font-size:1.9rem}}
</style>
