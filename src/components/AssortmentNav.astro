---
import AiDisclosure from './AiDisclosure.astro';
import {isGeneratedImage} from '../data/generated-images.mjs';
import {isSoftenedProductImage} from '../data/product-image-treatment.mjs';
import {assortmentImage} from '../data/assortment-images';
import {assortmentPages} from '../data/assortment';
import {pathFor,text,type Lang} from '../data/shop';
const {lang='it',slugs=null,compact=false}=Astro.props as {lang:Lang;slugs?:string[]|null;compact?:boolean};
const fundamental=[
 {slug:'idee-regalo',label:['Idee regalo','Gift ideas'],image:'/images/gifts.webp',description:['Piccoli pensieri, occasioni speciali','Little gifts, special occasions'],adult:false},
 {slug:'giochi-e-giocattoli',label:['Giochi e giocattoli','Games and toys'],image:'/images/games.webp',description:['Una scoperta per ogni età','A discovery for every age'],adult:false},
 {slug:'sigari',label:['Sigari','Cigars'],image:'',description:['Informazioni per adulti','Information for adults'],adult:true},
 {slug:'pipe-e-tabacchi-da-pipa',label:['Pipe e tabacchi da pipa','Pipes and pipe tobacco'],image:'',description:['Area informativa 18+','18+ information area'],adult:true},
];
const entries=[...(!slugs?fundamental:[]),...(slugs?slugs.map(s=>assortmentPages.find(p=>p.slug===s)).filter(Boolean):assortmentPages.filter(p=>!['ricevitoria','accendini-e-accessori','deposito-bagagli'].includes(p.slug))).map(p=>({slug:p!.slug,label:p!.label,image:p!.art?assortmentImage(({ 'souvenir-bologna':'souvenir','feste-e-compleanni':'feste','accessori-telefono':'telefono','piccole-necessita':'necessita'} as Record<string,string>)[p!.slug]||p!.slug):'',description:[0,1].map(l=>p!.groups[0]?.items.slice(0,2).map(item=>item[l]).join(', ')||text(l===0?'it':'en','Scopri le informazioni','Read the information')),adult:['ricevitoria','accendini-e-accessori'].includes(p!.slug)}))];
---
<section data-ai-disclosure-group class:list={['assortment-nav',compact?'compact':'']} aria-label={text(lang,'Esplora l’assortimento','Explore the range')}>
 <div class="section-opening"><h2>{text(lang,'Le categorie del negozio.','Shop categories.')}</h2><p>{text(lang,'Dai regali alle necessità di ogni giorno, orientati nel negozio.','From gifts to everyday essentials, find your way around the shop.')}{entries.some(entry=>isGeneratedImage(entry.image))&&<AiDisclosure inline lang={lang} message={text(lang,'Immagini illustrative generate con IA','Illustrative images generated with AI')}/>}</p></div>
 <div class="assortment-paths">{entries.map(p=><a href={pathFor(p.slug,lang)}>{p.image?<img src={p.image} width="320" height="320" loading="lazy" alt="" aria-hidden="true" data-product-obscured={isSoftenedProductImage(p.image)?'true':undefined}/>:<span class="category-information" aria-hidden="true">18+</span>}<div><span class="card-kind">{p.adult?text(lang,'Area informativa · 18+','Information area · 18+'):text(lang,'Categoria','Category')}</span><h3>{p.label[lang==='it'?0:1]}{p.adult&&<small class="category-age">18+</small>}</h3><p>{p.description[lang==='it'?0:1]}</p><span class="card-open">{p.adult?text(lang,'Apri le informazioni','Read the information'):text(lang,'Esplora la categoria','Explore this category')}</span></div></a>)}</div>
</section>
