---
import {assortmentPages} from '../data/assortment';
import {pathFor,text,type Lang} from '../data/shop';
const {lang='it',slugs=null,compact=false}=Astro.props as {lang:Lang;slugs?:string[]|null;compact?:boolean};
const entries=slugs?slugs.map(s=>assortmentPages.find(p=>p.slug===s)).filter(Boolean):assortmentPages.filter(p=>!['ricevitoria','accendini-e-accessori','deposito-bagagli'].includes(p.slug));
---
<section class:list={['assortment-nav',compact?'compact':'']} aria-label={text(lang,'Esplora l’assortimento','Explore the range')}>
 <div class="section-opening"><h2>{text(lang,'Anche per una piccola commissione.','For a little errand, too.')}</h2><p>{text(lang,'Quello che cerchi ha il suo posto.','There is a place for what you are looking for.')}</p></div>
 <div class="assortment-paths">{entries.map(p=>p&&<a href={pathFor(p.slug,lang)}>{p.art&&<img src={`/brand/ui/${p.art}-320.webp`} width="320" height="320" loading="lazy" alt="" aria-hidden="true"/>}<div><h3>{p.label[lang==='it'?0:1]}</h3><p>{p.groups[0]?.items.slice(0,2).map(item=>item[lang==='it'?0:1]).join(', ')||text(lang,'Scopri le informazioni','Read the information')}</p></div><span class="path-arrow" aria-hidden="true">↗</span></a>)}</div>
</section>
