---
import {cigarRecords} from '../data/cigar-records';import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};
const groups=[...new Set(cigarRecords.map(r=>r.group))].map(name=>({name,records:cigarRecords.filter(r=>r.group===name)}));
const groupLabel=(name:string)=>name==='Denominazioni da completare'?text(lang,name,'Names awaiting completion'):name==='Altre denominazioni'?text(lang,name,'Other names'):name;
---
<section class="cigar-records" aria-labelledby="cigar-records-title">
 <div class="records-heading">
  <p class="category-name eyebrow">{text(lang,'Archivio delle denominazioni · 18+','Name archive · 18+')}</p>
  <h2 id="cigar-records-title">{text(lang,'Le schede delle denominazioni.','The name records.')}</h2>
  <p>{text(lang,'Consulta le denominazioni e le informazioni su confezioni e avvertenze. Le schede sono riservate agli adulti e non indicano disponibilità o prezzi.','Browse names and information about packs and warnings. These pages are for adults and do not list stock or prices.')}</p>
 </div>
 <div class="records-groups">{groups.map((group,i)=><details open={i===0}>
  <summary><span class="record-group-name">{groupLabel(group.name)}</span><span class="record-group-count">{group.records.length} {text(lang,group.records.length===1?'voce':'voci',group.records.length===1?'record':'records')}</span><span class="record-toggle" aria-hidden="true"></span></summary>
  <div class="record-links">{group.records.map(r=><a href={pathFor(`sigari/${r.slug}`,lang)}><span class="record-name">{r.name}</span><span class="record-action">{text(lang,'Apri scheda','Open record')}<span aria-hidden="true">→</span></span></a>)}</div>
 </details>)}</div>
</section>
<style>
 .cigar-records{--record-ink:#57412f;--record-muted:#766352;--record-line:#d9cec0;--record-paper:#f6f1e7;margin:3rem 0 4rem;color:var(--record-ink)}
 .records-heading{max-width:760px}
 .records-heading .category-name{font:600 .95rem/1.6 var(--sans);color:var(--record-ink);letter-spacing:0;margin:0 0 18px}
 .records-heading h2{font:400 clamp(2.2rem,3.5vw,3.2rem)/1.12 var(--display);letter-spacing:-.025em;color:var(--record-ink);margin:0 0 22px}
 .records-heading>p:last-child{font-size:1rem;line-height:1.85;max-width:65ch;color:var(--record-muted);margin:0}
 .records-groups{margin-top:34px;border-bottom:1px solid var(--record-line)}
 .records-groups details{border-top:1px solid var(--record-line)}
 .records-groups summary{display:grid;grid-template-columns:minmax(0,1fr) auto 14px;gap:20px;align-items:center;min-height:76px;padding:22px 2px;cursor:pointer;list-style:none;color:var(--record-ink)}
 .records-groups summary::-webkit-details-marker{display:none}
 .record-group-name{font:600 1rem/1.6 var(--sans);overflow-wrap:anywhere}
 .record-group-count{font:400 .95rem/1.6 var(--sans);color:var(--record-muted);white-space:nowrap}
 .record-toggle{position:relative;width:12px;height:12px;justify-self:end}
 .record-toggle::before,.record-toggle::after{content:'';position:absolute;inset:5px 0 auto;height:1px;background:currentColor}
 .record-toggle::after{transform:rotate(90deg)}
 .records-groups details[open] .record-toggle::after{display:none}
 .record-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding:0 0 26px}
 .record-links a{display:flex;flex-direction:column;justify-content:space-between;gap:22px;min-width:0;min-height:132px;padding:22px;border:1px solid var(--record-line);background:var(--record-paper);color:var(--record-ink);text-decoration:none;transition:border-color .2s,background-color .2s}
 .record-name{font:400 1.5rem/1.2 var(--display);letter-spacing:-.015em;overflow-wrap:anywhere}
 .record-action{display:flex;align-items:center;justify-content:space-between;gap:16px;font:600 .95rem/1.6 var(--sans)}
 .record-action>span{font-size:1.15rem;font-weight:400;line-height:1}
 .record-links a:hover{border-color:var(--record-ink);background:#fffcf5}
 .record-links a:hover .record-action{text-decoration:underline;text-underline-offset:4px}
 .record-links a:focus-visible,.records-groups summary:focus-visible{outline:2px solid #0645c0;outline-offset:4px}
 @media(max-width:1000px){.record-links{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.cigar-records{margin:2.5rem 0 3rem}.records-heading h2{font-size:clamp(2rem,8vw,2.7rem)}.records-groups{margin-top:26px}.records-groups summary{grid-template-columns:minmax(0,1fr) auto;gap:6px 16px;padding-block:20px}.record-group-name{grid-column:1;grid-row:1}.record-group-count{grid-column:1;grid-row:2}.record-toggle{grid-column:2;grid-row:1/3;align-self:center}.record-links{grid-template-columns:1fr;gap:12px;padding-bottom:22px}.record-links a{min-height:120px;padding:20px}.record-name{font-size:1.4rem}}
 @media(prefers-reduced-motion:reduce){.record-links a{transition:none}}
</style>
