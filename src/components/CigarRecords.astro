---
import {cigarRecords} from '../data/cigar-records';import {pathFor,text,type Lang} from '../data/shop';
import OfficialSources from './OfficialSources.astro';
const {lang='it'}=Astro.props as {lang:Lang};
const groups=[...new Set(cigarRecords.map(r=>r.group))].map(name=>({name,records:cigarRecords.filter(r=>r.group===name)}));
const groupLabel=(name:string)=>name==='Denominazioni da completare'?text(lang,'Altri nomi e termini','Other names and terms'):name==='Altre denominazioni'?text(lang,name,'Other names'):name==='Lessico della costruzione'?text(lang,name,'Construction terminology'):name;
---
<section class="cigar-records" aria-labelledby="cigar-records-title">
 <div class="records-heading">
  <p class="category-name eyebrow">{text(lang,'Nomi e storie · 18+','Names and histories · 18+')}</p>
  <h2 id="cigar-records-title">{text(lang,'Denominazioni e fonti.','Names and sources.')}</h2>
  <p>{text(lang,'Un nome può indicare un marchio, una linea o un formato. Le voci di questo indice si accompagnano alle storie delle persone, delle manifatture e dei territori: da Lucca alla Valle del Brenta, da Ginevra all’America Centrale.','A name can identify a brand, a line or a format. Entries in this index sit alongside the stories of people, factories and regions, from Lucca and the Brenta Valley to Geneva and Central America.')}</p>
 </div>
 <div class="records-groups">{groups.map(group=><details>
  <summary><span class="record-group-name">{groupLabel(group.name)}</span><span class="record-group-count">{group.records.length} {text(lang,group.records.length===1?'voce':'voci',group.records.length===1?'record':'records')}</span><span class="record-toggle" aria-hidden="true"></span></summary>
  {group.name==='Toscanello'&&<div class="records-family-story"><h3>{text(lang,'Un nome nella storia del dopoguerra','A name in post-war history')}</h3><p>{text(lang,'Il nome Toscanello compare nel decreto del 14 settembre 1948 che ne dispone l’inserimento nella tariffa nazionale dal 1º ottobre dello stesso anno. È una traccia del nome nel secondo dopoguerra.','The name Toscanello appears in the decree of 14 September 1948, which entered it into the national tariff from 1 October that year. It records the name in the years after the Second World War.')}</p><OfficialSources sources={[{label:'Gazzetta Ufficiale — D.P.R. 14 settembre 1948, n. 1342',url:'https://www.gazzettaufficiale.it/atto/vediMenuHTML?atto.codiceRedazionale=048U1342&atto.dataPubblicazioneGazzetta=1948-11-22&tipoSerie=serie_generale&tipoVigenza=originario'}]} lang={lang}/></div>}
  <ul class="record-links">{group.records.map(r=><li><a href={pathFor(`sigari/${r.slug}`,lang)}>{r.name}</a></li>)}</ul>
 </details>)}</div>
</section>
<style>
 .cigar-records{--record-ink:#57412f;--record-muted:#766352;--record-line:#d9cec0;--record-paper:#f6f1e7;margin:3rem 0 4rem;color:var(--record-ink)}
 .records-heading{max-width:760px}
 .records-heading .category-name{font:600 .95rem/1.6 var(--sans);color:var(--record-ink);letter-spacing:0;margin:0 0 18px}
 .records-heading h2{font:400 clamp(2.2rem,3.5vw,3.2rem)/1.12 var(--display);letter-spacing:-.025em;color:var(--record-ink);margin:0 0 22px}
 .records-heading>p:last-child{font-size:1rem;line-height:1.85;max-width:65ch;color:var(--record-muted);margin:0}
 .records-groups{margin-top:34px;border-bottom:1px solid var(--record-line)}
 .records-groups details{border-top:1px solid var(--record-line)}
 .records-family-story{max-width:72ch;padding-block:5px 22px;line-height:1.85}.records-family-story h3{font-size:1.1rem;margin-bottom:16px}
 .records-groups summary{display:grid;grid-template-columns:minmax(0,1fr) auto 14px;gap:20px;align-items:center;min-height:76px;padding:22px 2px;cursor:pointer;list-style:none;color:var(--record-ink)}
 .records-groups summary::-webkit-details-marker{display:none}
 .record-group-name{font:600 1rem/1.6 var(--sans);overflow-wrap:anywhere}
 .record-group-count{font:400 .95rem/1.6 var(--sans);color:var(--record-muted);white-space:nowrap}
 .record-toggle{position:relative;width:12px;height:12px;justify-self:end}
 .record-toggle::before,.record-toggle::after{content:'';position:absolute;inset:5px 0 auto;height:1px;background:currentColor}
 .record-toggle::after{transform:rotate(90deg)}
 .records-groups details[open] .record-toggle::after{display:none}
 .record-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 26px;padding:0 0 26px 22px;list-style:disc}
 .record-links a{display:inline-block;min-height:44px;padding:10px 0;color:var(--record-ink);text-decoration:underline;text-underline-offset:3px;font-size:1rem;line-height:1.6}
 .record-name{font:400 1.5rem/1.2 var(--display);letter-spacing:-.015em;overflow-wrap:anywhere}
 .record-action{display:flex;align-items:center;justify-content:space-between;gap:16px;font:600 .95rem/1.6 var(--sans)}
 .record-action>span{font-size:1.15rem;font-weight:400;line-height:1}
 .record-links a:hover{text-decoration-thickness:2px}
 .record-links a:hover .record-action{text-decoration:underline;text-underline-offset:4px}
 .record-links a:focus-visible,.records-groups summary:focus-visible{outline:2px solid #0645c0;outline-offset:4px}
 @media(max-width:1000px){.record-links{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.cigar-records{margin:2.5rem 0 3rem}.records-heading h2{font-size:clamp(2rem,8vw,2.7rem)}.records-groups{margin-top:26px}.records-groups summary{grid-template-columns:minmax(0,1fr) auto;gap:6px 16px;padding-block:20px}.record-group-name{grid-column:1;grid-row:1}.record-group-count{grid-column:1;grid-row:2}.record-toggle{grid-column:2;grid-row:1/3;align-self:center}.record-links{grid-template-columns:1fr;gap:0;padding-bottom:22px}.record-links a{min-height:44px;padding:10px 0}}
 @media(prefers-reduced-motion:reduce){.record-links a{transition:none}}
</style>
