---
import {cigarRecords} from '../data/cigar-records';import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};const groups=[...new Set(cigarRecords.map(r=>r.group))];
---
<section class="cigar-records" aria-labelledby="cigar-records-title"><div class="records-heading"><div><p class="category-name eyebrow">{text(lang,'Archivio delle denominazioni · 18+','Name records · 18+')}</p><h2 id="cigar-records-title">{text(lang,'I nomi, con il loro contesto.','Names in their context.')}</h2><p>{text(lang,'Schede ricavate dalla ricognizione fotografica del negozio. Ogni voce distingue il nome osservato dai dati ancora da verificare. Non è un listino né una conferma di giacenza.','Records drawn from the shop photograph survey. Each distinguishes observed wording from details that still need checking. This is neither a price list nor a stock confirmation.')}</p></div><img src="/brand/ui/archive-reference.webp" width="640" height="640" loading="lazy" alt="" aria-hidden="true"/></div>
<div class="records-groups">{groups.map((group,i)=><details open={i===0}><summary>{group==='Denominazioni da completare'?text(lang,group,'Names awaiting completion'):group==='Altre denominazioni'?text(lang,group,'Other names'):group}<span>{cigarRecords.filter(r=>r.group===group).length} {text(lang,'voci','records')}</span></summary><div class="record-links">{cigarRecords.filter(r=>r.group===group).map(r=><a href={pathFor(`sigari/${r.slug}`,lang)}>{r.name}<span aria-hidden="true">↗</span></a>)}</div></details>)}</div>
<p class="records-note">{text(lang,'Le diciture parziali Affinato, Zeffiro, Levante, Scorciato, Nazionale, Talco e Fermentato restano nel registro di verifica; non hanno una scheda finché nome e attribuzione non sono confermati.','Partial readings Affinato, Zeffiro, Levante, Scorciato, Nazionale, Talco and Fermentato remain in the verification register; they do not have a record until their names and attribution are confirmed.')}</p></section>
<style>.cigar-records{margin:3rem 0 4rem}.records-heading{display:grid;grid-template-columns:1fr 240px;align-items:center;gap:2rem}.records-heading h2{font-size:clamp(2.4rem,4vw,3.6rem);color:var(--blue);margin:.8rem 0 1rem}.records-heading p{max-width:65ch}.records-heading img{width:100%;mix-blend-mode:multiply}.records-groups{margin-top:1.5rem}.records-groups details{border-top:1px solid var(--line)}.records-groups summary{padding:1.3rem .2rem;cursor:pointer;font-weight:600}.records-groups summary>span{float:right;font-size:.8rem;font-weight:400}.record-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 1.5rem;padding:0 0 1.5rem}.record-links a{display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:55px;border-bottom:1px solid var(--line);color:var(--blue);font-size:.95rem}.records-note{font-size:.85rem;max-width:85ch;margin-top:1rem;line-height:1.7}@media(max-width:680px){.records-heading{grid-template-columns:1fr 100px;gap:.8rem}.records-heading>div{grid-column:1/-1}.records-heading img{grid-column:2;grid-row:2}.record-links{grid-template-columns:1fr 1fr;gap:0 1rem}.record-links a{font-size:.85rem}.records-groups summary>span{float:none;display:block;margin:.5rem 0 0}}@media(max-width:370px){.record-links{grid-template-columns:1fr}}</style>
