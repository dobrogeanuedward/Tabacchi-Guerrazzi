---
import {serviceIdentities} from '../data/service-identities';import {pathFor,text,type Lang} from '../data/shop';
const {lang='it',compact=false}=Astro.props as {lang:Lang;compact?:boolean};const l=lang==='it'?0:1;const individualServices=serviceIdentities.filter(service=>!service.overview);
---
<section id="servizi-disponibili" class:list={['service-identities',{'is-compact':compact}]} aria-labelledby="service-identities-title"><header><p class="section-label">{text(lang,'I servizi, per nome','Services, by name')}</p><h2 id="service-identities-title">{text(lang,'Scegli la tua commissione.','Choose your errand.')}</h2><p>{text(lang,'Una pagina per ogni servizio: cosa preparare, dove trovarci e quali informazioni controllare prima della visita.','A page for each service: what to prepare, where to find us and what to check before your visit.')}</p></header><div class="service-identity-grid">
 <a class="identity-card" href={pathFor('deposito-bagagli',lang)}><div class="identity-logos"><img src="/brand/partners/bounce-official.svg" width="150" height="40" alt="Bounce" loading="lazy"/></div><h3>{text(lang,'Deposito bagagli','Luggage storage')}</h3><p>{text(lang,'La scheda Bounce si chiama Palazzo Ercolani. Data, orari e prenotazione si gestiscono sulla piattaforma.','The Bounce listing is called Palazzo Ercolani. Manage dates, hours and booking on the platform.')}</p><span>{text(lang,'Organizza il deposito','Plan storage')}</span></a>
 {individualServices.map(service=><article class="identity-card"><div class="identity-logos">{service.logos.length?service.logos.map(logo=><img class={logo.name==='pagoPA'?'official-logo--pagopa':undefined} src={`/brand/partners/${logo.file}`} width={logo.width||150} height={logo.height||40} alt={logo.name} loading="lazy"/>):<span class="identity-counter-label">{text(lang,'Al banco · Via Guerrazzi 10/F','At the counter · Via Guerrazzi 10/F')}</span>}</div><h3><a class="identity-link" href={pathFor(`servizi/${service.slug}`,lang)}>{service.title[l]}</a></h3><p>{service.intro[l]}</p><span>{text(lang,'Leggi i dettagli','Read the details')}</span></article>)}
 </div></section>
<style>
.identity-logos img.official-logo--pagopa{background:var(--blue);padding:8px 12px;box-sizing:content-box}
.service-identities{scroll-margin-top:30px}.service-identities header>p:last-child{max-width:65ch;line-height:1.85;font-size:.95rem;margin-top:20px}.identity-card{position:relative;min-width:0}.identity-link::after{content:'';position:absolute;inset:0;z-index:1}.identity-link:focus-visible{outline:none}.identity-link:focus-visible::after{outline:3px solid var(--blue);outline-offset:4px}
.identity-counter-label{font-size:.85rem;line-height:1.6;color:var(--blue)}
.service-identities{margin-block:38px 55px}.service-identities header{margin-bottom:28px}.service-identities h2{font:400 clamp(2.1rem,3.4vw,3rem)/1.16 var(--display);color:var(--blue)}.service-identity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.identity-card{border:1px solid var(--line);padding:28px;display:flex;flex-direction:column;background:#fffdfa}.identity-logos{min-height:60px;display:flex;flex-wrap:wrap;gap:22px;align-items:center;margin-bottom:24px}.identity-logos img{max-width:150px;width:auto;height:auto;max-height:40px;object-fit:contain}.identity-logos :global(.identity-photo){height:60px;max-height:60px;width:100px;object-fit:cover}.identity-card h3{font:400 2rem/1.15 var(--display);color:var(--blue);margin-bottom:17px}.identity-card p{font-size:.96rem;line-height:1.85;margin-bottom:25px}.identity-card>span{font-size:.9rem;font-weight:600;color:var(--blue);margin-top:auto;padding-top:18px;border-top:1px solid var(--line)}.identity-card:hover{border-color:var(--blue)}.identity-card:focus-visible{outline:3px solid var(--blue);outline-offset:4px}.is-compact{padding-block:35px;border-block:1px solid var(--line)}@media(max-width:680px){.service-identity-grid{grid-template-columns:1fr}.identity-card{padding:23px}}
</style>
