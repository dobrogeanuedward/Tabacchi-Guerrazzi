---
import Base from '../layouts/Base.astro';import {getProductBySlug} from '../lib/store.mjs';import {catalogGroups} from '../data/catalog-assortment';import {pathFor,text,type Lang} from '../data/shop';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const p=getProductBySlug(slug);
if(!p||!['regali','giochi','cartoleria','accessori'].includes(p.category))return Astro.redirect(pathFor('catalogo',lang),302);
const name=lang==='it'?p.nameIt:p.nameEn;const description=lang==='it'?p.descriptionIt:p.descriptionEn;
const images=[...new Set([p.image,...p.gallery])];
const group=catalogGroups.find(g=>g.id===p.category);const categoryLabel=group?(lang==='it'?group.it:group.en):text(lang,'Accessori regalo','Gift accessories');
const availabilityIt:Record<string,string>={available:'Disponibile in negozio',unavailable:'Attualmente non disponibile','on-request':'Disponibilità da verificare'};
const availabilityEn:Record<string,string>={available:'Available in store',unavailable:'Currently unavailable','on-request':'Check availability'};
---
<Base title={name} description={description.slice(0,160)} lang={lang} slug={`catalogo/${slug}`} image={p.image||'/images/hero/portico.webp'}>
<div class="wrap product-shell"><div class="breadcrumb"><a href={pathFor('',lang)}>Home</a><span>/</span><a href={pathFor('catalogo',lang)}>{text(lang,'Catalogo','Catalogue')}</a><span>/</span><span>{name}</span></div>
 <header class="product-heading"><p class="product-record-label"><span>{text(lang,'Prodotto','Product')}</span>{categoryLabel}</p><h1>{name}</h1></header>
 <div class="product-detail">
  <figure class="product-media"><div class="product-image-frame"><img id="main-product-image" class="main-product-image" src={p.image} alt={name} width="900" height="900" fetchpriority="high"/></div>{images.length>1&&<div class="product-thumbs" role="group" aria-label={text(lang,'Immagini del prodotto','Product images')}>{images.map((src:string,i:number)=><button type="button" data-product-src={src} aria-pressed={i===0?'true':'false'} aria-label={`${text(lang,'Visualizza immagine','View image')} ${i+1}`}><img src={src} alt="" width="150" height="150" loading="lazy"/></button>)}</div>}<figcaption>{text(lang,'Immagini pubblicate per questa scheda. Verifica con il negozio la variante e la confezione che cerchi.','Images published for this record. Check the variant and pack you need with the shop.')}</figcaption></figure>
  <div class="product-summary"><section class="product-description-panel" aria-labelledby="product-description-title"><h2 id="product-description-title">{text(lang,'Descrizione','Description')}</h2><p>{description}</p></section><section class="product-facts" aria-labelledby="product-facts-title"><h2 id="product-facts-title">{text(lang,'Dati della scheda','Record details')}</h2><dl><div><dt>{text(lang,'Categoria','Category')}</dt><dd>{categoryLabel}</dd></div>{p.brand&&<div><dt>{text(lang,'Marchio','Brand')}</dt><dd>{p.brand}</dd></div>}<div class="product-fact-wide"><dt>{text(lang,'Disponibilità indicata','Listed availability')}</dt><dd>{text(lang,availabilityIt[p.availability]||availabilityIt['on-request'],availabilityEn[p.availability]||availabilityEn['on-request'])}</dd></div>{p.price!==null&&<div><dt>{text(lang,'Prezzo indicato','Listed price')}</dt><dd class="product-price">{new Intl.NumberFormat(lang==='it'?'it-IT':'en-GB',{style:'currency',currency:'EUR'}).format(p.price)}</dd></div>}</dl></section><div class="product-contact-panel"><a class="button primary" href={pathFor('contatti',lang)}>{text(lang,'Chiedi informazioni','Ask for information')}<span aria-hidden="true">→</span></a><p>{text(lang,'Prima della visita, verifica disponibilità e variante. Gli acquisti si effettuano in negozio.','Before visiting, check availability and variant. Purchases are made in store.')}</p><a class="product-back-link" href={`${pathFor('catalogo',lang)}?categoria=${p.category}`}><span aria-hidden="true">←</span>{text(lang,'Torna a','Back to')} {categoryLabel.toLowerCase()}</a></div></div>
 </div>
</div>
<script>
 const main=document.querySelector<HTMLImageElement>('#main-product-image');
 const thumbs=[...document.querySelectorAll<HTMLButtonElement>('[data-product-src]')];
 thumbs.forEach(button=>button.addEventListener('click',()=>{if(main&&button.dataset.productSrc){main.src=button.dataset.productSrc;thumbs.forEach(other=>other.setAttribute('aria-pressed',String(other===button)))}}));
</script>
<style>
 .product-shell{--product-line:#0645c028}
 .product-shell .breadcrumb{flex-wrap:wrap;row-gap:7px;overflow-wrap:anywhere}
 .product-heading{padding:15px 0 30px;max-width:1000px}
 .product-record-label{display:flex;flex-wrap:wrap;align-items:center;gap:9px;font-family:var(--sans);font-size:.95rem;line-height:1.6;font-weight:600;color:#42516a;margin-bottom:18px}
 .product-record-label>span{padding:5px 8px;border-radius:2px;background:#e8effb;color:var(--blue)}
 .product-heading h1{font-family:var(--display);font-size:clamp(2.5rem,4.5vw,3.7rem);line-height:1.1;letter-spacing:-.035em;color:var(--blue);overflow-wrap:break-word;margin:0}
 .product-detail{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:40px;align-items:start;padding:0 0 75px}
 .product-media{min-width:0;padding:22px;border:1px solid var(--product-line);border-radius:3px;background:#fffefa}
 .product-image-frame{overflow:hidden;border:1px solid #e5e2d9;border-radius:2px;background:#f6f1e7}
 .product-detail .main-product-image{width:100%;aspect-ratio:1;max-height:600px;object-fit:contain;background:#f6f1e7}
 .product-thumbs{display:flex;flex-wrap:wrap;gap:10px;margin-top:15px}
 .product-thumbs button{width:70px;min-width:44px;min-height:44px;padding:4px;aspect-ratio:1;border:1px solid #0645c033;border-radius:2px;background:#fff}
 .product-thumbs button[aria-pressed='true']{border:2px solid var(--blue);background:#edf2fc;padding:3px}
 .product-thumbs button:hover{border-color:var(--blue)}
 .product-thumbs img{width:100%;height:100%;object-fit:contain}
 .product-media figcaption{font-size:.95rem;line-height:1.8;color:#566070;margin-top:17px}
 .product-summary{display:flex;flex-direction:column;min-width:0;gap:22px}
 .product-description-panel,.product-facts,.product-contact-panel{padding:27px;border:1px solid var(--product-line);border-radius:3px;background:#fffefa}
 .product-summary h2{font-family:var(--display);font-size:1.75rem;line-height:1.2;letter-spacing:-.025em;color:var(--blue);margin:0 0 18px}
 .product-description-panel>p{font-size:.95rem;line-height:1.9;white-space:pre-line;color:#33435b;margin:0;overflow-wrap:break-word}
 .product-facts{background:linear-gradient(#f6f1e7f2,#f6f1e7f2),url('/images/materials/paper.webp') center/cover}
 .product-facts h2{font-family:var(--sans);font-size:.95rem;line-height:1.6;font-weight:600;letter-spacing:0;margin-bottom:22px}
 .product-facts dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 24px;padding:0;margin:0}
 .product-facts dt{font-size:.95rem;line-height:1.6;color:#5b6170;margin-bottom:6px}
 .product-facts dd{font-size:.95rem;line-height:1.75;color:#243b59;margin:0;overflow-wrap:break-word}
 .product-fact-wide{grid-column:1/-1}
 .product-facts .product-price{font-size:1.2rem;font-weight:600;color:var(--blue)}
 .product-contact-panel{background:#edf2fc}
 .product-contact-panel .button{font-size:.95rem;min-height:48px}
 .product-contact-panel>p{font-size:.95rem;line-height:1.8;white-space:normal;color:#42516a;margin:22px 0}
 .product-back-link{display:inline-flex;align-items:center;gap:9px;font-size:.95rem;line-height:1.6;font-weight:600;color:var(--blue);padding:8px 0;text-decoration:underline;text-underline-offset:5px}
 @media(max-width:900px){.product-detail{gap:25px}.product-description-panel,.product-facts,.product-contact-panel{padding:23px}.product-media{padding:18px}}
 @media(max-width:680px){.product-heading{padding-top:8px;padding-bottom:25px}.product-heading h1{font-size:2.6rem}.product-detail{grid-template-columns:minmax(0,1fr);gap:24px;padding-bottom:50px}.product-summary{gap:18px}.product-description-panel,.product-facts,.product-contact-panel{padding:23px}.product-thumbs button{width:60px}.product-contact-panel .button{width:100%;padding-inline:15px}.product-detail .main-product-image{max-height:450px}}
 @media(max-width:360px){.product-heading h1{font-size:2.35rem}.product-facts dl{grid-template-columns:minmax(0,1fr)}.product-description-panel,.product-facts,.product-contact-panel{padding:20px}.product-media{padding:15px}}
</style>
</Base>
