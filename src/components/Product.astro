---
import AiDisclosure from './AiDisclosure.astro';
import DisclosedImage from './DisclosedImage.astro';
import {isGeneratedImage} from '../data/generated-images.mjs';
import NeighborhoodLinks from './NeighborhoodLinks.astro';
import Base from '../layouts/Base.astro';
import {getProductBySlug} from '../lib/catalog.mjs';
import {getSiteOrigin} from '../lib/site-origin.mjs';
import {catalogAssortment,catalogGroups} from '../data/catalog-assortment';
import {familyPresentationFor} from '../data/family-presentation';
import {pathFor,text,type Lang} from '../data/shop';

const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};
const p=getProductBySlug(slug);
if(!p||!catalogGroups.some(group=>group.id===p.category)&&p.category!=='accessori')return Astro.redirect(pathFor('catalogo',lang),302);
const l=lang==='it'?0:1;
const name=lang==='it'?p.nameIt:p.nameEn;
const description=lang==='it'?p.descriptionIt:p.descriptionEn;
const images=[...new Set([p.image,...p.gallery].filter(Boolean))];
const imageAlts=[(lang==='it'?p.imageAltIt:p.imageAltEn)||name,...((lang==='it'?p.galleryAltIt:p.galleryAltEn)||p.gallery.map(()=>name))];
const group=catalogGroups.find(g=>g.id===p.category);
const categoryLabel=group?(lang==='it'?group.it:group.en):text(lang,'Accessori regalo','Gift accessories');
const presentation=familyPresentationFor(p.category);
const relatedFamilies=catalogAssortment.filter(item=>item.category===(p.category==='accessori'?'regali':p.category)).slice(0,3);
const availabilityIt:Record<string,string>={available:'Disponibile in negozio',unavailable:'Attualmente non disponibile','on-request':'Chiedi ad Angela'};
const availabilityEn:Record<string,string>={available:'Available in store',unavailable:'Currently unavailable','on-request':'Ask Angela'};
const updated=Number.isFinite(p.updated)?new Date(p.updated):null;
const origin=getSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const url=new URL(pathFor(`catalogo/${slug}`,lang),origin).href;
const schema={'@context':'https://schema.org','@type':'Product','@id':`${url}#product`,url,mainEntityOfPage:{'@id':`${url}#webpage`},name,description,image:images.map(src=>new URL(src,origin).href),category:categoryLabel};
---
<Base title={name} description={description.slice(0,160)} lang={lang} slug={`catalogo/${slug}`} theme={presentation.theme} image={p.image||'/images/hero/portico.webp'} schema={schema}>
  <div class="product-document" data-treatment={presentation.treatment} style={`--product-material: url('/images/materials/${presentation.material}-768.webp')`}>
    <div class="wrap product-shell">
      <nav class="breadcrumb" aria-label={text(lang,'Percorso di navigazione','Breadcrumb')}><a href={pathFor('',lang)}>Home</a><span aria-hidden="true">/</span><a href={pathFor('catalogo',lang)}>{text(lang,'Catalogo','Catalogue')}</a><span aria-hidden="true">/</span><a href={`${pathFor('catalogo',lang)}?categoria=${p.category}`}>{categoryLabel}</a></nav>
      <header class="product-heading"><p class="product-record-label"><span>{text(lang,'Scheda prodotto','Product record')}</span>{categoryLabel}</p><h1>{name}</h1></header>

      <div class="product-detail">
        <figure class="product-media">
          <div class="product-image-frame"><DisclosedImage dynamicDisclosure lang={lang} id="main-product-image" class="main-product-image" src={p.image} alt={(lang==='it'?p.imageAltIt:p.imageAltEn)||name} width="1440" height="960" fetchpriority="high"/></div>
          {images.length>1&&<div class="product-gallery-controls" data-ai-disclosure-group><p>{text(lang,'Galleria','Gallery')} <span>{images.length} {text(lang,'immagini','images')}</span>{images.some(isGeneratedImage)&&<AiDisclosure inline lang={lang} message={images.every(isGeneratedImage)?text(lang,'Immagini della galleria generate con IA','AI-generated gallery images'):text(lang,'La galleria include immagini generate con IA','The gallery includes AI-generated images')}/>}</p><div class="product-thumbs" role="group" aria-label={text(lang,'Immagini del prodotto','Product images')}>{images.map((src:string,i:number)=><button type="button" data-product-src={src} data-product-generated={String(isGeneratedImage(src))} data-product-alt={imageAlts[i]} aria-pressed={i===0?'true':'false'} aria-label={`${text(lang,'Visualizza immagine','View image')} ${i+1}: ${imageAlts[i]}`}><img src={src} alt="" width="150" height="150" loading="lazy"/></button>)}</div></div>}
          <figcaption>{(lang==='it'?p.imageCaptionIt:p.imageCaptionEn)||text(lang,'Immagini pubblicate per questa scheda. Verifica con il negozio la variante e la confezione che cerchi.','Images published for this record. Check the variant and pack you need with the shop.')}</figcaption>
        </figure>

        <div class="product-summary">
          <section class="product-description-panel" aria-labelledby="product-description-title"><p class="product-section-label">{text(lang,'Il singolo articolo','The individual item')}</p><h2 id="product-description-title">{text(lang,'Descrizione.','Description.')}</h2><p class="product-description">{description}</p></section>
          <section class="product-facts" aria-labelledby="product-facts-title">
            <h2 id="product-facts-title">{text(lang,'In breve','At a glance')}</h2>
            <dl><div><dt>{text(lang,'Categoria','Category')}</dt><dd>{categoryLabel}</dd></div>{p.brand&&<div><dt>{p.brandRole==='distributor'?text(lang,'Selezionato e distribuito da','Selected and distributed by'):text(lang,'Marchio','Brand')}</dt><dd>{p.brand}</dd></div>}<div><dt>{text(lang,'Per saperne di più','Find out more')}</dt><dd>{text(lang,availabilityIt[p.availability]||availabilityIt['on-request'],availabilityEn[p.availability]||availabilityEn['on-request'])}</dd></div>{p.price!==null&&p.price!==undefined&&<div><dt>{p.source?text(lang,'Prezzo','Price'):text(lang,'Prezzo indicato','Listed price')}</dt><dd class="product-price">{new Intl.NumberFormat(lang==='it'?'it-IT':'en-GB',{style:'currency',currency:'EUR'}).format(p.price)}</dd></div>}</dl>
            {updated&&<p class="product-updated">{text(lang,'Aggiornamento scheda:','Record updated:')} <time datetime={updated.toISOString()}>{new Intl.DateTimeFormat(lang==='it'?'it-IT':'en-GB',{day:'numeric',month:'long',year:'numeric'}).format(updated)}</time></p>}
          </section>
          <div class="product-contact-panel"><a class="button primary" href={pathFor('contatti',lang)}>{text(lang,'Chiedi informazioni','Ask for information')}</a><p>{text(lang,'Ti aspettiamo in Via Guerrazzi 10/F. Se hai una domanda, raccontacela al banco.','Find us at Via Guerrazzi 10/F. Bring your questions to the counter.')}</p><a class="product-back-link" href={`${pathFor('catalogo',lang)}?categoria=${p.category}`}>{text(lang,'Torna a','Back to')} {categoryLabel.toLowerCase()}</a></div>
        </div>
      </div>

      <NeighborhoodLinks topic={presentation.page} lang={lang}/>
      <section class="product-visit-notes" aria-labelledby="product-visit-title">
        <div class="product-notes-opening"><p class="product-section-label">{text(lang,'Prima della visita','Before visiting')}</p><h2 id="product-visit-title">{text(lang,'Una cosa da sapere.','Something to know.')}</h2></div>
        <ol>{presentation.checkNotes.map((note,i)=><li><span aria-hidden="true">0{i+1}</span><p>{note[l]}</p></li>)}</ol>
      </section>

      {relatedFamilies.length>0&&<section class="product-related" aria-labelledby="product-related-title"><div class="product-related-heading"><div><p class="product-section-label">{text(lang,'Per orientarti nella categoria','Explore the category')}</p><h2 id="product-related-title">{text(lang,'Le famiglie di articoli.','Item families.')}</h2></div><a class="product-back-link" href={pathFor(presentation.page,lang)}>{text(lang,'Apri la categoria','Open the category')}</a></div><div class="product-related-grid">{relatedFamilies.map(item=><a href={pathFor(`assortimento/${item.id}`,lang)}><span class="product-section-label">{text(lang,'Famiglia','Family')}</span><h3>{item.name[l]}</h3><p>{item.description[l]}</p><span class="product-related-action">{text(lang,'Apri la scheda','Open the record')}</span></a>)}</div></section>}
    </div>
  </div>
</Base>
<script>
  const main=document.querySelector<HTMLImageElement>('#main-product-image');
  const thumbs=[...document.querySelectorAll<HTMLButtonElement>('[data-product-src]')];
  thumbs.forEach(button=>button.addEventListener('click',()=>{if(main&&button.dataset.productSrc){main.src=button.dataset.productSrc;main.alt=button.dataset.productAlt||main.alt;const generated=button.dataset.productGenerated==='true';main.toggleAttribute('data-ai-generated',generated);const disclosure=main.parentElement?.querySelector<HTMLElement>('.ai-disclosure');if(disclosure){const panel=disclosure.querySelector<HTMLElement>('[popover]');if(panel&&'hidePopover' in panel&&panel.matches(':popover-open'))panel.hidePopover();panel?.removeAttribute('data-open');disclosure.querySelector('button')?.setAttribute('aria-expanded','false');disclosure.hidden=!generated;}thumbs.forEach(other=>other.setAttribute('aria-pressed',String(other===button)))}}));
</script>
<style>
  .product-document{--product-tone:var(--accent);--product-line:color-mix(in srgb,var(--accent) 23%,#e5e0d5);--product-muted:#4d5a68;color:var(--ink)}
  .product-shell .breadcrumb{flex-wrap:wrap;row-gap:7px;overflow-wrap:anywhere;font-size:.95rem;line-height:1.7}
  .product-shell .breadcrumb a{display:inline-flex;align-items:center;min-height:44px}
  .product-heading{padding:18px 0 35px;max-width:1100px}
  .product-record-label{display:flex;flex-wrap:wrap;align-items:center;gap:13px;font-size:.95rem;line-height:1.7;color:var(--product-muted);margin-bottom:20px}
  .product-record-label>span{border-left:3px solid var(--product-tone);padding-left:12px;font-weight:600;color:var(--product-tone)}
  .product-heading h1{font-size:clamp(2.5rem,4.7vw,4rem);line-height:1.09;letter-spacing:-.035em;color:var(--product-tone);overflow-wrap:break-word;margin:0;max-width:25ch}
  .product-detail{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:6%;align-items:start;padding:0 0 62px}
  .product-media{min-width:0;margin:0}
  .product-image-frame{padding:0;overflow:hidden;background:#fffefa;border:1px solid var(--product-line);border-bottom:3px solid var(--product-tone)}
  .product-detail .main-product-image{width:100%;aspect-ratio:3/2;max-height:570px;object-fit:cover;background:#fffefa}
  [data-treatment='gift'] .product-image-frame{border-radius:48px 3px 3px 3px}
  [data-treatment='play'] .product-image-frame{border-radius:3px 3px 48px 3px;background:linear-gradient(#f5d978b8,#f5d978b8),var(--product-material) center/cover}
  [data-treatment='paper'] .product-image-frame{border-left:4px solid var(--product-tone);border-bottom-width:1px}
  .product-gallery-controls{margin-top:19px}
  .product-gallery-controls>p{font-size:.95rem;line-height:1.65;color:var(--product-tone);font-weight:600;margin-bottom:10px}
  .product-gallery-controls>p>span{color:var(--product-muted);font-weight:400;margin-left:14px}
  .product-gallery-controls>p>.ai-group-disclosure{display:inline;font:inherit}.product-thumbs{display:flex;flex-wrap:wrap;gap:11px}
  .product-thumbs button{width:70px;min-width:44px;min-height:44px;padding:4px;aspect-ratio:1;border:1px solid var(--product-line);border-radius:2px;background:#fff}
  .product-thumbs button[aria-pressed='true']{border:2px solid var(--product-tone);background:var(--surface);padding:3px}
  .product-thumbs button:hover{border-color:var(--product-tone)}
  .product-thumbs img{width:100%;height:100%;object-fit:contain}
  .product-media figcaption{font-size:.95rem;line-height:1.8;color:var(--product-muted);margin-top:18px;max-width:64ch}
  .product-summary{display:flex;flex-direction:column;min-width:0;gap:27px}
  .product-section-label{font-size:.95rem;line-height:1.65;font-weight:600;color:var(--product-tone);margin-bottom:15px}
  .product-summary h2{font-size:2.1rem;line-height:1.15;letter-spacing:-.025em;color:var(--product-tone);margin:0 0 21px}
  .product-description-panel>p.product-description{font-size:1rem;line-height:1.9;white-space:pre-line;color:#33435b;margin:0;overflow-wrap:break-word}
  .product-facts{padding:25px 26px;background:linear-gradient(#fbf8f0e8,#fbf8f0e8),var(--product-material) center/cover;border-top:2px solid var(--product-tone)}
  .product-facts h2{font-family:var(--sans);font-size:.95rem;line-height:1.6;font-weight:600;letter-spacing:0;margin-bottom:14px}
  .product-facts dl{margin:0;padding:0}
  .product-facts dl>div{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:18px;padding:13px 0;border-bottom:1px solid var(--product-line)}
  .product-facts dl>div:last-child{border-bottom:0}
  .product-facts dt{font-size:.95rem;line-height:1.7;color:var(--product-muted)}
  .product-facts dd{font-size:1rem;line-height:1.7;color:#243b59;margin:0;overflow-wrap:break-word}
  .product-facts .product-price{font-size:1.2rem;font-weight:600;color:var(--product-tone)}
  .product-updated{font-size:.95rem;line-height:1.8;color:var(--product-muted);margin-top:17px;border-top:1px solid var(--product-line);padding-top:15px}
  .product-contact-panel .button{font-size:.95rem;min-height:48px}
  .product-contact-panel>p{font-size:.95rem;line-height:1.8;color:#42516a;margin:20px 0 8px;max-width:55ch}
  .product-back-link{display:inline-flex;align-items:center;gap:13px;font-size:.95rem;line-height:1.7;font-weight:600;color:var(--product-tone);min-height:44px;padding:7px 0;text-decoration:underline;text-underline-offset:5px}
  .product-visit-notes{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:7%;border-top:1px solid var(--product-line);padding-block:44px 55px}
  .product-notes-opening h2,.product-related-heading h2{font-size:clamp(2rem,3.1vw,2.8rem);line-height:1.12;color:var(--product-tone);letter-spacing:-.03em;max-width:22ch}
  .product-notes-opening img{width:175px;height:175px;object-fit:contain;margin-top:22px}
  .product-visit-notes ol{list-style:none;padding:0;margin:0;border-top:1px solid var(--product-line)}
  .product-visit-notes li{display:grid;grid-template-columns:34px minmax(0,1fr);gap:21px;align-items:baseline;border-bottom:1px solid var(--product-line);padding:22px 0}
  .product-visit-notes li>span{font-family:var(--display);font-size:1.7rem;line-height:1.15;color:var(--product-tone)}
  .product-visit-notes li>p{font-size:1rem;line-height:1.8;color:#34435a;max-width:65ch}
  .product-related{padding-bottom:64px}
  .product-related-heading{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:22px;margin-bottom:28px}
  .product-related-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:21px}
  .product-related-grid>a{display:flex;flex-direction:column;min-width:0;padding:25px 27px;background:var(--surface);border:1px solid var(--product-line)}
  .product-related-grid h3{font-size:1.8rem;line-height:1.2;color:var(--product-tone);margin-bottom:15px}
  .product-related-grid p{font-size:.95rem;line-height:1.8;color:#42516a;margin-bottom:21px}
  .product-related-action{display:flex;justify-content:space-between;align-items:center;gap:18px;min-height:44px;font-size:.95rem;line-height:1.6;font-weight:600;color:var(--product-tone);border-top:1px solid var(--product-line);padding-top:15px;margin-top:auto}
  .product-related-grid>a:hover{border-color:var(--product-tone)}
  @media(max-width:1000px){.product-detail{gap:4%}.product-image-frame{padding:20px}.product-facts{padding:22px}.product-visit-notes{gap:5%}}
  @media(max-width:720px){.product-heading{padding-top:8px;padding-bottom:27px}.product-heading h1{font-size:clamp(2.4rem,8.8vw,3.2rem)}.product-detail{grid-template-columns:minmax(0,1fr);gap:35px;padding-bottom:40px}.product-summary{gap:24px}.product-thumbs button{width:60px}.product-contact-panel .button{width:100%;padding-inline:15px}.product-detail .main-product-image{max-height:450px}.product-visit-notes{grid-template-columns:minmax(0,1fr);gap:24px;padding-block:33px 42px}.product-notes-opening{position:relative;padding-right:105px;min-height:110px}.product-notes-opening h2,.product-related-heading h2{font-size:2.3rem}.product-notes-opening img{position:absolute;right:0;top:6px;width:92px;height:92px;margin:0}.product-related{padding-bottom:44px}.product-related-grid{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:380px){.product-facts dl>div{grid-template-columns:minmax(0,1fr);gap:5px}.product-facts{padding:20px}.product-image-frame{padding:15px}.product-notes-opening{padding-right:0;min-height:0}.product-notes-opening img{display:none}.product-visit-notes li{gap:13px}.product-related-grid>a{padding:22px}}
</style>
