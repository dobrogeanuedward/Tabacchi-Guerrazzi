---
import Base from '../layouts/Base.astro';import HeroSlider from './HeroSlider.astro';import Icon from './Icon.astro';import {shop,text,pathFor,type Lang} from '../data/shop';import {articles,clusters} from '../data/articles';
import BrandSignature from './BrandSignature.astro';import AssortmentNav from './AssortmentNav.astro';import LuggageCallout from './LuggageCallout.astro';
const {lang='it'}=Astro.props as {lang:Lang};

---
<Base lang={lang} image="/images/hero/portico.webp" title={text(lang,'Tabaccheria Guerrazzi di Angela a Bologna','Tabaccheria Guerrazzi di Angela in Bologna')} description={text(lang,'Giochi, idee regalo e servizi in Via Guerrazzi 10/F a Bologna. Scopri il negozio di Angela e prepara la tua visita.','Games, gift ideas and services at Via Guerrazzi 10/F in Bologna. Get to know Angela’s shop and plan your visit.')}>
<HeroSlider lang={lang}/>
<div class="welcome-line"><span>{text(lang,'La tua tabaccheria in Via Guerrazzi.','Your local shop on Via Guerrazzi.')}</span><a href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come raggiungerci','How to find us')}</a></div>
<nav class="home-essentials wrap" aria-label={text(lang,'Informazioni utili','Useful information')}><a href={pathFor('catalogo',lang)}><span class="eyebrow">{text(lang,'Da cercare','Browse')}</span><strong>{text(lang,'Catalogo e categorie','Catalogue and categories')} ↗</strong></a><a href={pathFor('servizi',lang)}><span class="eyebrow">{text(lang,'Da fare','Get things done')}</span><strong>{text(lang,'I servizi al banco','Counter services')} ↗</strong></a><a href={pathFor('deposito-bagagli',lang)}><span class="eyebrow">{text(lang,'In visita a Bologna','Visiting Bologna')}</span><strong>{text(lang,'Deposito bagagli Bounce','Bounce luggage storage')} ↗</strong></a><a href={pathFor('contatti',lang)}><span class="eyebrow">{text(lang,'Prima di passare','Plan your visit')}</span><strong>{text(lang,'Indirizzo e contatti','Address and contact')} ↗</strong></a></nav>
<div class="wrap home-luggage"><LuggageCallout lang={lang}/></div>
<section class="discover wrap"><div class="section-opening"><h2>{text(lang,'Cosa ti porta qui?','What brings you here?')}</h2><p>{text(lang,'Un pensiero da scegliere, una sorpresa da portare a casa.','A thoughtful gift to choose. A little surprise to take home.')}</p></div><div class="discover-grid"><a class="discovery gift" href={pathFor('idee-regalo',lang)}><img src="/images/gifts.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Un piccolo regalo confezionato con cura','A thoughtfully wrapped small gift')}/><div><span class="card-kind">{text(lang,'Da Guerrazzi','At Guerrazzi')}</span><h3>{text(lang,'Idee regalo','Gift ideas')}</h3><p>{text(lang,'Ci ho pensato. Ti ho pensato.','A little thought. Just for you.')}</p><span class="card-open">{text(lang,'Esplora la sezione','Explore this section')} <span aria-hidden="true">→</span></span></div></a><a class="discovery games" href={pathFor('giochi-e-giocattoli',lang)}><img src="/images/games.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Dettagli di giochi in legno colorati','Colourful wooden toy details')}/><div><span class="card-kind">{text(lang,'Da Guerrazzi','At Guerrazzi')}</span><h3>{text(lang,'Giochi e giocattoli','Games and toys')}</h3><p>{text(lang,'La meraviglia si impara giocando.','Wonder begins with play.')}</p><span class="card-open">{text(lang,'Esplora la sezione','Explore this section')} <span aria-hidden="true">→</span></span></div></a><a class="discovery service" href={pathFor('servizi',lang)}><img src="/images/services.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Un momento al banco per un servizio quotidiano','An everyday service at a shop counter')}/><div><span class="card-kind">{text(lang,'Da Guerrazzi','At Guerrazzi')}</span><h3>{text(lang,'Servizi quotidiani','Everyday services')}</h3><p>{text(lang,'Una sosta. Una cosa fatta.','One stop. One thing sorted.')}</p><span class="card-open">{text(lang,'Esplora la sezione','Explore this section')} <span aria-hidden="true">→</span></span></div></a></div></section>
<section class="angela-block"><div class="angela-image"><img src="/images/incontro.webp" width="1122" height="1402" loading="lazy" alt={text(lang,'Angela consegna un gioco alla bambina','Angela hands a toy to a child')}/></div><div class="angela-copy"><h2>{text(lang,'Qui trovi Angela.','Meet Angela.')}</h2><p>{text(lang,'Hai un’idea o cerchi un consiglio? Raccontalo ad Angela. Per un regalo, un gioco o una piccola necessità, si parte sempre da una chiacchierata.','Have an idea or need some advice? Talk to Angela. Whether it’s a gift, a toy or an everyday essential, it starts with a conversation.')}</p><BrandSignature lang={lang} personal light/><a class="button light" href={pathFor('il-negozio',lang)}>{text(lang,'Conosci il negozio','Get to know the shop')}</a></div></section>

<div class="wrap"><AssortmentNav lang={lang}/></div>
<section class="journal-preview wrap"><div class="section-opening"><h2>{text(lang,'Il diario di Guerrazzi.','The Guerrazzi journal.')}</h2><a class="text-link" href="/approfondimenti/">{text(lang,'Leggi il diario','Read the journal (Italian)')}</a></div><div class="journal-list">{articles.filter((_,i)=>[0,3,6].includes(i)).map(a=><a href={`/approfondimenti/${a.slug}/`}><span class="card-kind">{text(lang,'Articolo','Article in Italian')} · {clusters.find(c=>c.id===a.cluster)?.label}</span><h3>{a.title}</h3><p>{a.summary}</p><span class="article-open">{text(lang,'Leggi l’articolo','Read the article')} →</span></a>)}</div></section>
<section class="visit-panel wrap"><BrandSignature lang={lang}/><img class="visit-art" src="/brand/ui/portico-ink.webp" srcset="/brand/ui/portico-ink-480.webp 480w, /brand/ui/portico-ink.webp 960w, /brand/ui/portico-ink-1536.webp 1536w" sizes="(max-width: 680px) 100vw, 620px" width="960" height="480" alt="" loading="lazy" aria-hidden="true"/><p>{shop.address}, Bologna</p><h2>{text(lang,'La prossima volta che passi, fermati.','Next time you pass by, stop in.')}</h2><a class="button primary" href={shop.maps} target="_blank" rel="noopener"><Icon name="location"/>{text(lang,'Portami da Guerrazzi','Take me to Guerrazzi')}</a></section>
</Base>
