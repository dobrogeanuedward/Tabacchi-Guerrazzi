---
import Base from '../layouts/Base.astro';import Story from './Story.astro';import {shop,text,pathFor,type Lang} from '../data/shop';import {articles,clusters} from '../data/articles';
const {lang='it'}=Astro.props as {lang:Lang};
const video=import.meta.env.PUBLIC_HERO_VIDEO;
---
<Base lang={lang} title={text(lang,'Tabaccheria Guerrazzi di Angela a Bologna','Tabaccheria Guerrazzi di Angela in Bologna')} description={text(lang,'Giochi, idee regalo e servizi in Via Guerrazzi 10/F a Bologna. Scopri il negozio di Angela e prepara la tua visita.','Games, gift ideas and services at Via Guerrazzi 10/F in Bologna. Get to know Angela’s shop and plan your visit.')}>
<section class="home-hero"><div class="hero-copy"><p class="location-label">{shop.address} <span>Bologna</span></p><h1>{text(lang,'Un luogo.','One place.')}<br/>{text(lang,'Molte piccole','Many little')}<br/>{text(lang,'scoperte.','discoveries.')}</h1><p class="hero-description">{text(lang,'Un gioco da scegliere. Un pensiero da regalare. Le cose di ogni giorno, con l’attenzione di Angela.','A toy to choose. A thoughtful gift. Everyday essentials, with Angela’s care.')}</p><div class="hero-buttons"><a class="button primary" href={pathFor('il-negozio',lang)}>{text(lang,'Entra da Guerrazzi','Discover Guerrazzi')}</a><a class="button quiet" href={pathFor('catalogo',lang)}>{text(lang,'Guarda il catalogo','Browse the catalogue')}</a></div></div><div class="hero-photo">{video?<video data-hero muted autoplay loop playsinline controls poster="/images/scelta.webp"><source src={video} type="video/mp4"/></video>:<img src="/images/scelta.webp" alt={text(lang,'Una famiglia si ferma davanti alla vetrina di Guerrazzi','A family stops at the Guerrazzi shop window')} width="1122" height="1402" fetchpriority="high"/>}<div class="photo-note">{text(lang,'Ci sono momenti che iniziano da una vetrina.','Some moments begin at a shop window.')}</div></div></section>
<div class="welcome-line"><span>{text(lang,'La tua tabaccheria in Via Guerrazzi.','Your local shop on Via Guerrazzi.')}</span><a href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come raggiungerci','How to find us')}</a></div>
<section class="discover wrap"><div class="section-opening"><h2>{text(lang,'Cosa ti porta qui?','What brings you here?')}</h2><p>{text(lang,'Scegli un percorso. Al resto pensiamo insieme.','Choose a starting point. We will take it from there together.')}</p></div><div class="discover-grid"><a class="discovery gift" href={pathFor('idee-regalo',lang)}><img src="/images/gifts.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Un piccolo regalo confezionato con cura','A thoughtfully wrapped small gift')}/><div><h3>{text(lang,'Un pensiero per qualcuno.','A thought for someone.')}</h3><p>{text(lang,'Idee regalo','Gift ideas')}</p></div></a><a class="discovery games" href={pathFor('giochi-e-giocattoli',lang)}><img src="/images/games.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Dettagli di giochi in legno colorati','Colourful wooden toy details')}/><div><h3>{text(lang,'Il piacere di giocare.','The joy of play.')}</h3><p>{text(lang,'Giochi e giocattoli','Games and toys')}</p></div></a><a class="discovery service" href={pathFor('servizi',lang)}><img src="/images/services.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Un momento al banco per un servizio quotidiano','An everyday service at a shop counter')}/><div><h3>{text(lang,'Una cosa da fare.','An errand to run.')}</h3><p>{text(lang,'Servizi quotidiani','Everyday services')}</p></div></a></div></section>
<section class="angela-block"><div class="angela-image"><img src="/images/incontro.webp" width="1122" height="1402" loading="lazy" alt={text(lang,'Angela consegna un gioco alla bambina','Angela hands a toy to a child')}/></div><div class="angela-copy"><h2>{text(lang,'Un negozio si riconosce dalle persone.','You recognise a shop by its people.')}</h2><p>{text(lang,'Angela è il nome nella firma e la persona dietro il banco. L’attenzione è nelle piccole cose: ascoltare, capire, accompagnare una scelta.','Angela is the name in the signature and the person behind the counter. Care is in the little things: listening, understanding and helping someone choose.')}</p><a class="button light" href={pathFor('il-negozio',lang)}>{text(lang,'Conosci il negozio','Get to know the shop')}</a></div></section>
<Story lang={lang}/>
<section class="journal-preview wrap"><div class="section-opening"><h2>{text(lang,'Due minuti, un’idea in più.','Two minutes, one more idea.')}</h2><a class="text-link" href="/approfondimenti/">{text(lang,'Leggi il diario','Read the journal (Italian)')}</a></div><div class="journal-list">{articles.filter((a,i)=>[0,3,6].includes(i)).map(a=><a href={`/approfondimenti/${a.slug}/`}><span>{clusters.find(c=>c.id===a.cluster)?.label}</span><h3>{a.title}</h3><p>{a.summary}</p></a>)}</div></section>
<section class="visit-panel wrap"><p>{shop.address}, Bologna</p><h2>{text(lang,'La prossima volta che passi, fermati.','Next time you pass by, stop in.')}</h2><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Portami da Guerrazzi','Take me to Guerrazzi')}</a></section>
</Base>
