---
import {story,type Lang,text,pathFor} from '../data/shop';
const {lang='it',mode='encounters'}=Astro.props as {lang:Lang;mode?:'encounters'|'place'};
---
{mode==='place'?<section class="place-story wrap" aria-labelledby="place-story-title"><div class="place-story-heading"><p class="section-label">{text(lang,'Strada e identità','Street and identity')}</p><h2 id="place-story-title">{text(lang,'Un nome che appartiene alla strada.','A name that belongs to its street.')}</h2><p>{text(lang,'Via Guerrazzi è il riferimento che lega il nome, la vetrina e la visita. Due letture dello stesso luogo, attraverso i materiali dell’identità.','Via Guerrazzi connects the name, the shop window and your visit. Two readings of the same place, through the materials of the identity.')}</p></div><div class="place-story-grid"><figure class="place-day"><div class="place-image"><img src="/brand/ui/portico-ink.webp" width="960" height="480" alt="" aria-hidden="true" loading="lazy"/></div><figcaption><span>01</span><div><h3>{text(lang,'Il ritmo del portico.','The rhythm of the portico.')}</h3><p>{text(lang,'Una linea continua di archi e la carta color avorio: il luogo diventa un segno grafico.','A continuous line of arches and ivory paper: the place becomes a graphic mark.')}</p></div></figcaption></figure><figure class="place-night"><div class="place-image"><p aria-hidden="true">Guerrazzi<span>Bologna / 10·F</span></p></div><figcaption><span>02</span><div><h3>{text(lang,'Il colore della sera.','The colour of evening.')}</h3><p>{text(lang,'Il blu profondo del tema serale accompagna il racconto delle serrande. È uno studio materico, non una fotografia del negozio.','The evening theme’s deep blue accompanies the story of the shutters. It is a material study, not a photograph of the shop.')}</p></div></figcaption></figure></div><a class="text-link" href={pathFor('contatti',lang)}>{text(lang,'Ritrova il negozio in Via Guerrazzi','Find the shop on Via Guerrazzi')} <span aria-hidden="true">→</span></a></section>:<section class="story-section wrap"><div class="section-opening"><div><p class="section-label">{text(lang,'La vetrina · tre momenti','The shop window · three moments')}</p><h2>{text(lang,'Le cose belle cominciano con poco.','Good things start small.')}</h2></div><p>{text(lang,'Uno sguardo alla vetrina. Una domanda. Angela che porta il gioco giusto.','A glance at the window. A question. Angela bringing over the right toy.')}</p></div><div class="story-grid">{story.map((s,i)=><figure><div class="story-image"><img src={s.src} width="1122" height="1402" loading="lazy" alt={lang==='it'?s.altIt:s.altEn}/></div><figcaption><span class="story-number">0{i+1}</span><p>{lang==='it'?s.it:s.en}</p></figcaption></figure>)}</div><p class="story-note">{text(lang,'Sequenza editoriale generata. Le immagini del luogo e delle persone saranno sostituite con fotografie reali verificate.','Generated editorial sequence. Images of the place and people will be replaced with verified real photographs.')}</p></section>}
<style>
 .story-section .section-opening>div{max-width:740px}.story-section .section-label{margin-bottom:16px}.story-note{margin-top:30px;padding-top:20px;border-top:1px solid var(--line);font:.95rem/1.75 var(--sans);color:#566176;max-width:78ch}
 .place-story{padding-block:55px 70px;color:#253957}.place-story-heading{display:grid;grid-template-columns:1fr 1fr;gap:16px 55px;align-items:end;margin-bottom:32px}.place-story-heading .section-label{grid-column:1/-1;color:#385379;margin:0}.place-story h2{font:400 clamp(2.2rem,3.3vw,3.4rem)/1.13 var(--display);color:#243d65;max-width:23ch;letter-spacing:-.03em}.place-story-heading>p:last-child{font:400 1rem/1.85 var(--sans);color:#42516a;max-width:60ch}.place-story-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}.place-story figure{min-width:0;margin:0}.place-image{aspect-ratio:1.5;display:grid;place-items:center;overflow:hidden;background:linear-gradient(#f4e8d5b9,#f4e8d5b9),url('/images/materials/terracotta-768.webp') center/cover;border:1px solid #cba787}.place-image>img{width:85%;height:80%;object-fit:contain;mix-blend-mode:multiply}.place-night .place-image{background:linear-gradient(#12213d99,#12213d99),url('/images/materials/night-768.webp') center/cover;border-color:#293b54}.place-night .place-image>p{font:400 clamp(2.6rem,4.7vw,5.2rem)/1 var(--display);letter-spacing:-.035em;color:#e4d8bb;text-align:center}.place-night .place-image>p>span{display:block;font:400 1rem/1.7 var(--sans);letter-spacing:.1em;margin-top:25px;color:#cfdbef}.place-story figcaption{display:grid;grid-template-columns:45px 1fr;gap:18px;padding-top:22px;border-top:1px solid var(--line);margin-top:20px}.place-story figcaption>span{font:400 2rem/1 var(--display);color:#526889}.place-story h3{font:400 1.9rem/1.2 var(--display);color:#243d65;margin-bottom:12px}.place-story figcaption p{font:.95rem/1.85 var(--sans);color:#42516a;max-width:53ch}.place-story>.text-link{margin-top:30px;font-size:.95rem}
 @media(max-width:680px){.place-story-heading,.place-story-grid{grid-template-columns:minmax(0,1fr);gap:22px}.place-story{padding-block:40px 50px}.place-story-grid{gap:35px}.place-night .place-image>p{font-size:3.3rem}.place-story h2{font-size:2.45rem}.place-story figcaption{grid-template-columns:35px 1fr;gap:14px}.story-section .section-opening h2{font-size:2.6rem}}
</style>
