---
import {commonsPhotographs} from '../data/commons-photography';
import {text,type Lang} from '../data/shop';
interface Props {id:string;lang?:Lang;loading?:'lazy'|'eager';compact?:boolean;}
const {id,lang='it',loading='lazy',compact=false}=Astro.props;
const photo=commonsPhotographs[id];const l=lang==='it'?0:1;
---
<figure class:list={['commons-photo',compact&&'commons-photo--compact']} data-commons-photo={id}>
 <div class="commons-photo-frame"><img src={photo.path} srcset={`${photo.preview} ${photo.previewWidth}w, ${photo.path} ${photo.width}w`} sizes={compact?'(max-width: 620px) calc(100vw - 44px), (max-width: 1000px) 44vw, 340px':'(max-width: 760px) calc(100vw - 44px), 580px'} width={photo.width} height={photo.height} alt={photo.alt[l]} loading={loading} decoding="async" fetchpriority={loading==='eager'?'high':undefined}/></div>
 <figcaption>
  <p class="commons-caption">{photo.caption[l]}</p>
  <p class="commons-credit">{photo.authorUrl?<a href={photo.authorUrl}>{photo.author}</a>:<span>{photo.author}</span>} · <a href={photo.licenseUrl} rel="license">{photo.license}</a> · <a href={photo.sourcePage}>Wikimedia Commons</a></p>
  {!compact&&<details><summary>{text(lang,'La fotografia','About the photograph')}</summary><p><a href={photo.sourcePage}>{photo.fileTitle}</a></p><p>{photo.changes[l]}</p></details>}
 </figcaption>
</figure>
<style>
 .commons-photo{margin:0;min-width:0;color:#493928}
 .commons-photo-frame{display:flex;align-items:center;justify-content:center;min-width:0;aspect-ratio:4/3;background:#eee8dc;border:1px solid #d0c4b4;overflow:hidden}
 .commons-photo-frame img{display:block;max-width:100%;max-height:500px;width:100%;height:100%;aspect-ratio:4/3;object-fit:contain}
 .commons-photo figcaption{margin-top:14px}
 .commons-photo figcaption p{margin:0;line-height:1.65}
 .commons-caption{font-size:.95rem}
 .commons-photo .commons-credit{font-size:.78rem;line-height:1.8;margin-top:8px;color:#6b5b49}
 .commons-credit a,.commons-photo details a{text-decoration:underline;text-underline-offset:3px;color:inherit;overflow-wrap:anywhere}
 .commons-photo details{border-top:1px solid #d0c4b4;margin-top:12px}
 .commons-photo details summary{min-height:44px;align-content:center;font-size:.85rem;cursor:pointer}
 .commons-photo details p{font-size:.85rem;margin:0 0 10px}
 .commons-photo a:focus-visible,.commons-photo summary:focus-visible{outline:2px solid var(--blue);outline-offset:4px}
 .commons-photo--compact .commons-photo-frame{aspect-ratio:3/2}
 .commons-photo--compact .commons-photo-frame img{aspect-ratio:3/2;max-height:250px}
 .commons-photo--compact .commons-caption{font-size:.8rem;color:#6b5b49}
 @media(max-width:620px){.commons-photo-frame img{max-height:400px}.commons-photo--compact .commons-photo-frame img{max-height:300px}}
</style>
