---
import type {HTMLAttributes} from 'astro/types';
import AiDisclosure from './AiDisclosure.astro';
import PhotoBrand from './PhotoBrand.astro';
import {photoMetadataFor} from '../data/fototeca';
import {isGeneratedImage,imageDisclosure} from '../data/generated-images.mjs';
type Props = HTMLAttributes<'img'> & {lang?:'it'|'en';dynamicDisclosure?:boolean};
const {lang='it',dynamicDisclosure=false,...attributes}=Astro.props;
const generated=isGeneratedImage(attributes.src);
const photograph=photoMetadataFor(attributes.src);
---
{generated||dynamicDisclosure||photograph?<span class="disclosed-image" data-ai-visual><img {...attributes} data-ai-generated={generated?'true':undefined}/>{photograph&&<PhotoBrand corner={photograph.corner}/>}<AiDisclosure lang={lang} message={imageDisclosure(lang,attributes.src||'')} hidden={!generated}/></span>:<img {...attributes}/>}
