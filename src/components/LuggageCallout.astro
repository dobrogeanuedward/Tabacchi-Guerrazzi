---
import DisclosedImage from './DisclosedImage.astro';
import {pathFor,text,type Lang} from '../data/shop';
import {bounceUrl} from '../data/assortment';
import BounceBrand from './BounceBrand.astro';
const {lang='it'}=Astro.props as {lang:Lang};
---
<aside class="luggage-feature" aria-label={text(lang,'Deposito bagagli Bounce a Bologna','Bounce luggage storage in Bologna')}>
 <div class="luggage-feature-photo"><DisclosedImage lang={lang} src="/images/hero/viaggiatrice-960.webp" srcset="/images/hero/viaggiatrice-960.webp 960w, /images/hero/viaggiatrice.webp 1672w" sizes="(max-width: 800px) 100vw, 48vw" width="1672" height="940" loading="lazy" alt={text(lang,'una viaggiatrice con la valigia davanti alla vetrina di Guerrazzi','a traveller with a suitcase at the Guerrazzi shop window')}/><span>Bologna · Via Guerrazzi 10/F</span></div>
 <div class="luggage-feature-copy"><BounceBrand lang={lang}/><p class="eyebrow">{text(lang,'Deposito bagagli Bounce · Bologna','Bounce luggage storage · Bologna')}</p><h2>{text(lang,'Più Bologna.','More Bologna.')}<br/><em>{text(lang,'Meno bagagli.','Less baggage.')}</em></h2><p>{text(lang,'Il check-out è già fatto, la giornata no. Lascia la valigia da Guerrazzi e riparti a piedi: una piazza, un portico, una sosta in più.','You’ve checked out. The day is still yours. Leave your suitcase at Guerrazzi and set off on foot: another square, another portico, another stop.')}</p><p class="luggage-location">{text(lang,'Deposito bagagli in Via Guerrazzi 10/F, nel centro storico. Su Bounce ci trovi come “Palazzo Ercolani”.','Luggage storage at Via Guerrazzi 10/F, in the historic centre. Find us on Bounce as “Palazzo Ercolani”.')}</p><div class="luggage-actions"><a class="button primary" href={bounceUrl} target="_blank" rel="noopener">{text(lang,'Prenota su Bounce','Book on Bounce')}</a><a class="text-link" href={pathFor('deposito-bagagli',lang)}>{text(lang,'Come funziona','How it works')}</a></div><p class="luggage-terms">{text(lang,'Disponibilità, prezzo e orari aggiornati nella scheda Bounce.','See the Bounce listing for current availability, prices and hours.')}</p></div>
</aside>
<style>
.luggage-feature{display:grid;grid-template-columns:1fr 1fr;background:#e7eef9;margin:35px 0 65px;overflow:hidden;border-radius:3px 80px 3px 3px}.luggage-feature-photo{position:relative;min-height:540px}.luggage-feature-photo img{width:100%;height:100%;position:absolute;object-fit:cover;object-position:65% center}.luggage-feature-photo>span{position:absolute;bottom:25px;left:25px;background:#f8f8f3ed;padding:9px 15px;font-size:.95rem}.luggage-feature-copy{padding:55px 48px;align-self:center}.luggage-feature-copy .eyebrow{font:600 1.1rem/1.5 var(--sans);letter-spacing:0}.luggage-feature h2{font-size:clamp(2.8rem,3.8vw,4.3rem);color:var(--blue);margin:20px 0 25px;line-height:1.03}.luggage-feature h2 em{font-weight:400}.luggage-feature-copy>p:not(.eyebrow){margin-bottom:22px}.luggage-location{font-size:1rem}.luggage-actions{display:flex;gap:22px;align-items:center;flex-wrap:wrap}.luggage-feature-copy .luggage-terms{font-size:.95rem;color:#46556c;margin:20px 0 0}
@media(max-width:1100px){.luggage-feature-copy{padding:40px 30px}.luggage-feature-photo{min-height:560px}}
@media(max-width:800px){.luggage-feature{grid-template-columns:1fr;border-radius:3px 55px 3px 3px}.luggage-feature-photo{min-height:0;aspect-ratio:1.35}.luggage-feature-copy{padding:35px 25px 40px}.luggage-feature h2{font-size:clamp(2.7rem,9vw,3.4rem)}.luggage-feature-photo img{object-position:70% center}}
</style>
