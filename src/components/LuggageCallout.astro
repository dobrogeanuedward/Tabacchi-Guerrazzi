---
import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};
---
<aside class="luggage-callout" aria-label={text(lang,'Deposito bagagli Bounce','Bounce luggage storage')}>
 <img src="/brand/ui/luggage-ink-600.webp" srcset="/brand/ui/luggage-ink-320.webp 320w, /brand/ui/luggage-ink-600.webp 600w" sizes="(max-width: 680px) 90px, 220px" width="600" height="627" loading="lazy" alt="" aria-hidden="true"/>
 <div><p class="luggage-label">Bounce · Via Guerrazzi 10/F</p><h2>{text(lang,'Le valigie si fermano. Tu continui.','Your bags stop here. You keep going.')}</h2><p>{text(lang,'Deposito bagagli tramite Bounce, per visitare Bologna con le mani libere. Prenotazione e condizioni sulla piattaforma.','Luggage storage through Bounce, so you can explore Bologna hands-free. Bookings and terms are on the platform.')}</p><a class="button primary" href={pathFor('deposito-bagagli',lang)}>{text(lang,'Organizza il deposito','Plan your bag drop')}</a></div>
</aside>
