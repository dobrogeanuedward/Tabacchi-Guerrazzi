---
import DisclosedImage from './DisclosedImage.astro';
import {catalogAssortment} from '../data/catalog-assortment';
import {catalogPhotoFor} from '../data/catalog-photography';
import {pathFor,text,type Lang} from '../data/shop';
const {slug,sections,lang='it'}=Astro.props as {slug:string;sections:string[][][];lang:Lang};
const l=lang==='it'?0:1;
const families=catalogAssortment.filter(item=>item.page===slug);
const storyImages:Record<string,(string|null)[]>={
 'idee-regalo':['mappamondi','giochi','calamite','buste'],
 'giochi-e-giocattoli':['costruzioni-lego','bambole-disney','giochi-magnetici',null],
 cartoleria:['quaderni','penne-perle','colle'],
 'souvenir-bologna':['calamite','calamite-ricette','matite-tortellino'],
 'feste-e-compleanni':['auguri','palloncini'],
 dolciumi:['gommose','cioccolatini'],
 'sale-di-cervia':['salina-cervia',null],
 'profumi-raptus':['profumi-raptus',null],
 'piccole-necessita':['pile-batterie','adesivi','guanti-spontex','capelli'],
 'accessori-telefono':['cavi','power-bank',null],
};
---
<div class="category-stories">
 {sections.map((section,i)=>{
  const chosen=storyImages[slug];const family=chosen?catalogAssortment.find(item=>item.id===chosen[i]):families[i];const photo=family?catalogPhotoFor(family.id):null;
  return <section class:list={['category-story',photo&&'has-photograph']}>
   <div class="category-story-copy"><h2>{section[0][l]}</h2><p>{section[1][l]}</p>{family&&<a class="text-link" href={pathFor(`assortimento/${family.id}`,lang)}>{text(lang,'Nella scheda: ','In the record: ')}{family.name[l]}</a>}</div>
   {family&&photo&&<figure><DisclosedImage lang={lang} src={photo.src} srcset={photo.srcset} sizes="(max-width:720px) 90vw, 480px" width={photo.width} height={photo.height} alt={photo.alt?.[l]||family.name[l]} loading="lazy"/><figcaption>{family.name[l]}</figcaption></figure>}
  </section>
 })}
</div>
<style>
.category-story{padding-block:36px;border-top:1px solid var(--line)}.category-story.has-photograph{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);align-items:center;gap:7%}.category-story-copy{min-width:0}.category-story h2{font:400 clamp(2rem,3vw,2.8rem)/1.16 var(--display);color:var(--accent);max-width:23ch;margin-bottom:20px}.category-story p{font-size:1rem;line-height:1.9;max-width:66ch}.category-story .text-link{margin-top:20px}.category-story figure{margin:0;min-width:0}.category-story img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.category-story figcaption{font-size:.9rem;line-height:1.7;color:var(--muted);padding-top:12px}.category-story:nth-child(even).has-photograph>.category-story-copy{order:2}.category-story:nth-child(even).has-photograph>figure{order:1}@media(max-width:720px){.category-story.has-photograph{grid-template-columns:1fr;gap:24px}.category-story:nth-child(even).has-photograph>.category-story-copy{order:0}.category-story:nth-child(even).has-photograph>figure{order:0}.category-story{padding-block:28px}}
</style>
