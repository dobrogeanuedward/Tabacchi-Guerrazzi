---
import Base from '../layouts/Base.astro';import DisclosedImage from './DisclosedImage.astro';import {serviceIdentities} from '../data/service-identities';import {pathFor,text,shop,type Lang} from '../data/shop';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const service=serviceIdentities.find(s=>s.slug===slug)!;const l=lang==='it'?0:1;
const location={'@type':'Store',name:shop.name,address:{'@type':'PostalAddress',streetAddress:shop.address,postalCode:shop.postcode,addressLocality:shop.city,addressCountry:'IT'}};
const schema=[...(service.provider?[{'@context':'https://schema.org','@type':'Service',name:service.title[l],description:service.intro[l],serviceType:service.title[l],provider:{'@type':'Organization',name:service.provider.name,url:service.provider.url},broker:location,areaServed:{'@type':'City',name:shop.city},availableChannel:{'@type':'ServiceChannel',serviceLocation:location}}]:[]),...(service.faqs?.length?[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:service.faqs.map(faq=>({'@type':'Question',name:faq.question[l],acceptedAnswer:{'@type':'Answer',text:faq.answer[l]}}))}]:[])];
---
<Base title={`${service.title[l]} ${text(lang,'a Bologna','in Bologna')}`} description={service.intro[l]} lang={lang} slug={`servizi/${slug}`} schema={schema}>
<nav class="breadcrumb wrap"><a href={pathFor('servizi',lang)}>{text(lang,'Servizi','Services')}</a><span>/</span><span>{service.title[l]}</span></nav>
<article class="service-page wrap"><header><div class="service-logos">{service.logos.map(logo=><img src={`/brand/partners/${logo.file}`} width={logo.width||160} height={logo.height||45} alt={logo.name}/>)}</div><p class="section-label">Via Guerrazzi 10/F · Bologna</p><h1>{service.title[l]}</h1><p class="intro">{service.intro[l]}</p></header>{service.sections.map(section=><section><h2>{section.title[l]}</h2><p>{section.text[l]}</p></section>)}
{slug==='self-service'&&<DisclosedImage lang={lang} class="dispenser-location" src="/images/collection/esterno-portico.webp" width="1440" height="960" alt={text(lang,'Ingresso e distributore sotto il portico','Entrance and dispenser under the portico')}/>}
{service.faqs?.length&&<section class="service-faq"><h2>{text(lang,'Domande sulle ricariche Postepay','Postepay top-up questions')}</h2><div>{service.faqs.map(faq=><details><summary>{faq.question[l]}</summary><p>{faq.answer[l]}</p></details>)}</div></section>}
{service.related?.length&&<nav class="service-related" aria-label={text(lang,'Organizza il passaggio','Plan your visit')}>{service.related.map(link=><a class="text-link" href={pathFor(link.slug,lang)}>{link.label[l]}</a>)}</nav>}
{service.sources.length>0&&<section class="service-sources"><h2>{text(lang,'Informazioni ufficiali','Official information')}</h2>{service.sources.map(source=><a href={source.url} target="_blank" rel="noopener">{source.label}</a>)}</section>}
<footer><p>{shop.name}<br/>{shop.address}, {shop.postcode} {shop.city}</p><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come arrivare','Directions')}</a><a class="text-link" href={pathFor('servizi',lang)}>{text(lang,'Tutti i servizi','All services')}</a></footer></article></Base>
<style>
.service-page{max-width:920px;padding-bottom:60px}.service-page header{max-width:760px;padding-block:25px 40px}.service-page h1{font:400 clamp(2.7rem,5vw,4.4rem)/1.1 var(--display);color:var(--blue);margin-block:22px}.service-logos{display:flex;flex-wrap:wrap;gap:30px;align-items:center;margin-bottom:35px}.service-logos img{height:auto;max-width:160px;max-height:45px;object-fit:contain}.service-page .intro{font-size:1.1rem;line-height:1.9}.service-page>section{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:25px 45px;padding-block:30px;border-top:1px solid var(--line)}.service-page h2{font:400 2rem/1.2 var(--display);color:var(--blue)}.service-page>section p{font-size:1rem;line-height:1.9}.service-faq details{padding-block:15px;border-bottom:1px solid var(--line)}.service-faq summary{cursor:pointer;color:var(--blue);font-weight:600;line-height:1.7}.service-faq details p{margin-top:12px}.service-related{display:flex;flex-wrap:wrap;gap:18px 28px;padding-block:15px 35px}.service-page .service-sources{display:flex;flex-direction:column;gap:18px}.service-sources a{text-decoration:underline;text-underline-offset:4px;line-height:1.8}.service-page footer{border-top:1px solid var(--line);padding-top:30px;display:flex;flex-wrap:wrap;align-items:center;gap:24px}.service-page footer p{margin-right:auto;font-size:.95rem;line-height:1.85}.service-page :global(.dispenser-location){width:100%;height:auto;margin-block:20px 35px}@media(max-width:680px){.service-page>section{grid-template-columns:1fr}.service-page footer{align-items:flex-start;flex-direction:column}}
</style>
