---
import PhotoGallery from './PhotoGallery.astro';
import {categoryPhotosFor} from '../data/fototeca';
import Base from '../layouts/Base.astro';import DisclosedImage from './DisclosedImage.astro';import NeighborhoodLinks from './NeighborhoodLinks.astro';import {serviceIdentities} from '../data/service-identities';import {pathFor,text,shop,type Lang} from '../data/shop';import {getSiteOrigin} from '../lib/site-origin.mjs';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const service=serviceIdentities.find(s=>s.slug===slug)!;const l=lang==='it'?0:1;
const origin=getSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const photographs=slug==='self-service'?[]:categoryPhotosFor(`servizi/${slug}`);
const absolute=(path:string)=>origin?new URL(path,origin).href:path;
const hours=shop.hours.map(h=>({'@type':'OpeningHoursSpecification',dayOfWeek:h.days,opens:h.opens,closes:h.closes}));
const location={'@type':'Store',...(origin?{'@id':new URL('/#store',origin).href}:{}),name:shop.name,address:{'@type':'PostalAddress',streetAddress:shop.address,postalCode:shop.postcode,addressLocality:shop.city,addressCountry:'IT'},...(shop.phone?{telephone:shop.phone}:{}),hasMap:shop.maps,openingHoursSpecification:hours};
const schema=[{'@context':'https://schema.org','@type':'Service',...(origin?{'@id':`${absolute(pathFor(`servizi/${slug}`,lang))}#service`,url:absolute(pathFor(`servizi/${slug}`,lang))}:{}),name:service.title[l],description:service.intro[l],serviceType:(service.serviceType||service.title)[l],provider:service.provider?{'@type':'Organization',name:service.provider.name,url:service.provider.url}:location,...(service.provider?{broker:location}:{}),brand:service.logos.map(logo=>({'@type':'Brand',name:logo.name,logo:{'@type':'ImageObject',url:absolute(`/brand/partners/${logo.file}`)}})),areaServed:{'@type':'City',name:shop.city},availableChannel:{'@type':'ServiceChannel',serviceLocation:location,...(shop.phone?{servicePhone:{'@type':'ContactPoint',telephone:shop.phone}}:{})},hoursAvailable:service.hours==='always'?[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'00:00',closes:'23:59'}]:hours},...(service.faqs?.length?[{'@context':'https://schema.org','@type':'FAQPage',inLanguage:lang,mainEntity:service.faqs.map(faq=>({'@type':'Question',name:faq.question[l],acceptedAnswer:{'@type':'Answer',text:faq.answer[l]}}))}]:[])];
---
<Base title={service.seoTitle?.[l]||`${service.title[l]} ${text(lang,'a Bologna','in Bologna')}`} description={service.intro[l]} image={photographs[0]?.src||(service.logos[0]?`/brand/partners/${service.logos[0].file}`:'/brand/guerrazzi-logo.webp')} lang={lang} slug={`servizi/${slug}`} schema={schema}>
<nav class="breadcrumb wrap"><a href={pathFor('servizi',lang)}>{text(lang,'Servizi','Services')}</a><span>/</span><span>{service.title[l]}</span></nav>
<article class="service-page wrap"><header>{service.logos.length>0&&<div class="service-logos">{service.logos.map(logo=><img class={logo.name==='pagoPA'?'official-logo--pagopa':undefined} src={`/brand/partners/${logo.file}`} width={logo.width||160} height={logo.height||45} alt={logo.name}/>)}</div>}<p class="section-label">Via Guerrazzi 10/F · Bologna</p><h1>{service.title[l]} {text(lang,'a Bologna','in Bologna')}</h1><p class="intro">{service.intro[l]}</p><div class="service-actions"><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come arrivare','Directions')}</a>{shop.phone&&<a class="text-link" href={`tel:${shop.phone.replace(/\s/g,'')}`}>{text(lang,'Chiama il negozio','Call the shop')}</a>}</div>{service.preparation?.length&&<div class="service-preparation"><h2>{text(lang,'Da avere con te','Have it ready')}</h2><ul>{service.preparation.map(item=><li>{item[l]}</li>)}</ul></div>}</header>{service.sections.map(section=><section><h2>{section.title[l]}</h2><p>{section.text[l]}</p></section>)}
{slug==='self-service'&&<DisclosedImage lang={lang} class="dispenser-location" src="/images/collection/esterno-portico.webp" width="1440" height="960" alt={text(lang,'Ingresso e distributore sotto il portico','Entrance and dispenser under the portico')}/>}
{photographs.length>0&&<div class="service-photographs"><PhotoGallery photos={photographs} lang={lang}/></div>}
{service.faqs?.length&&<section class="service-faq"><h2>{text(lang,'Domande sul servizio','Service questions')}</h2><div>{service.faqs.map(faq=><details><summary>{faq.question[l]}</summary><p>{faq.answer[l]}</p></details>)}</div></section>}
{service.related?.length&&<nav class="service-related" aria-label={text(lang,'Organizza il passaggio','Plan your visit')}>{service.related.map(link=><a class="text-link" href={pathFor(link.slug,lang)}>{link.label[l]}</a>)}</nav>}
{service.sources.length>0&&<section class="service-sources"><h2>{text(lang,'Informazioni ufficiali','Official information')}</h2>{service.sources.map(source=><a href={source.url} target="_blank" rel="noopener">{source.label}</a>)}</section>}
<section class="service-location" aria-labelledby="service-location-title"><div><p class="section-label">{text(lang,'Il tuo punto in centro','Your stop in the city centre')}</p><h2 id="service-location-title">{text(lang,'Da Angela, in Via Guerrazzi.','At Angela’s, on Via Guerrazzi.')}</h2><address>{shop.name}<br/>{shop.address}<br/>{shop.postcode} {shop.city}</address>{shop.phone&&<a class="text-link" href={`tel:${shop.phone.replace(/\s/g,'')}`}>{shop.phone}</a>}</div><div><h3>{service.hours==='always'?text(lang,'Il distributore esterno','The outdoor dispenser'):text(lang,'Gli orari del banco','Counter opening hours')}</h3>{service.hours==='always'?<p>{text(lang,'Il distributore è self-service h24. Per parlare con Angela, fare una ricarica Postepay o lasciare i bagagli, consulta gli orari del banco e della tua prenotazione.','The dispenser is self-service 24 hours. To speak with Angela, top up Postepay or leave luggage, check counter hours and your booking times.')}</p>:<><dl>{shop.hours.map(h=><div><dt>{lang==='it'?h.day:h.dayEn}</dt><dd>{h.hours}</dd></div>)}</dl><p class="hours-note">{text(lang,'Per festivi e variazioni controlla il profilo Google o telefona prima di una visita dedicata.','For holidays and changes, check the Google profile or call before making a special trip.')}</p></>}<a class="text-link" href={pathFor('contatti',lang)}>{text(lang,'Orari e contatti','Opening hours and contact')}</a></div></section>
<footer><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Apri le indicazioni','Open directions')}</a><a class="text-link" href={pathFor('servizi',lang)}>{text(lang,'Tutti i servizi','All services')}</a></footer></article><div class="wrap"><NeighborhoodLinks topic={`servizi/${slug}`} lang={lang}/></div></Base>
<style>
.service-photographs{margin-block:10px 40px;max-width:760px}
.service-logos img.official-logo--pagopa{background:var(--blue);padding:8px 12px;box-sizing:content-box}
.service-page h1{overflow-wrap:break-word}.service-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:26px}.service-preparation{margin-top:32px;border-left:3px solid var(--blue);background:var(--surface);padding:24px}.service-page .service-preparation h2{font-size:1.45rem;margin-bottom:16px}.service-preparation ul{padding-left:20px;display:grid;gap:10px}.service-preparation li{font-size:.95rem;line-height:1.75}.service-page>.service-location{grid-template-columns:repeat(2,minmax(0,1fr));background:var(--surface);padding:28px;margin:35px 0}.service-location h2{font-size:2rem;margin-block:15px 22px}.service-location address{font-style:normal;font-size:.95rem;line-height:1.85}.service-location h3{font:400 1.65rem/1.2 var(--display);color:var(--blue);margin:8px 0 22px}.service-location dl>div{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;margin-bottom:12px;line-height:1.7;font-size:.95rem}.service-location dd{font-weight:600}.service-location .text-link{margin-top:18px}.service-page .service-location .hours-note{font-size:.85rem;line-height:1.75;margin-top:18px}@media(max-width:680px){.service-page>.service-location{grid-template-columns:1fr;gap:28px;padding:22px}.service-preparation{padding:20px}}
.service-page{max-width:920px;padding-bottom:60px}.service-page header{max-width:760px;padding-block:25px 40px}.service-page h1{font:400 clamp(2.7rem,5vw,4.4rem)/1.1 var(--display);color:var(--blue);margin-block:22px}.service-logos{display:flex;flex-wrap:wrap;gap:30px;align-items:center;margin-bottom:35px}.service-logos img{height:auto;max-width:160px;max-height:45px;object-fit:contain}.service-page .intro{font-size:1.1rem;line-height:1.9}.service-page>section{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:25px 45px;padding-block:30px;border-top:1px solid var(--line)}.service-page h2{font:400 2rem/1.2 var(--display);color:var(--blue)}.service-page>section p{font-size:1rem;line-height:1.9}.service-faq details{padding-block:15px;border-bottom:1px solid var(--line)}.service-faq summary{cursor:pointer;color:var(--blue);font-weight:600;line-height:1.7}.service-faq details p{margin-top:12px}.service-related{display:flex;flex-wrap:wrap;gap:18px 28px;padding-block:15px 35px}.service-page .service-sources{display:flex;flex-direction:column;gap:18px}.service-sources a{text-decoration:underline;text-underline-offset:4px;line-height:1.8}.service-page footer{border-top:1px solid var(--line);padding-top:30px;display:flex;flex-wrap:wrap;align-items:center;gap:24px}.service-page footer p{margin-right:auto;font-size:.95rem;line-height:1.85}.service-page :global(.dispenser-location){width:100%;height:auto;margin-block:20px 35px}@media(max-width:680px){.service-page>section{grid-template-columns:1fr}.service-page footer{align-items:flex-start;flex-direction:column}}
</style>
