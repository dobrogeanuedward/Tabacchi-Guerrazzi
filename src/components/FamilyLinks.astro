---
import {catalogAssortment} from '../data/catalog-assortment';import {pathFor,text,type Lang} from '../data/shop';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const families=catalogAssortment.filter(p=>p.page===slug);const l=lang==='it'?0:1;
---
{families.length>0&&<section class="family-links"><p class="eyebrow">{text(lang,'Le schede di Guerrazzi','Guerrazzi records')}</p><h2>{text(lang,'Parti da un oggetto.','Start with an item.')}</h2><div>{families.map(p=><a href={pathFor(`assortimento/${p.id}`,lang)}><h3>{p.name[l]}</h3><p>{p.description[l]}</p><span>{text(lang,'Apri la scheda','Read the record')} ↗</span></a>)}</div></section>}
<style>.family-links{padding:2rem 0 3rem}.family-links h2{font-size:clamp(2.6rem,4vw,3.6rem);color:var(--blue);margin:1rem 0 1.5rem}.family-links>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.family-links a{padding:1.5rem;background:#edf2fc;border-radius:0 30px 0 0;display:flex;flex-direction:column;align-items:flex-start}.family-links h3{font-size:1.8rem;color:var(--blue);margin-bottom:1rem}.family-links a p{font-size:.9rem;line-height:1.7;margin-bottom:1.3rem}.family-links a span{font-size:.8rem;color:var(--blue);margin-top:auto}@media(max-width:960px){.family-links>div{grid-template-columns:1fr 1fr}}@media(max-width:680px){.family-links>div{grid-template-columns:1fr}.family-links a{padding:1.3rem}.family-links h3{font-size:1.9rem}}</style>
