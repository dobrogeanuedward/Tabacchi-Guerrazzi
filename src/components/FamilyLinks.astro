---
import DisclosedImage from './DisclosedImage.astro';
import {catalogAssortment,catalogGroups} from '../data/catalog-assortment';import {pathFor,text,type Lang} from '../data/shop';import {catalogPhotoFor} from '../data/catalog-photography';
import {catalogProducts} from '../data/catalog-products.mjs';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const families=catalogAssortment.filter(p=>p.page===slug);const l=lang==='it'?0:1;
const products=catalogProducts.filter(p=>families.some(family=>family.category===p.category));
const categoryLabel=(id:string)=>{const group=catalogGroups.find(g=>g.id===id);return group?(lang==='it'?group.it:group.en):''};
---
{families.length>0&&<section class="family-links" aria-labelledby="family-links-title">
 <header class="family-links-heading"><p class="family-section-label">{text(lang,'Articoli e famiglie','Items and families')}</p><h2 id="family-links-title">{text(lang,'Esplora le schede.','Explore the records.')}</h2><p>{text(lang,'Trova l’articolo che ti serve e scopri cosa confrontare in negozio.','Find the item you need and discover what to compare in store.')}</p></header>
 <div class="family-link-grid">
 {products.map(p=><article class="family-link-card"><DisclosedImage lang={lang} class="family-card-photo" src={p.image} width="1440" height="960" alt={lang==='it'?p.imageAltIt:p.imageAltEn} loading="lazy"/><div class="family-card-top"><p class="family-card-label"><span>{text(lang,'Prodotto','Product')}</span>{categoryLabel(p.category)}</p></div><h3><a class="family-card-link" href={pathFor(`catalogo/${p.slug}`,lang)}>{lang==='it'?p.nameIt:p.nameEn}</a></h3><p class="family-card-description">{text(lang,'Un piccolo tocco di colore per il cavo di ricarica. Selezionato e distribuito da AkenA.','A little touch of colour for your charging cable. Selected and distributed by AkenA.')}</p><span class="family-link-action">{text(lang,'Apri scheda','Open record')}</span></article>)}
 {families.map(p=><article class="family-link-card">
  <DisclosedImage lang={lang} class="family-card-photo" src={catalogPhotoFor(p.id).src} srcset={catalogPhotoFor(p.id).srcset} sizes="(max-width: 680px) calc(100vw - 90px), (max-width: 1080px) 40vw, 350px" width="1440" height="960" alt={p.name[l]} loading="lazy"/>
  <div class="family-card-top"><p class="family-card-label"><span>{text(lang,'Famiglia','Family')}</span>{categoryLabel(p.category)}</p></div>
  <h3><a class="family-card-link" href={pathFor(`assortimento/${p.id}`,lang)}>{p.name[l]}</a></h3><p class="family-card-description">{p.description[l]}</p>
  <span class="family-link-action">{text(lang,'Apri scheda','Open record')}</span>
 </article>)}</div>
</section>}
<style>
 .family-links{--family-line:color-mix(in srgb,var(--accent) 25%,#e7dfd0);padding:32px;margin:38px 0 48px;border:1px solid var(--family-line);border-radius:3px;background:linear-gradient(#f6f1e7f2,#f6f1e7f2),url('/images/materials/paper.webp') center/cover}
 .family-links-heading{max-width:760px;margin-bottom:26px}
 .family-section-label{font-family:var(--sans);font-size:.95rem;line-height:1.6;letter-spacing:.035em;font-weight:600;color:var(--accent);margin-bottom:12px}
 .family-links h2{font-family:var(--display);font-size:clamp(2rem,3.1vw,2.8rem);line-height:1.12;letter-spacing:-.03em;color:var(--accent);margin:0 0 16px}
 .family-links-heading>p:last-child{font-size:.95rem;line-height:1.8;max-width:64ch;color:#42516a}
 .family-link-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
 .family-link-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;min-width:0;padding:25px;border:1px solid var(--family-line);border-radius:3px;background:#fffefa;color:#263950;box-shadow:0 3px 0 #0645c005;transition:transform .2s,border-color .2s,box-shadow .2s}
 .family-links .family-card-label{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:.95rem;line-height:1.6;font-weight:600;color:#4a5669;margin:0 0 18px}
 .family-card-label>span{background:var(--surface);color:var(--accent);padding:4px 7px;border-radius:2px}
 .family-links h3{font-family:var(--display);font-size:clamp(1.5rem,2vw,1.8rem);line-height:1.2;letter-spacing:-.025em;overflow-wrap:break-word;color:var(--accent);margin:0 0 15px}
 .family-card-description{font-size:.95rem;line-height:1.8;color:#42516a;margin:0 0 24px}
 .family-link-action{display:flex;justify-content:space-between;align-items:center;width:100%;gap:20px;padding-top:17px;border-top:1px solid var(--family-line);font-family:var(--sans);font-size:.95rem;line-height:1.6;font-weight:600;color:var(--accent);margin-top:auto}
 .family-link-action>span{font-size:1.25rem;line-height:1;transition:transform .2s}
 .family-link-card:hover{border-color:#0645c078;box-shadow:0 7px 20px #0645c00a;transform:translateY(-2px)}
 .family-link-card:hover .family-link-action>span{transform:translateX(4px)}
 .family-card-link::after{content:'';position:absolute;inset:0;z-index:1}.family-card-link:focus-visible{outline:0}.family-link-card:focus-within{outline:3px solid var(--blue);outline-offset:4px;border-color:var(--accent)}
 @media(max-width:1080px){.family-link-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:680px){.family-links{padding:22px;margin-block:30px 38px}.family-link-grid{grid-template-columns:minmax(0,1fr);gap:17px}.family-link-card{padding:22px}.family-links h3{font-size:1.75rem}}
 @media(max-width:360px){.family-links{padding:17px}.family-link-card{padding:19px}}
 @media(prefers-reduced-motion:reduce){.family-link-card,.family-link-action>span{transition:none}.family-link-card:hover,.family-link-card:hover .family-link-action>span{transform:none}}
 .family-card-photo{width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:21px;border-radius:2px}.family-card-top{width:100%;margin-bottom:18px}.family-card-top .family-card-label{margin:0}.family-links{border-top:3px solid var(--accent)}
</style>
