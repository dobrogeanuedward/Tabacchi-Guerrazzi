---
import DisclosedImage from './DisclosedImage.astro';
import {octoberCollection} from '../data/collection-october';import {catalogPhotoFor} from '../data/catalog-photography';import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};const l=lang==='it'?0:1;const picks=['salvadanai-nani','matite-tortellino','modellini-auto','costruzioni-lego','calamite-ricette','salina-cervia'].map(id=>octoberCollection.find(item=>item.id===id)!);
---
<section class="shop-discoveries wrap" aria-labelledby="discoveries-title"><header><div><p class="section-label">{text(lang,'Fra una commissione e una scoperta','Between an errand and a discovery')}</p><h2 id="discoveries-title">{text(lang,'Le piccole cose, da vicino.','Little things, up close.')}</h2></div><a class="text-link" href={pathFor('catalogo',lang)}>{text(lang,'Esplora il catalogo','Explore the catalogue')}</a></header><div class="discovery-grid">{picks.map(item=><a href={pathFor(`assortimento/${item.id}`,lang)}><DisclosedImage lang={lang} src={catalogPhotoFor(item.id).src} srcset={catalogPhotoFor(item.id).srcset} sizes="(max-width:680px) 90vw,420px" width="1440" height="960" alt={item.name[l]} loading="lazy"/><div>{item.brand&&<p class="discovery-brand">{item.brand}</p>}<h3>{item.name[l]}</h3><p>{item.description[l]}</p><span>{text(lang,'Guarda la scheda','Open the listing')}</span></div></a>)}</div><nav class="discovery-brand-links" aria-label={text(lang,'I brand della bottega','The shop’s brands')}>{[['LEGO','lego'],['Bburago','bburago'],['Clementoni','clementoni'],['Ricola','ricola'],['Salina di Cervia','salina-di-cervia']].map(([name,slug])=><a href={pathFor(`marchi/${slug}`,lang)}>{name}</a>)}<a href={pathFor('marchi-e-competenze',lang)}>{text(lang,'Tutti i brand','All brands')}</a></nav></section>
<style>
.shop-discoveries{padding-block:55px 65px;border-top:1px solid var(--line)}.shop-discoveries>header{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:35px}.shop-discoveries h2{font:400 clamp(2.5rem,4vw,3.7rem)/1.12 var(--display);color:var(--accent);max-width:20ch}.shop-discoveries>header>.text-link{flex-shrink:0}.discovery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.discovery-grid>a{display:flex;flex-direction:column;border:1px solid var(--line);background:#fffdfa}.discovery-grid img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.discovery-grid>a>div{padding:24px;display:flex;flex-direction:column;flex:1}.discovery-brand{font-size:.8rem;font-weight:600;color:var(--accent);margin-bottom:12px}.discovery-grid h3{font:400 1.9rem/1.18 var(--display);color:var(--accent);margin-bottom:16px}.discovery-grid p:not(.discovery-brand){font-size:.95rem;line-height:1.85;margin-bottom:22px}.discovery-grid a>div>span{font-size:.9rem;font-weight:600;color:var(--accent);margin-top:auto;padding-top:16px;border-top:1px solid var(--line)}.discovery-brand-links{display:flex;flex-wrap:wrap;gap:12px 25px;padding-top:30px}.discovery-brand-links a{min-height:44px;display:inline-flex;align-items:center;font-weight:600;font-size:.95rem;color:var(--accent);border-bottom:1px solid var(--line)}@media(max-width:960px){.discovery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.shop-discoveries>header{display:block}.shop-discoveries>header>.text-link{margin-top:22px}.discovery-grid{grid-template-columns:1fr}.shop-discoveries{padding-block:35px 45px}}
</style>
