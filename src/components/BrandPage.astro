---
import DisclosedImage from './DisclosedImage.astro';
import {getSiteOrigin} from '../lib/site-origin.mjs';
import Base from '../layouts/Base.astro';
import {catalogueBrands} from '../data/brand-catalogue';
import {catalogPhotoFor} from '../data/catalog-photography';
import {shop,pathFor,text,type Lang} from '../data/shop';
import BrandSignature from './BrandSignature.astro';
import {familyDetails} from '../data/family-details';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const brand=catalogueBrands.find(b=>b.slug===slug)!;const l=lang==='it'?0:1;
const image=catalogPhotoFor(brand.items[0].id);
const title=text(lang,`${brand.name} a Bologna, da Angela`,`${brand.name} in Bologna, at Angela’s`);
const origin=getSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const url=new URL(pathFor(`marchi/${slug}`,lang),origin).href;
const schema={'@context':'https://schema.org','@type':'CollectionPage','@id':`${url}#collection`,url,name:title,description:brand.note[l],inLanguage:lang,isPartOf:{'@id':new URL('/#website',origin).href},about:{'@type':'Brand',name:brand.name},mainEntity:{'@type':'ItemList',itemListElement:brand.items.map((item,i)=>({'@type':'ListItem',position:i+1,name:item.name[l],url:new URL(pathFor(`assortimento/${item.id}`,lang),origin).href}))}};
---
<Base slug={`marchi/${slug}`} lang={lang} title={title} description={`${brand.note[l]} ${shop.address}, Bologna.`} image={image.src} schema={schema}>
 <nav class="breadcrumb wrap"><a href={pathFor('marchi-e-competenze',lang)}>{text(lang,'I brand della bottega','The shop’s brands')}</a><span>/</span><span>{brand.name}</span></nav>
 <section class="brand-hero wrap"><div><p class="section-label">{text(lang,'Guerrazzi · Bologna','Guerrazzi · Bologna')}</p><h1>{brand.name}</h1><p class="brand-location">{text(lang,'In Via Guerrazzi, da Angela.','On Via Guerrazzi, at Angela’s.')}</p><p>{brand.note[l]}</p><a class="text-link" href="#brand-listings">{text(lang,'Guarda gli articoli','Explore the items')}</a></div><DisclosedImage lang={lang} src={image.src} srcset={image.srcset} sizes="(max-width:720px) 100vw,50vw" width="1440" height="960" alt={brand.items[0].name[l]} fetchpriority="high"/></section>
 <section id="brand-listings" class="brand-listings wrap"><header><p class="section-label">{text(lang,'Nel catalogo','In the catalogue')}</p><h2>{text(lang,`${brand.name}, da vicino.`,`${brand.name}, up close.`)}</h2></header><div class="brand-item-grid">{brand.items.map(item=><article><DisclosedImage lang={lang} src={catalogPhotoFor(item.id).src} srcset={catalogPhotoFor(item.id).srcset} sizes="(max-width:680px) 90vw,420px" width="1440" height="960" loading="lazy" alt={item.name[l]}/><div><h3><a class="brand-card-link" href={pathFor(`assortimento/${item.id}`,lang)}>{item.name[l]}</a></h3><p>{item.description[l]}</p><span class="text-link">{text(lang,'Apri la scheda','Open the listing')}</span></div></article>)}</div></section>
 <section class="brand-choice wrap"><h2>{text(lang,'Dal nome al prodotto giusto.','From a name to the right item.')}</h2><div>{brand.items.slice(0,3).map(item=><section><h3>{item.name[l]}</h3><p>{familyDetails[item.id].answer[l]}</p><ul>{familyDetails[item.id].checks[l].map(check=><li>{check}</li>)}</ul><a class="text-link" href={pathFor(`assortimento/${item.id}`,lang)}>{text(lang,'Leggi descrizione e dettagli','Read the description and details')}</a></section>)}</div></section>
 <section class="brand-visit wrap"><BrandSignature lang={lang}/><div><h2>{text(lang,'Un nome, un indirizzo.','A name, an address.')}</h2><p>{text(lang,`${brand.name} da Guerrazzi, ${shop.address}, Bologna. Siamo nel centro storico, fra Santo Stefano e Strada Maggiore. Per una variante precisa porta il nome o una foto della confezione.`,`${brand.name} at Guerrazzi, ${shop.address}, Bologna. We are in the historic centre, between Santo Stefano and Strada Maggiore. Bring the name or a photo of the packaging for a specific variant.`)}</p><a class="button quiet" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come arrivare','Directions')}</a></div></section>
</Base>
<style>
.brand-choice{padding-block:35px 55px;border-top:1px solid var(--line)}.brand-choice>h2{font:400 clamp(2rem,3vw,3rem)/1.2 var(--display);color:var(--accent);margin-bottom:30px}.brand-choice>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:35px}.brand-choice h3{font:400 1.8rem/1.25 var(--display);margin-bottom:18px;color:var(--accent)}.brand-choice p,.brand-choice li{font-size:1rem;line-height:1.85}.brand-choice ul{padding-left:22px;margin-block:20px}.brand-choice .text-link{margin-top:12px}

.brand-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6%;align-items:center;padding-block:30px 65px}.brand-hero h1{font:400 clamp(3rem,6vw,5.8rem)/1.05 var(--display);color:var(--accent);overflow-wrap:anywhere}.brand-location{font-size:1.25rem;margin-block:22px 16px}.brand-hero p:not(.section-label){line-height:1.85;max-width:55ch}.brand-hero .text-link{margin-top:24px}.brand-hero img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:2px 35px 2px 2px}.brand-listings{padding-block:40px 60px;border-top:1px solid var(--line);scroll-margin-top:30px}.brand-listings header{margin-bottom:28px}.brand-listings h2,.brand-visit h2{font:400 clamp(2rem,3vw,3rem)/1.2 var(--display);color:var(--accent)}.brand-item-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.brand-item-grid>article{position:relative;border:1px solid var(--line);background:#fffdfa}.brand-item-grid img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.brand-item-grid>article>div{padding:24px}.brand-card-link::after{content:'';position:absolute;inset:0;z-index:1}.brand-card-link:focus-visible{outline:0}.brand-item-grid>article:focus-within{outline:3px solid var(--blue);outline-offset:4px}.brand-item-grid h3{font:400 1.9rem/1.18 var(--display);color:var(--accent);margin-bottom:16px}.brand-item-grid p{font-size:.95rem;line-height:1.85}.brand-item-grid .text-link{margin-top:22px}.brand-visit{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:45px;padding-block:40px 65px;border-top:1px solid var(--line)}.brand-visit p{max-width:65ch;margin-block:20px;line-height:1.85}@media(max-width:960px){.brand-item-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.brand-hero,.brand-visit{grid-template-columns:1fr;gap:28px}.brand-hero{padding-block:20px 40px}.brand-item-grid{grid-template-columns:1fr}.brand-hero h1{font-size:3.7rem}}
</style>
