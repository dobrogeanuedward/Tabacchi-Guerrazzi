---
import Base from '../layouts/Base.astro';import Icon from './Icon.astro';import ChoiceNotes from './ChoiceNotes.astro';import Story from './Story.astro';import {shop,mainPages,pathFor,text,type Lang} from '../data/shop';import {pages,guides} from '../data/pages';import {articles,clusters} from '../data/articles';
import AssortmentNav from './AssortmentNav.astro';import LuggageCallout from './LuggageCallout.astro';import {bounceUrl} from '../data/assortment';
import EditorialPhoto from './EditorialPhoto.astro';import CategoryPathways from './CategoryPathways.astro';import {articleCategoryLinks} from '../data/articles';
import OfficialSources from './OfficialSources.astro';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const p=pages[slug];const l=lang==='it'?0:1;
const navLabel=(s:string)=>{const entry=mainPages.find(p=>p.slug===s);return entry?(lang==='it'?entry.it:entry.en):pages[s].title[l]};
const related=articles.filter(a=>clusters.find(c=>c.id===a.cluster)?.parent===slug||(articleCategoryLinks[a.slug]||[]).includes(slug));
const infoOnly=['sigari','pipe-e-tabacchi-da-pipa'].includes(slug);
const faqs=p.faqs||[];const schema=faqs.length?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map((f:any)=>({'@type':'Question',name:f[l===0?0:2],acceptedAnswer:{'@type':'Answer',text:f[l===0?1:3]}}))}:null;
---
<Base title={(p.seoTitle||p.title)[l]} description={p.intro[l]} slug={slug} lang={lang} theme={p.theme} image={p.photo?`/images/editorial/${p.photo}-desktop.webp`:p.image||'/images/scelta.webp'} schema={slug==='deposito-bagagli'?[schema,{'@context':'https://schema.org','@type':'Service',name:text(lang,'Deposito bagagli tramite Bounce','Luggage storage through Bounce'),serviceType:'Luggage storage',provider:{'@type':'Store',name:shop.name,address:{'@type':'PostalAddress',streetAddress:shop.address,postalCode:shop.postcode,addressLocality:shop.city,addressCountry:'IT'}},areaServed:'Bologna',url:bounceUrl}]:schema}>
<div class="breadcrumb wrap"><a href={pathFor('',lang)}>Home</a><span>/</span><span>{navLabel(slug)}</span></div>
{p.art?<section class="assortment-hero wrap"><div><p class="category-name">{p.label[l]}</p><h1>{p.title[l]}</h1><p>{p.intro[l]}</p>{slug==='deposito-bagagli'&&<div class="booking-start"><a class="button primary" href={bounceUrl} target="_blank" rel="noopener">{text(lang,'Prenota su Bounce','Book on Bounce')}</a><p>{text(lang,'La scheda si chiama “Palazzo Ercolani”. Controlla data, orari e condizioni prima di confermare.','The listing is named “Palazzo Ercolani”. Check your date, hours and terms before confirming.')}</p></div>}</div><img class="assortment-art" src={`/brand/ui/${p.art}.webp`} srcset={`/brand/ui/${p.art}-320.webp 320w, /brand/ui/${p.art}-600.webp 600w, /brand/ui/${p.art}.webp 960w`} sizes="(max-width: 680px) 65vw, (max-width: 960px) 35vw, 520px" width="960" height="960" alt="" aria-hidden="true" fetchpriority="high"/></section>:
<section class:list={['page-hero',p.image?'wrap':'no-photo']}><div><h1>{p.title[l]}</h1><p>{p.intro[l]}</p></div>{p.image&&<img src={p.image} width="1122" height="1402" alt={p.image==='/images/regalo.webp'?text(lang,'La bambina riceve un gioco dalle mani di Angela','The child receives a toy from Angela'):p.image==='/images/scelta.webp'?text(lang,'Una famiglia si ferma davanti alla vetrina di Guerrazzi','A family stops at the Guerrazzi shop window'):text(lang,'Angela consegna un gioco alla bambina davanti alla vetrina','Angela hands a toy to the child at the shop window')} fetchpriority="high"/>}</section>
}
<section class="page-content wrap">
 <CategoryPathways slug={slug} lang={lang}/>
 {p.sources&&<OfficialSources sources={p.sources} lang={lang}/>}
 {slug==='deposito-bagagli'&&<section class="booking-steps" aria-labelledby="booking-title"><h2 id="booking-title">{text(lang,'Dalla prenotazione al ritiro.','From booking to pickup.')}</h2><ol><li><h3>{text(lang,'Scegli data e bagagli','Choose your date and bags')}</h3><p>{text(lang,'Apri la scheda Bounce e controlla disponibilità, prezzo e orari per la tua visita.','Open the Bounce listing and check availability, prices and hours for your visit.')}</p></li><li><h3>{text(lang,'Porta la conferma','Bring your confirmation')}</h3><p>{text(lang,'Raggiungi Via Guerrazzi 10/F e mostra la conferma di prenotazione al momento del deposito.','Come to Via Guerrazzi 10/F and show your booking confirmation at drop-off.')}</p></li><li><h3>{text(lang,'Torna per il ritiro','Return for pickup')}</h3><p>{text(lang,'Rispetta l’orario di ritiro scelto. Per modifiche o assistenza alla prenotazione, usa Bounce.','Keep to your selected pickup time. Use Bounce for booking changes or support.')}</p></li></ol></section>}
 {slug==='contatti'?<div class="contact-block"><div class="contact-details"><h2>{text(lang,'L’indirizzo','Our address')}</h2><address>{shop.address}<br/>{shop.postcode} {shop.city}</address>{shop.phone&&<a class="text-link" href={`tel:${shop.phone}`}>{shop.phone}</a>}{shop.email&&<a class="text-link" href={`mailto:${shop.email}`}>{shop.email}</a>}{shop.hours.length>0?<><h2>{text(lang,'Orari','Opening hours')}</h2><dl>{shop.hours.map(h=><div><dt>{h.day}</dt><dd>{h.hours}</dd></div>)}</dl></>:<p>{text(lang,'Per organizzare la visita, verifica gli orari aggiornati sul profilo del negozio.','To plan your visit, check the latest hours on the shop profile.')}</p>}<a class="text-link" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Consulta il profilo su Google Maps','Check our Google Maps profile')}</a></div><div class="map-panel"><h2>Guerrazzi<br/>10/F.</h2><p>{text(lang,'Imposta il punto di partenza e scegli il percorso con la tua app di mappe.','Set your starting point and choose a route in your maps app.')}</p><a class="button light" href={shop.maps} target="_blank" rel="noopener"><Icon name="location"/>{text(lang,'Apri le indicazioni','Open directions')}</a></div></div>:['idee-regalo','giochi-e-giocattoli'].includes(slug)?<ChoiceNotes kind={slug==='idee-regalo'?'gift':'play'} lang={lang}/>:<div class="content-columns">{p.sections.map((s:any)=><div><h2>{s[0][l]}</h2><p>{s[1][l]}</p></div>)}</div>}
 {p.links&&<div class="guides-links">{p.links.map((s:string)=><a class="guide-link" href={pathFor(`schede/${s}`,lang)}><h3>{guides[s].title[l]}</h3><p>{text(lang,'Leggi le informazioni','Read the guide')}</p></a>)}</div>}
 {['idee-regalo','giochi-e-giocattoli'].includes(slug)&&<div class="category-banner"><img src={slug==='idee-regalo'?'/images/gifts.webp':'/images/games.webp'} width="1536" height="1024" loading="lazy" alt={text(lang,'Una composizione fotografica dedicata alla scelta','An editorial photograph about choosing')}/><div><h2>{text(lang,'Una prima idea, prima di passare.','A first idea before you visit.')}</h2><a class="button primary" href={`${pathFor('catalogo',lang)}?categoria=${slug==='idee-regalo'?'regali':'giochi'}`}>{text(lang,'Sfoglia il catalogo','Browse the catalogue')}</a></div></div>}
 {slug==='recensioni'&&<div class="review-section">{shop.reviews.length?shop.reviews.map(r=><blockquote><p>{r.body}</p><footer>{r.name} <time>{r.date}</time><a href={r.sourceUrl} target="_blank" rel="noopener">{text(lang,'Leggi la fonte','Read the source')}</a></footer></blockquote>):<div class="empty-note"><h2>{text(lang,'Le esperienze, alla fonte.','Experiences, at the source.')}</h2><p>{text(lang,'Consulta le recensioni sul profilo Google del negozio e racconta la tua esperienza.','Read reviews on the shop’s Google profile and share your experience.')}</p><a class="text-link" href={shop.reviewUrl||shop.maps} target="_blank" rel="noopener">{text(lang,'Apri il profilo Google','Open the Google profile')}</a></div>}</div>}
 {['idee-regalo','giochi-e-giocattoli'].includes(slug)&&<div class="content-columns category-details">{p.sections.map((s:any)=><div><h2>{s[0][l]}</h2><p>{s[1][l]}</p></div>)}</div>}
 {p.groups?.length>0&&<div class="range-detail">{p.photo&&<EditorialPhoto name={p.photo} alt={p.photoAlt[l]} lang={lang}/>}<div class="range-groups"><h2>{text(lang,'Uno sguardo all’assortimento.','A look at the range.')}</h2>{p.groups.map((g:any)=><div><h3>{g.title[l]}</h3><ul>{g.items.map((item:any)=><li>{item[l]}</li>)}</ul></div>)}{p.brands?.length>0&&<div class="brand-reference"><h3>{text(lang,'Nomi sugli scaffali','Names on the shelves')}</h3><p>{p.brands.join(', ')}.</p><p class="range-note">{text(lang,'Marchi identificati nelle foto di riferimento del negozio; modelli e disponibilità si verificano al banco.','Brands identified in the shop reference photographs; check models and availability at the counter.')}</p></div>}</div></div>}
 {['il-negozio','idee-regalo'].includes(slug)&&<section class="editorial-feature"><EditorialPhoto name={slug==='il-negozio'?'bottega':'regali'} alt={slug==='il-negozio'?text(lang,'Ricostruzione editoriale delle vetrine bianche e in legno del negozio','Editorial reconstruction of the shop’s white and wooden display cabinets'):text(lang,'Composizione editoriale di piccole candele e portachiavi ispirata alla vetrina','Editorial composition of small candles and keyrings inspired by the display')} lang={lang} wide/></section>}
 {slug==='piccole-necessita'&&<section class="editorial-feature"><EditorialPhoto name="cura" alt={text(lang,'Ricreazione editoriale della vetrina di cura personale con accessori per capelli','Editorial recreation of the personal-care cabinet with hair accessories')} lang={lang} wide/></section>}
 {slug==='servizi'&&<LuggageCallout lang={lang}/>}
 {['il-negozio','servizi'].includes(slug)&&<AssortmentNav lang={lang} slugs={slug==='servizi'?['ricevitoria','accessori-telefono','piccole-necessita']:null}/>}
 {p.related?.length>0&&<section class="related-categories"><h2>{text(lang,'Può servirti anche.','You might also need.')}</h2><div>{p.related.map((s:string)=><a href={pathFor(s,lang)}>{navLabel(s)}<span aria-hidden="true">↗</span></a>)}</div></section>}
 {faqs.length>0&&<div class="faq"><h2>{text(lang,'Prima di passare.','Before your visit.')}</h2>{faqs.map((f:any)=><details><summary>{f[l===0?0:2]}</summary><p>{f[l===0?1:3]}</p></details>)}</div>}
</section>
{['giochi-e-giocattoli','il-negozio','storia-e-serrande'].includes(slug)&&<Story lang={lang}/>}
{related.length>0&&<section class="journal-preview wrap"><div class="section-opening"><h2>{text(lang,'Qualche idea da portare con te.','A few ideas to take with you.')}</h2></div><div class="journal-list">{related.map(a=><a href={`/approfondimenti/${a.slug}/`}><h3>{a.title}</h3><p>{a.summary}</p>{lang==='en'&&<span>Italian article</span>}</a>)}</div></section>}
<section class="visit-panel wrap"><img class="visit-art" src="/brand/ui/portico-ink.webp" srcset="/brand/ui/portico-ink-480.webp 480w, /brand/ui/portico-ink.webp 960w, /brand/ui/portico-ink-1536.webp 1536w" sizes="(max-width: 680px) 100vw, 620px" width="960" height="480" alt="" loading="lazy" aria-hidden="true"/><p>{shop.address}, Bologna</p><h2>{infoOnly?text(lang,'Un indirizzo, un riferimento.','An address, a reference.'):text(lang,'La scelta continua in negozio.','Continue your visit in store.')}</h2><a class="button primary" href={shop.maps} target="_blank" rel="noopener"><Icon name="location"/>{infoOnly?text(lang,'Apri le indicazioni','Open directions'):text(lang,'Vieni da Guerrazzi','Visit Guerrazzi')}</a></section>
</Base>
