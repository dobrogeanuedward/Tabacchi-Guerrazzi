---
import NeighborhoodLinks from './NeighborhoodLinks.astro';
import CigarBrandStories from './CigarBrandStories.astro';
import Base from '../layouts/Base.astro';import BounceBrand from './BounceBrand.astro';import Icon from './Icon.astro';import ChoiceNotes from './ChoiceNotes.astro';import Story from './Story.astro';import {shop,mainPages,pathFor,text,type Lang} from '../data/shop';import {pages,guides} from '../data/pages';import {articles,clusters} from '../data/articles';
import AssortmentNav from './AssortmentNav.astro';import LuggageCallout from './LuggageCallout.astro';import {bounceUrl} from '../data/assortment';
import EditorialPhoto from './EditorialPhoto.astro';import CategoryPathways from './CategoryPathways.astro';import {articleCategoryLinks} from '../data/articles';
import OfficialSources from './OfficialSources.astro';import CigarRecords from './CigarRecords.astro';import BrandSignature from './BrandSignature.astro';import FamilyLinks from './FamilyLinks.astro';
import {catalogAssortment} from '../data/catalog-assortment';
import EducationalHero from './EducationalHero.astro';import MaterialAtlas from './MaterialAtlas.astro';
import PageOpening from './PageOpening.astro';import BrandDirectory from './BrandDirectory.astro';import ServiceDesk from './ServiceDesk.astro';
import VisualStudy from './VisualStudy.astro';import type {VisualStudyId} from '../data/visual-studies';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const p=pages[slug];const l=lang==='it'?0:1;
const navLabel=(s:string)=>{const entry=mainPages.find(p=>p.slug===s);return entry?(lang==='it'?entry.it:entry.en):pages[s].title[l]};
const related=articles.filter(a=>clusters.find(c=>c.id===a.cluster)?.parent===slug||(articleCategoryLinks[a.slug]||[]).includes(slug));
const infoOnly=['sigari','pipe-e-tabacchi-da-pipa'].includes(slug);
const hasFamilies=catalogAssortment.some(item=>item.page===slug);
const heroName=slug==='deposito-bagagli'?text(lang,'Deposito bagagli Bounce.','Bounce luggage storage.'):navLabel(slug)+'.';
const heroStudy=({'cartoleria':'stationery-paper-study','idee-regalo':'gifting-still-life','profumi-raptus':'fragrance-paper-study','feste-e-compleanni':'celebration-paper-study','giochi-e-giocattoli':'play-shape-study'} as Record<string,VisualStudyId>)[slug];
const openingSlugs=['il-negozio','servizi','contatti','marchi-e-competenze','storia-e-serrande','recensioni','ricevitoria','accendini-e-accessori'];
const heroType=slug==='cartoleria'?'paper':slug==='profumi-raptus'?'fragrance':slug==='feste-e-compleanni'?'celebration':slug==='giochi-e-giocattoli'?'play':'gift';
const pageImages:Record<string,string>={'sigari':'/images/quaderni/foglia-struttura.webp','pipe-e-tabacchi-da-pipa':'/images/quaderni/botanica-erica.webp','deposito-bagagli':'/images/hero/viaggiatrice.webp','servizi':'/images/studies/travel-bologna-map.webp','contatti':'/images/hero/portico.webp','il-negozio':'/images/editorial/bottega-desktop.webp','marchi-e-competenze':'/images/studies/stationery-paper-study.webp','recensioni':'/images/hero/portico.webp','storia-e-serrande':'/images/materials/night.webp','giochi-e-giocattoli':'/images/games.webp'};
const materials:Record<string,string>={utility:'blue',bottega:'terracotta',regalo:'paper',profumo:'paper',gioco:'paper',cedro:'wood',radica:'forest',notte:'night'};
const image=heroStudy?`/images/studies/${heroStudy}.webp`:pageImages[slug]||(p.photo?`/images/editorial/${p.photo}-desktop.webp`:p.image||`/images/materials/${materials[p.theme]||'paper'}.webp`);
const faqs=p.faqs||[];const schema=faqs.length?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map((f:any)=>({'@type':'Question',name:f[l===0?0:2],acceptedAnswer:{'@type':'Answer',text:f[l===0?1:3]}}))}:null;
---
<Base title={(p.seoTitle||p.title)[l]} description={p.intro[l]} slug={slug} lang={lang} theme={p.theme} image={image} schema={slug==='deposito-bagagli'?[schema,{'@context':'https://schema.org','@type':'Service',name:text(lang,'Deposito bagagli tramite Bounce','Luggage storage through Bounce'),serviceType:'Luggage storage',description:p.intro[l],availableChannel:{'@type':'ServiceChannel',serviceUrl:bounceUrl},provider:{'@type':'Store',name:shop.name,...(import.meta.env.PUBLIC_SITE_URL?{'@id':new URL('/#store',import.meta.env.PUBLIC_SITE_URL).href}:{}),address:{'@type':'PostalAddress',streetAddress:shop.address,postalCode:shop.postcode,addressLocality:shop.city,addressCountry:'IT'}},areaServed:'Bologna',url:bounceUrl}]:schema}>
<div class="breadcrumb wrap"><a href={pathFor('',lang)}>Home</a><span>/</span><span>{navLabel(slug)}</span></div>
{infoOnly?<EducationalHero slug={slug} lang={lang}/>:openingSlugs.includes(slug)?<PageOpening slug={slug} lang={lang} heading={heroName}/>:heroStudy?<section class:list={['assortment-hero','study-page-hero','wrap',`study-page-hero--${heroType}`]}><div class="study-hero-copy"><p class="section-label">{text(lang,'Guerrazzi · Bologna','Guerrazzi · Bologna')}</p>{slug==='deposito-bagagli'&&<BounceBrand lang={lang}/>}<h1>{heroName}</h1><p class="page-claim">{p.title[l]}</p><p>{p.intro[l]}</p></div><div class="study-hero-art"><VisualStudy id={heroStudy} lang={lang} variant="inset" loading="eager"/></div></section>:p.art?<section class="assortment-hero wrap"><div><p class="section-label">{text(lang,'Guerrazzi · Bologna','Guerrazzi · Bologna')}</p>{slug==='deposito-bagagli'&&<BounceBrand lang={lang}/>}<h1>{heroName}</h1><p class="page-claim">{p.title[l]}</p><p>{p.intro[l]}</p>{slug==='deposito-bagagli'&&<div class="booking-start"><a class="button primary" href={bounceUrl} target="_blank" rel="noopener">{text(lang,'Prenota su Bounce','Book on Bounce')}</a><p>{text(lang,'La scheda si chiama “Palazzo Ercolani”. Controlla data, orari e condizioni prima di confermare.','The listing is named “Palazzo Ercolani”. Check your date, hours and terms before confirming.')}</p></div>}</div>{slug==='deposito-bagagli'?<img class="luggage-page-image" src="/images/hero/viaggiatrice.webp" width="1672" height="940" alt={text(lang,'Una viaggiatrice con valigia davanti alla vetrina Guerrazzi','Traveller with a suitcase outside the Guerrazzi shopfront')} fetchpriority="high"/>:<img class="assortment-art" src={`/brand/ui/${p.art}.webp`} srcset={`/brand/ui/${p.art}-320.webp 320w, /brand/ui/${p.art}-600.webp 600w, /brand/ui/${p.art}.webp 960w`} sizes="(max-width: 680px) 65vw, (max-width: 960px) 35vw, 520px" width="960" height="960" alt="" aria-hidden="true" fetchpriority="high"/>}</section>:
<section class:list={['page-hero',p.image?'wrap':'no-photo']}><div><p class="section-label">{text(lang,'Guerrazzi · Bologna','Guerrazzi · Bologna')}</p>{slug==='deposito-bagagli'&&<BounceBrand lang={lang}/>}<h1>{heroName}</h1><p class="page-claim">{p.title[l]}</p><p>{p.intro[l]}</p></div>{p.image&&<img src={p.image} width="1122" height="1402" alt={p.image==='/images/regalo.webp'?text(lang,'La bambina riceve un gioco dalle mani di Angela','The child receives a toy from Angela'):p.image==='/images/scelta.webp'?text(lang,'Una famiglia si ferma davanti alla vetrina di Guerrazzi','A family stops at the Guerrazzi shop window'):text(lang,'Angela consegna un gioco alla bambina davanti alla vetrina','Angela hands a toy to the child at the shop window')} fetchpriority="high"/>}</section>
}
<section class="page-content wrap">
 {!infoOnly&&<nav class="page-jumps" aria-label={text(lang,'In questa pagina','On this page')}>
  {slug==='deposito-bagagli'?<><a href="#booking-title">{text(lang,'Come prenotare','How to book')}</a><a href="#luggage-address">{text(lang,'Dove depositare','Storage location')}</a></>:<>
   {hasFamilies&&<a href="#category-sheets">{text(lang,'Esplora le schede','Browse the listings')}</a>}
   {slug==='servizi'?<a href={pathFor('deposito-bagagli',lang)}>{text(lang,'Deposito bagagli Bounce','Bounce luggage storage')}</a>:<a href="#page-details">{text(lang,'Informazioni utili','Useful information')}</a>}
  </>}
  {p.links?.length>0&&<a href="#page-guides">{text(lang,'Guide pratiche','Practical guides')}</a>}
  {faqs.length>0&&<a href="#page-questions">{text(lang,'Domande frequenti','Frequently asked questions')}</a>}
 </nav>}
 {slug==='servizi'&&<LuggageCallout lang={lang}/>}
 {!infoOnly&&<CategoryPathways slug={slug} lang={lang} mode="answer"/>}
 {slug==='sigari'&&<CigarBrandStories lang={lang}/>}
 {infoOnly&&<MaterialAtlas slug={slug} lang={lang}/>}
 <div id="category-sheets"><FamilyLinks slug={slug} lang={lang}/></div>
 {['idee-regalo','marchi-e-competenze'].includes(slug)&&<aside class="fragrance-path"><div><p class="card-kind">{text(lang,'Profumi · Raptus','Perfumes · Raptus')}</p><h2>{text(lang,'La gamma Raptus, da scegliere in negozio.','The Raptus range, to choose in store.')}</h2><p>{text(lang,'L’intera gamma di profumi per persona è da Guerrazzi. Parti da una preferenza e confronta fragranza, formato e confezione.','Guerrazzi carries the full perfume range for personal use. Start with a preference and compare fragrance, size and packaging.')}</p></div><a class="button quiet" href={pathFor('profumi-raptus',lang)}>{text(lang,'Esplora i profumi Raptus','Explore Raptus perfumes')} </a></aside>}
 {slug==='profumi-raptus'&&p.officialWebsite&&<aside class="fragrance-reference"><div><p class="card-kind">Raptus Parfum</p><h2>{text(lang,'Le linee e i formati Raptus.','Raptus lines and sizes.')}</h2><p>{text(lang,'Consulta il sito ufficiale per i riferimenti delle due linee, poi verifica in negozio il nome e il formato che cerchi.','Visit the official website for information about both lines, then check your chosen name and size in store.')}</p></div><div class="fragrance-reference-actions"><a class="text-link" href={p.officialWebsite} target="_blank" rel="noopener">{text(lang,'Sito ufficiale Raptus','Official Raptus website')}</a><a class="button primary" href={`${pathFor('catalogo',lang)}?categoria=profumi`}>{text(lang,'Profumi nel catalogo','Perfumes in the catalogue')} </a></div></aside>}
 {slug==='marchi-e-competenze'&&<BrandDirectory lang={lang}/>}
 {!infoOnly&&p.sources&&<OfficialSources sources={p.sources} lang={lang}/>}
 {slug==='deposito-bagagli'&&<section class="booking-steps" aria-labelledby="booking-title"><h2 id="booking-title">{text(lang,'Dalla prenotazione al ritiro.','From booking to pickup.')}</h2><ol><li><h3>{text(lang,'Scegli data e bagagli','Choose your date and bags')}</h3><p>{text(lang,'Apri la scheda Bounce e controlla disponibilità, prezzo e orari per la tua visita.','Open the Bounce listing and check availability, prices and hours for your visit.')}</p></li><li><h3>{text(lang,'Porta la conferma','Bring your confirmation')}</h3><p>{text(lang,'Raggiungi Via Guerrazzi 10/F e mostra la conferma di prenotazione al momento del deposito.','Come to Via Guerrazzi 10/F and show your booking confirmation at drop-off.')}</p></li><li><h3>{text(lang,'Torna per il ritiro','Return for pickup')}</h3><p>{text(lang,'Rispetta l’orario di ritiro scelto. Per modifiche o assistenza alla prenotazione, usa Bounce.','Keep to your selected pickup time. Use Bounce for booking changes or support.')}</p></li></ol></section>}
 {slug==='deposito-bagagli'&&<section id="luggage-address" class="luggage-local"><div class="luggage-local-copy"><p class="eyebrow">{text(lang,'Un punto fermo in centro','Your base in the city centre')}</p><h2>{text(lang,'Il punto Bounce in Via Guerrazzi.','Your Bounce spot on Via Guerrazzi.')}</h2><p>{text(lang,'Il deposito si trova dentro Tabaccheria Guerrazzi di Angela, in Via Guerrazzi 10/F, 40125 Bologna. È lo stesso indirizzo del punto Bounce “Palazzo Ercolani”: cerca questo nome sulla piattaforma, poi usa il civico per raggiungere il negozio.','Storage is inside Tabaccheria Guerrazzi di Angela, Via Guerrazzi 10/F, 40125 Bologna. This is the address of the Bounce “Palazzo Ercolani” location: look for that listing name, then use the street number to find the shop.')}</p><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Indicazioni per Via Guerrazzi 10/F','Directions to Via Guerrazzi 10/F')}</a></div><div class="luggage-local-study"><VisualStudy id="travel-bologna-map" lang={lang} variant="inset"/></div><div class="luggage-local-notes"><h3>{text(lang,'Prima di arrivare','Before you arrive')}</h3><ul><li>{text(lang,'Prenota dalla scheda ufficiale Bounce, anche se parti dal nostro sito.','Complete your booking on the official Bounce listing, even if you start on our website.')}</li><li>{text(lang,'Controlla orari di consegna e ritiro per il giorno scelto.','Check drop-off and pickup hours for your selected day.')}</li><li>{text(lang,'Tieni a portata di mano la conferma o il QR code della prenotazione.','Keep your booking confirmation or QR code handy.')}</li><li>{text(lang,'Per modifiche, cancellazioni e condizioni di protezione, consulta Bounce.','Use Bounce for changes, cancellations and protection terms.')}</li></ul><a class="text-link" href={bounceUrl} target="_blank" rel="noopener">{text(lang,'Scheda e condizioni ufficiali Bounce','Official Bounce listing and terms')}</a></div></section>}
 {slug==='contatti'?<div id="page-details" class="contact-block"><div class="contact-details"><h2>{text(lang,'L’indirizzo','Our address')}</h2><address>{shop.address}<br/>{shop.postcode} {shop.city}</address>{shop.phone&&<a class="text-link" href={`tel:${shop.phone}`}>{shop.phone}</a>}{shop.email&&<a class="text-link" href={`mailto:${shop.email}`}>{shop.email}</a>}{shop.hours.length>0?<><h2>{text(lang,'Orari','Opening hours')}</h2><dl>{shop.hours.map(h=><div><dt>{h.day}</dt><dd>{h.hours}</dd></div>)}</dl></>:<p>{text(lang,'Per organizzare la visita, verifica gli orari aggiornati sul profilo del negozio.','To plan your visit, check the latest hours on the shop profile.')}</p>}<a class="text-link" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Consulta il profilo su Google Maps','Check our Google Maps profile')}</a></div><div class="map-panel"><h2>Guerrazzi<br/>10/F.</h2><p>{text(lang,'Imposta il punto di partenza e scegli il percorso con la tua app di mappe.','Set your starting point and choose a route in your maps app.')}</p><a class="button light" href={shop.maps} target="_blank" rel="noopener"><Icon name="location"/>{text(lang,'Apri le indicazioni','Open directions')}</a></div></div>:['idee-regalo','giochi-e-giocattoli'].includes(slug)?<div id="page-details"><ChoiceNotes kind={slug==='idee-regalo'?'gift':'play'} lang={lang}/></div>:!infoOnly&&!['deposito-bagagli','servizi','recensioni'].includes(slug)&&<div id="page-details" class="content-columns information-panels">{p.sections.map((s:any,i:number)=><section><span class="panel-number">{String(i+1).padStart(2,'0')}</span><h2>{s[0][l]}</h2><p>{s[1][l]}</p></section>)}</div>}
 {infoOnly&&<h2 id="norme" class="information-heading">{text(lang,'Norme e confezioni.','Rules and packaging.')}</h2>}
 {slug==='servizi'?<ServiceDesk lang={lang}/>:p.links&&<section id="page-guides" class="page-guide-section">{!infoOnly&&<h2>{text(lang,'Guide pratiche.','Practical guides.')}</h2>}<div class:list={['guides-links',infoOnly&&'information-guides']}>{p.links.map((s:string,i:number)=><a class="guide-link" href={pathFor(`schede/${s}`,lang)}><span class="card-kind">{text(lang,'Guida pratica','Practical guide')}</span><h3>{guides[s].title[l]}</h3>{slug==='servizi'&&p.sections[i]&&<p class="guide-summary">{p.sections[i][1][l]}</p>}<p>{text(lang,'Apri la guida','Open the guide')} </p></a>)}</div></section>}
 {infoOnly&&p.sources&&<OfficialSources sources={p.sources} lang={lang}/>}
 {slug==='sigari'&&<CigarRecords lang={lang}/>}
 {['idee-regalo','giochi-e-giocattoli'].includes(slug)&&<div class:list={['category-banner',slug==='idee-regalo'&&'category-banner--text']}>{slug==='giochi-e-giocattoli'&&<img src="/images/games.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Una composizione fotografica dedicata alla scelta','An editorial photograph about choosing')}/>}<div><h2>{text(lang,'Una prima idea, prima di passare.','A first idea before you visit.')}</h2><a class="button primary" href={`${pathFor('catalogo',lang)}?categoria=${slug==='idee-regalo'?'regali':'giochi'}`}>{text(lang,'Sfoglia il catalogo','Browse the catalogue')}</a></div></div>}
 {slug==='recensioni'&&<div id="page-details" class="review-section">{shop.reviews.length?shop.reviews.map(r=><blockquote><p>{r.body}</p><footer>{r.name} <time>{r.date}</time><a href={r.sourceUrl} target="_blank" rel="noopener">{text(lang,'Leggi la fonte','Read the source')}</a></footer></blockquote>):<div class="empty-note"><h2>{text(lang,'Le esperienze, alla fonte.','Experiences, at the source.')}</h2><p>{text(lang,'Consulta le recensioni sul profilo Google del negozio e racconta la tua esperienza.','Read reviews on the shop’s Google profile and share your experience.')}</p><a class="text-link" href={shop.reviewUrl||shop.maps} target="_blank" rel="noopener">{text(lang,'Apri il profilo Google','Open the Google profile')}</a></div>}</div>}
 {['idee-regalo','giochi-e-giocattoli'].includes(slug)&&<details class="category-details extra-details"><summary>{text(lang,'Altri consigli per la scelta','More advice for choosing')}</summary><div class="content-columns information-panels">{p.sections.map((s:any)=><section><h2>{s[0][l]}</h2><p>{s[1][l]}</p></section>)}</div></details>}
 {p.groups?.length>0&&<details class="extra-details range-disclosure"><summary>{text(lang,'Categorie e brand della bottega','Shop categories and brands')}</summary><div class="range-detail">{p.photo&&<EditorialPhoto name={p.photo} alt={p.photoAlt[l]} lang={lang}/>}<div class="range-groups"><h2>{text(lang,'Cosa trovi da Angela.','What you will find at Angela’s.')}</h2>{p.groups.map((g:any)=><div><h3>{g.title[l]}</h3><ul>{g.items.map((item:any)=><li>{item[l]}</li>)}</ul></div>)}{p.brands?.length>0&&<div class="brand-reference"><h3>{text(lang,['accendini-e-accessori','ricevitoria'].includes(slug)?'Nomi e categorie':'Brand disponibili',['accendini-e-accessori','ricevitoria'].includes(slug)?'Names and categories':'Available brands')}</h3><p>{p.brands.join(', ')}.</p></div>}</div></div></details>}
 {['il-negozio','idee-regalo'].includes(slug)&&<section class="editorial-feature"><EditorialPhoto name={slug==='il-negozio'?'bottega':'regali'} alt={slug==='il-negozio'?text(lang,'Ricostruzione editoriale delle vetrine bianche e in legno del negozio','Editorial reconstruction of the shop’s white and wooden display cabinets'):text(lang,'piccole candele e portachiavi ispirata alla vetrina','small candles and keyrings inspired by the display')} lang={lang} wide/></section>}
 {slug==='piccole-necessita'&&<section class="editorial-feature"><EditorialPhoto name="cura" alt={text(lang,'vetrina di cura personale con accessori per capelli','personal-care cabinet with hair accessories')} lang={lang} wide/></section>}
 {['il-negozio','servizi'].includes(slug)&&<AssortmentNav lang={lang} slugs={slug==='servizi'?['ricevitoria','accessori-telefono','piccole-necessita']:null}/>}
 {!infoOnly&&<CategoryPathways slug={slug} lang={lang} mode="links"/>}
 {p.related?.length>0&&<section class="related-categories"><h2>{text(lang,'Può servirti anche.','You might also need.')}</h2><div>{p.related.map((s:string)=><a href={pathFor(s,lang)}>{navLabel(s)}</a>)}</div></section>}
 {faqs.length>0&&<div id="page-questions" class="faq"><h2>{infoOnly?text(lang,'Le domande più comuni.','Common questions.'):text(lang,'Domande frequenti.','Frequently asked questions.')}</h2>{faqs.map((f:any)=><details><summary>{f[l===0?0:2]}</summary><p>{f[l===0?1:3]}</p></details>)}</div>}
</section>
{['giochi-e-giocattoli','il-negozio','storia-e-serrande'].includes(slug)&&<Story lang={lang} mode={slug==='storia-e-serrande'?'place':'encounters'}/>}
{related.length>0&&<section class="journal-preview wrap"><div class="section-opening"><h2>{infoOnly?text(lang,'Dai quaderni di Guerrazzi.','From the Guerrazzi notebooks.'):text(lang,'Dal diario di Guerrazzi.','From the Guerrazzi journal.')}</h2><a class="text-link" href="/approfondimenti/">{text(lang,'Tutti gli articoli','All articles (Italian)')}</a></div><div class:list={['journal-list',infoOnly&&'information-articles']}>{related.slice(0,3).map(a=><a href={`/approfondimenti/${a.slug}/`}><span class="card-kind">{text(lang,'Articolo','Article in Italian')} · {clusters.find(c=>c.id===a.cluster)?.label}</span><h3>{a.title}</h3><p>{a.summary}</p><span class="article-open">{text(lang,'Leggi l’articolo','Read the article')}</span>{lang==='en'&&<span>Italian article</span>}</a>)}</div></section>}
{!infoOnly&&!['ricevitoria','accendini-e-accessori'].includes(slug)&&<div class="wrap"><NeighborhoodLinks topic={slug} lang={lang}/></div>}
<section class="visit-panel wrap"><BrandSignature lang={lang} personal={!infoOnly}/><img class="visit-art" src="/brand/ui/portico-ink.webp" srcset="/brand/ui/portico-ink-480.webp 480w, /brand/ui/portico-ink.webp 960w, /brand/ui/portico-ink-1536.webp 1536w" sizes="(max-width: 680px) 100vw, 620px" width="960" height="480" alt="" loading="lazy" aria-hidden="true"/><p>{shop.address}, Bologna</p><h2>{infoOnly?text(lang,'Un indirizzo, un riferimento.','An address, a reference.'):text(lang,'La scelta continua in negozio.','Continue your visit in store.')}</h2><a class="button primary" href={shop.maps} target="_blank" rel="noopener"><Icon name="location"/>{infoOnly?text(lang,'Apri le indicazioni','Open directions'):text(lang,'Vieni da Guerrazzi','Visit Guerrazzi')}</a></section>
</Base>

<style>
 .study-page-hero{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(32px,4vw,64px);align-items:center;padding-block:30px 65px}
 .study-page-hero .study-hero-copy{min-width:0}
 .study-page-hero h1{font-size:clamp(3rem,4.7vw,4.7rem);max-width:14ch}
 .study-page-hero .study-hero-copy>.section-label{font-size:1rem}
 .study-page-hero .study-hero-copy>.page-claim{max-width:24ch}
 .study-hero-art{min-width:0;padding-left:28px;border-left:1px solid var(--line)}
 .study-page-hero--gift{grid-template-columns:minmax(0,1fr) minmax(0,1.12fr)}
 .study-page-hero--gift .study-hero-art{padding-top:24px}
 .study-page-hero--paper .study-hero-art{padding-block:0 16px}
 .study-page-hero--fragrance{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr)}
 .study-page-hero--fragrance h1{max-width:13ch}
 .fragrance-path,.fragrance-reference{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);align-items:center;gap:35px;padding:30px 0;margin-block:30px 40px;border-block:1px solid var(--line)}
 .fragrance-path h2,.fragrance-reference h2{font-size:clamp(1.9rem,3vw,2.6rem);line-height:1.15;max-width:28ch;margin:14px 0 18px;color:var(--accent)}
 .fragrance-path p,.fragrance-reference p{font-size:.95rem;line-height:1.8;max-width:65ch}
 .fragrance-path .card-kind,.fragrance-reference .card-kind{font-size:.95rem;font-weight:600;color:var(--accent)}
