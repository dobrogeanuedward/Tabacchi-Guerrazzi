---
import NeighborhoodLinks from './NeighborhoodLinks.astro';
import Base from '../layouts/Base.astro';
import CollectionNarrative from './CollectionNarrative.astro';
import {brandSlug} from '../data/brand-catalogue';
import BrandSignature from './BrandSignature.astro';
import {catalogAssortment,catalogGroups} from '../data/catalog-assortment';
import {familyDetails} from '../data/family-details';
import {familyPresentationFor} from '../data/family-presentation';
import {catalogPhotoFor} from '../data/catalog-photography';
import {shop,pathFor,text,mainPages,type Lang} from '../data/shop';
import {pages} from '../data/pages';

const {id,lang='it'}=Astro.props as {id:string;lang:Lang};
const item=catalogAssortment.find(p=>p.id===id)!;
const d=familyDetails[id];
const l=lang==='it'?0:1;
const group=catalogGroups.find(g=>g.id===item.category)!;
const label=lang==='it'?group.it:group.en;
const presentation=familyPresentationFor(item.category);
const theme=pages[item.page]?.theme||presentation.theme;
const siblings=d.relatedFamilies
  ?d.relatedFamilies.map(relatedId=>catalogAssortment.find(p=>p.id===relatedId)).filter((p):p is typeof item=>!!p&&p.id!==id).slice(0,4)
  :catalogAssortment.filter(p=>p.page===item.page&&p.id!==id).slice(0,4);
const familyCategoryLabel=(category:string)=>{const entry=catalogGroups.find(g=>g.id===category);return entry?(lang==='it'?entry.it:entry.en):label};
const categorySlugs=new Set(catalogAssortment.map(p=>p.page));
const related=(pages[item.page]?.related||[]).filter((slug:string)=>slug!==item.page&&categorySlugs.has(slug)).slice(0,2);
const relatedCategories:{slug:string;label:string;intro:string}[]=related.map((slug:string)=>({slug,label:mainPages.find(p=>p.slug===slug)?.[lang]||pages[slug].title[l],intro:pages[slug].intro[l]}));
const fragranceStudy=item.category==='profumi';
const photograph=catalogPhotoFor(item.id);
const familyImage=photograph.src;
const familyImageSet=photograph.srcset;
const familyOgImage=photograph.src;
const visitQuestions:Record<string,[[string,string],[string,string]]>={
 giochi:[['Cerchi una scatola o un personaggio preciso?','Looking for a specific box or character?'],['Porta nome, codice o foto della confezione e indica l’età di chi giocherà. Le famiglie orientano la ricerca; verifica la disponibilità del modello prima di una visita dedicata.','Bring the name, code or pack photo and the player’s age. Families guide your search; check model availability before a special trip.']],
 cartoleria:[['Cerchi un formato o una variante precisa?','Looking for a specific size or variant?'],['Porta la misura, il nome completo o una foto dell’articolo che usi. Rigatura, colore, punta e formato vanno confrontati sul singolo articolo.','Bring the size, full name or a photo of the item you use. Ruling, colour, tip and size must be compared on the individual item.']],
 dolciumi:[['Cerchi un gusto o hai un’esigenza alimentare?','Looking for a flavour or checking a dietary requirement?'],['Usa nome e variante della confezione. Ingredienti e allergeni si leggono sull’etichetta del prodotto presente, anche se conosci già la marca.','Use the pack’s name and variant. Read ingredients and allergens on the available product’s label, even if you know the brand.']],
 necessita:[['Come preparo la richiesta per un ricambio?','How should I prepare a replacement request?'],['Porta una foto leggibile, la sigla o le misure dell’articolo. Specifica l’uso e confronta indicazioni e compatibilità sulla confezione del modello presente.','Bring a clear photo, code or item dimensions. Specify the intended use and compare instructions and compatibility on the available model’s pack.']],
 telefono:[['Che cosa porto per controllare la compatibilità?','What should I bring to check compatibility?'],['Il dispositivo o foto leggibili delle porte del telefono e dell’alimentatore. Il modello scelto va confrontato con entrambe le connessioni e con le specifiche richieste.','Bring the device or clear photos of the phone and charger ports. Match the chosen model to both connections and the required specifications.']],
 souvenir:[['Cerchi un soggetto o una lingua precisa?','Looking for a specific design or language?'],['Indica il monumento, la ricetta o il soggetto che hai in mente. Per le calamite ricetta specifica italiano o inglese; confronta le varianti presenti in negozio.','Specify the landmark, recipe or subject you have in mind. For recipe magnets, specify Italian or English; compare the variants available in store.']],
 feste:[['Come preparo una richiesta per la festa?','How should I prepare a party request?'],['Indica cifra, colore e quantità; per una busta porta le misure del regalo. Verifica le varianti presenti e le istruzioni del singolo articolo.','Specify the digit, colour and quantity; bring gift dimensions for a bag. Check available variants and each item’s instructions.']],
 regali:[['Come scelgo per un’altra persona?','How do I choose for someone else?'],['Parti da occasione, interessi, budget e spazio in cui userà l’oggetto. Guarda finitura e dimensioni dal vivo; biglietti e buste hanno percorsi dedicati.','Start with the occasion, interests, budget and space where they will use the object. Compare finish and size in person; cards and gift bags have dedicated paths.']],
 profumi:[['Cerchi una fragranza che conosci già?','Looking for a fragrance you already know?'],['Porta il nome completo o una foto leggibile di flacone e confezione. Controlla il formato e verifica la variante prima di una visita dedicata.','Bring the full name or a clear bottle and pack photo. Check the size and verify the variant before a special trip.']],
 alimentari:[['Come verifico formato e ingredienti?','How do I check the size and ingredients?'],['Leggi denominazione, quantità, ingredienti e conservazione sul vasetto presente. Per una variante precisa verifica l’assortimento prima della visita.','Read the name, quantity, ingredients and storage details on the available jar. Check the range before visiting for a specific variant.']]
};
const visitQuestion=visitQuestions[item.category];
const faqs=[
  [d.question[l],d.answer[l]],
  [visitQuestion[0][l],visitQuestion[1][l]],
];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Base lang={lang} slug={`assortimento/${id}`} title={`${item.name[l]} ${text(lang,'a Bologna','in Bologna')}`} description={text(lang,`${item.name[0]} da Angela, Via Guerrazzi 10/F, Bologna. ${item.description[0]}`,`${item.name[1]} at Angela’s, Via Guerrazzi 10/F, Bologna. ${item.description[1]}`)} schema={schema} theme={theme} image={familyOgImage}>
  <div class="family-document" data-treatment={presentation.treatment} style={`--family-material: url('/images/materials/${presentation.material}-768.webp')`}>
    <nav class="breadcrumb wrap" aria-label={text(lang,'Percorso di navigazione','Breadcrumb')}><a href={pathFor('catalogo',lang)}>{text(lang,'Catalogo','Catalogue')}</a><span aria-hidden="true">/</span><a href={pathFor(item.page,lang)}>{label}</a><span aria-hidden="true">/</span><span>{text(lang,'Famiglia','Family')}</span></nav>

    <section class="family-hero wrap" aria-labelledby="family-title">
      <div class="family-hero-copy">
        <p class="family-type"><span>{text(lang,'Famiglia di articoli','Item family')}</span><a href={pathFor(item.page,lang)}>{label}</a></p>
        <h1 id="family-title">{item.name[l]}</h1>
        <p class="family-description">{item.description[l]}</p>
        <a class="family-category-link" href={pathFor(item.page,lang)}>{text(lang,'Esplora la categoria','Explore the category')}</a>
        <nav class="family-index" aria-label={text(lang,'In questa scheda','On this record')}>
          <a href="#dettagli">{text(lang,'Come scegliere','How to choose')}</a>
          <a href="#domande">{text(lang,'Domande e risposte','Questions and answers')}</a>
          {(siblings.length>0||relatedCategories.length>0)&&<a href="#percorsi">{text(lang,'Continua a esplorare','Keep exploring')}</a>}
        </nav>
      </div>
      <figure class="family-visual family-visual-photo">
        <div class="family-art-surface"><img src={familyImage} srcset={familyImageSet} sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1100px) 42vw, 570px" width={photograph.width} height={photograph.height} alt={photograph.alt?.[l]||item.name[l]} fetchpriority="high"/></div>
        <figcaption>{item.name[l]}</figcaption>
      </figure>
    </section>

    {d.story?<section class="family-story wrap" aria-label={text(lang,'Da conoscere','Get to know it')}>
      {d.story.map(part=><div class="family-story-part"><h2>{part.title[l]}</h2><div>{part.paragraphs.map(paragraph=><p>{paragraph[l]}</p>)}</div></div>)}
    </section>:<CollectionNarrative id={id} lang={lang}/>}
    {d.choice&&<section class="family-choice wrap" aria-labelledby="family-choice-title">
      <p class="family-section-label">{text(lang,'Scegli il tuo percorso','Choose your path')}</p><h2 id="family-choice-title">{d.choice.title[l]}</h2>
      <div class="family-choice-options">{d.choice.options.map(option=><section><h3>{option.label[l]}</h3><p>{option.text[l]}</p></section>)}</div>
    </section>}
    <section class="family-register wrap" aria-labelledby="family-register-title">
      <h2 id="family-register-title" class="sr-only">{text(lang,'La scheda in breve','Record at a glance')}</h2>
      <dl>
        <div><dt>{text(lang,'Categoria di riferimento','Category reference')}</dt><dd><a href={pathFor(item.page,lang)}>{label}</a></dd></div>
        {item.brand&&<div><dt>{fragranceStudy?text(lang,'Marchio','Brand'):text(lang,'Brand disponibili','Available brands')}</dt><dd class="family-brands">{item.brand.split(',').map(name=><a href={pathFor(`marchi/${brandSlug(name.trim())}`,lang)}>{name.trim()}</a>)}</dd></div>}
        <div class="family-register-note"><dt>{text(lang,'Sul singolo articolo','For an individual item')}</dt><dd>{text(lang,'Guarda gli articoli da vicino, da Angela.','Take a closer look at the items at Angela’s.')}</dd></div>
      </dl>
    </section>

    <section id="dettagli" class="family-checks wrap" aria-labelledby="family-checks-title">
      <div class="family-section-opening">
        <p class="family-section-label">{text(lang,'Prima di scegliere','Before choosing')}</p>
        <h2 id="family-checks-title">{text(lang,'Tre cose da guardare.','Three things to look at.')}</h2>
        <p>{presentation.focus[l]}</p>
        <p class="family-check-context">{presentation.checkNotes[0][l]}</p>
      </div>
      <ol>{d.checks[l].map((check,i)=><li><span class="family-check-number" aria-hidden="true">0{i+1}</span><h3>{check}</h3></li>)}</ol>
    </section>

    <section id="domande" class="family-information wrap" aria-labelledby="family-faq-title">
      <div class="family-section-opening"><p class="family-section-label">{text(lang,'La domanda utile','A useful question')}</p><h2 id="family-faq-title">{text(lang,'Una domanda utile.','A useful question.')}</h2><p>{text(lang,'Se hai qualcosa in mente, raccontacelo.','If you have something in mind, tell us.')}</p></div>
      <div class="family-faq">
        {faqs.map(([q,a],i)=><details open={i===0}><summary>{q}<span aria-hidden="true"></span></summary><p>{a}</p></details>)}
        {!!d.sources?.length&&<div class="family-sources"><p>{text(lang,'Riferimenti delle linee','References for the lines')}</p>{d.sources!.map(source=><a href={source.url} target="_blank" rel="noopener">{source.label[l]}</a>)}</div>}
      </div>
    </section>

    {d.readMore&&<aside class="family-reading wrap"><div><p class="family-section-label">{text(lang,'Dal diario di Angela','From Angela’s journal')}</p><h2>{d.readMore.title[l]}</h2><p>{text(lang,'Un racconto per confrontare le proposte e trovare il tuo percorso.','A story to compare the options and find your path. The article is in Italian.')}</p></div><a class="button quiet" href={`/approfondimenti/${d.readMore.slug}/`}>{text(lang,'Leggi l’articolo','Read the article in Italian')}</a></aside>}

    {(siblings.length>0||relatedCategories.length>0)&&<section id="percorsi" class="family-related wrap" aria-labelledby="family-related-title">
      <div class="family-related-opening"><div class="family-section-opening"><p class="family-section-label">{text(lang,'Continua a esplorare','Keep exploring')}</p><h2 id="family-related-title">{siblings.length>0?text(lang,'Da confrontare, da abbinare.','Compare or pair.'):text(lang,'Altri percorsi, altre idee.','More paths, more ideas.')}</h2></div><a class="family-all-link" href={`${pathFor('catalogo',lang)}?categoria=${item.category}`}>{text(lang,'Vedi nel catalogo','View in the catalogue')}</a></div>
      {siblings.length>0&&<div class="family-sibling-grid">{siblings.map(sibling=>{const photo=catalogPhotoFor(sibling.id);return <a class="family-sibling-card" href={pathFor(`assortimento/${sibling.id}`,lang)}><img class="family-sibling-photo" src={photo.src} srcset={photo.srcset} sizes="(max-width: 680px) calc(100vw - 88px), 360px" width={photo.width} height={photo.height} alt={photo.alt?.[l]||sibling.name[l]} loading="lazy"/><span class="family-card-type">{text(lang,'Famiglia','Family')} · {familyCategoryLabel(sibling.category)}</span><h3>{sibling.name[l]}</h3><p>{sibling.description[l]}</p><span class="family-card-action">{text(lang,'Apri la scheda','Open the record')}</span></a>})}</div>}
      {relatedCategories.length>0&&<div class="family-category-grid">{relatedCategories.map(category=><a href={pathFor(category.slug,lang)}><span class="family-card-type">{text(lang,'Categoria','Category')}</span><h3>{category.label}</h3><p>{category.intro}</p><span class="family-card-action">{text(lang,'Esplora la categoria','Explore the category')}</span></a>)}</div>}
    </section>}

    <div class="wrap"><NeighborhoodLinks topic={item.page} lang={lang}/></div>
    <section class="family-visit wrap" aria-label={text(lang,'Informazioni per la visita','Visit information')}>
      <div><BrandSignature lang={lang}/><p>{shop.address}, {shop.postcode} {shop.city}</p></div>
      <div class="family-visit-copy"><p>{text(lang,'Sai già cosa cerchi? Portaci il nome o una foto.','Know what you need? Bring the name or a photo.')}</p><p>{text(lang,'Oppure entra e lasciati incuriosire.','Or come in and let curiosity lead.')}</p></div>
      <div class="family-visit-actions"><a class="button quiet" href={pathFor('contatti',lang)}>{text(lang,'Contatta il negozio','Contact the shop')}</a><a class="family-all-link" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Apri le indicazioni','Open directions')}</a></div>
    </section>
  </div>
</Base>
<style>
 .family-reading{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-block:32px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.family-reading h2{font:400 clamp(1.7rem,2.5vw,2.3rem)/1.2 var(--display);color:var(--accent);max-width:26ch;margin:0 0 14px}.family-reading p{max-width:65ch;line-height:1.8}.family-reading .button{flex-shrink:0}@media(max-width:680px){.family-reading{align-items:flex-start;flex-direction:column;gap:14px}}
 .family-story{border-top:1px solid var(--line);padding-block:38px}.family-story-part{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:40px}.family-story h2,.family-choice h2{font:400 clamp(1.9rem,3vw,2.7rem)/1.2 var(--display);color:var(--accent)}.family-story p{line-height:1.9;max-width:68ch;margin:0 0 1rem}.family-choice{padding-block:30px 45px}.family-choice-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px;margin-top:24px}.family-choice-options>section{padding:24px;border-top:3px solid var(--accent);background:var(--surface)}.family-choice-options h3{font:400 1.65rem/1.2 var(--display);color:var(--accent);margin:0 0 14px}.family-choice-options p{line-height:1.8;margin:0}.family-sibling-photo{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;margin:0 0 18px}@media(max-width:680px){.family-story-part{grid-template-columns:1fr;gap:16px}}
 .family-brands{display:flex;flex-wrap:wrap;gap:8px 16px}.family-brands a{text-decoration:underline;text-underline-offset:4px;min-height:44px;display:inline-flex;align-items:center}
  .family-document{--family-tone:var(--accent);--family-line:color-mix(in srgb,var(--accent) 23%,#e5e0d5);--family-muted:#4d5a68;color:var(--ink)}
  .family-document .breadcrumb{font-size:.95rem;line-height:1.6;gap:10px}
  .family-document .breadcrumb a{min-height:44px;display:inline-flex;align-items:center}
  .family-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:6%;align-items:center;padding:24px 0 48px}
  .family-hero-copy{min-width:0}
  .family-type{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-size:.95rem;line-height:1.65;color:var(--family-muted);margin-bottom:20px}
  .family-type>span{border-left:3px solid var(--family-tone);padding-left:12px;font-weight:600;color:var(--family-tone)}
  .family-type>a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:4px}
  .family-hero h1{font-size:clamp(2.6rem,4.7vw,4rem);line-height:1.07;letter-spacing:-.04em;color:var(--family-tone);margin-bottom:24px;max-width:15ch}
  .family-description{font-size:1.075rem;line-height:1.85;color:#33435b;max-width:51ch;margin-bottom:22px}
  .family-category-link,.family-all-link{display:inline-flex;align-items:center;gap:18px;font-size:.95rem;font-weight:600;line-height:1.6;min-height:44px;color:var(--family-tone)}
  .family-category-link{border-bottom:1px solid var(--family-tone)}
  .family-category-link span,.family-all-link span{font-size:1.3rem}
  .family-index{display:flex;flex-wrap:wrap;gap:4px 22px;border-top:1px solid var(--family-line);margin-top:30px;padding-top:15px}
  .family-index a{font-size:.95rem;line-height:1.6;display:inline-flex;align-items:center;min-height:44px;color:var(--family-muted);text-decoration:underline;text-underline-offset:5px}
  .family-visual{min-width:0;margin:0}
  .family-art-surface{position:relative;isolation:isolate;display:grid;place-items:center;padding:28px;min-height:330px;background:linear-gradient(#fbf8f0c9,#fbf8f0c9),var(--family-material) center/cover;overflow:hidden}
  .family-art-surface::before{content:'';position:absolute;z-index:-1;inset:16px;border:1px solid var(--family-line);pointer-events:none}
  .family-art-surface img{width:100%;height:auto;max-height:410px;object-fit:contain}
  .family-visual figcaption{margin-top:17px;font-size:.95rem;line-height:1.75;color:var(--family-muted);max-width:66ch}
  .family-visual figcaption>span{display:block;font-weight:600;color:var(--family-tone);margin-bottom:5px}
  [data-treatment='paper'] .family-art-surface{border-radius:3px 3px 44px 3px;background:linear-gradient(#fbf8f0c7,#fbf8f0c7),var(--family-material) center/cover}
  [data-treatment='paper'] .family-art-surface::before{inset:24px 18px;border-width:1px 0}
  [data-treatment='city'] .family-art-surface{border-radius:160px 160px 3px 3px;background:linear-gradient(#f0dfd470,#f0dfd470),var(--family-material) center/cover}
  [data-treatment='city'] .family-art-surface::before{inset:20px;border-radius:140px 140px 0 0}
  [data-treatment='celebration'] .family-art-surface,[data-treatment='play'] .family-art-surface{background:linear-gradient(#fbf8f0db,#fbf8f0db),var(--family-material) center/cover;border-radius:3px 3px 70px 3px}
  [data-treatment='celebration'] .family-art-surface::before,[data-treatment='play'] .family-art-surface::before{inset:10% 4% 3% 20%;border:0;background:#f2d46e;border-radius:50%}
  [data-treatment='play'] .family-art-surface::before{inset:3% 18% 10% 4%;background:#f0d36e}
  [data-treatment='utility'] .family-art-surface{border-left:4px solid var(--family-tone);background:linear-gradient(#e7eef9bd,#e7eef9bd),var(--family-material) center/cover}
  [data-treatment='utility'] .family-art-surface::before{inset:22px 20px;border-width:1px 0}
  [data-treatment='sweets'] .family-art-surface{background:linear-gradient(#f2e1dccf,#f2e1dccf),var(--family-material) center/cover;border-radius:3px 60px 3px 3px}
  [data-treatment='sweets'] .family-art-surface::before{border-radius:0 40px 0 0}
  [data-treatment='gift'] .family-art-surface{border-radius:70px 3px 3px 3px;background:linear-gradient(#f2e1dcbd,#f2e1dcbd),var(--family-material) center/cover}
  [data-treatment='gift'] .family-art-surface::before{inset:23px;border-radius:45px 0 0 0}
  .family-visual.family-visual-photo .family-art-surface{padding:0;min-height:0;background:none;overflow:hidden;border:0;border-radius:3px}
  .family-visual-photo .family-art-surface::before{content:none}
  .family-visual-photo .family-art-surface img{aspect-ratio:3/2;max-height:none;object-fit:cover}
  .family-visual-photo figcaption{padding-top:14px;border-top:1px solid var(--family-line)}
  .family-register{border-block:1px solid var(--family-line);padding-block:24px}
  .family-register dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:24px 40px;margin:0}
  .family-register dt{font-size:.95rem;line-height:1.7;color:var(--family-muted);margin-bottom:6px}
  .family-register dd{font-size:1rem;line-height:1.8;color:#243b59;margin:0}
  .family-register dd>a{display:inline-flex;gap:17px;align-items:center;min-height:44px;color:var(--family-tone);text-decoration:underline;text-underline-offset:5px}
  .family-register-note dd{max-width:37ch}
  .family-checks,.family-information{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:7%;padding-block:64px;scroll-margin-top:26px}
  .family-section-label{font-size:.95rem;line-height:1.6;font-weight:600;color:var(--family-tone);margin-bottom:15px}
  .family-section-opening h2{font-size:clamp(2rem,3.1vw,2.8rem);line-height:1.12;letter-spacing:-.03em;color:var(--family-tone);max-width:19ch;margin-bottom:21px}
  .family-section-opening>p:not(.family-section-label){font-size:1rem;line-height:1.8;max-width:46ch;color:#34435a}
  .family-section-opening .family-check-context{margin-top:18px;font-size:.95rem;color:var(--family-muted)}
  .family-checks ol{padding:0;list-style:none;margin:0;border-top:1px solid var(--family-line)}
  .family-checks li{display:grid;grid-template-columns:40px minmax(0,1fr);align-items:baseline;gap:18px;padding:25px 0;border-bottom:1px solid var(--family-line)}
  .family-check-number{font-family:var(--display);font-size:1.8rem;line-height:1.1;color:var(--family-tone)}
  .family-checks h3{font-size:1.75rem;line-height:1.25;color:var(--family-tone);margin:0;letter-spacing:-.025em}
  .family-information{padding-top:40px;border-top:1px solid var(--family-line)}
  .family-faq details{border-top:1px solid var(--family-line);padding:20px 0}
  .family-faq details:last-of-type{border-bottom:1px solid var(--family-line)}
  .family-faq summary{display:flex;align-items:center;justify-content:space-between;gap:25px;min-height:44px;list-style:none;font-size:1rem;font-weight:600;line-height:1.75;color:#243b59;cursor:pointer}
  .family-faq summary::-webkit-details-marker{display:none}
  .family-faq summary>span::before{content:'+';font-size:1.6rem;color:var(--family-tone)}
  .family-faq details[open] summary>span::before{content:'−'}
