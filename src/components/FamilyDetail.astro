---
import Base from '../layouts/Base.astro';import BrandSignature from './BrandSignature.astro';import EditorialPhoto from './EditorialPhoto.astro';import {catalogAssortment,catalogGroups} from '../data/catalog-assortment';import {familyDetails} from '../data/family-details';import {shop,pathFor,text,type Lang} from '../data/shop';
const {id,lang='it'}=Astro.props as {id:string;lang:Lang};const item=catalogAssortment.find(p=>p.id===id)!;const d=familyDetails[id];const l=lang==='it'?0:1;const group=catalogGroups.find(g=>g.id===item.category)!;const label=lang==='it'?group.it:group.en;const siblings=catalogAssortment.filter(p=>p.page===item.page&&p.id!==id);
const photo=({cartoleria:'cartoleria',souvenir:'souvenir',feste:'auguri',telefono:'necessita',necessita:['cerotti','labbra','capelli'].includes(id)?'cura':'necessita',dolciumi:'dolciumi',regali:'regali'} as Record<string,string>)[item.category];
const faqs=[[d.question[l],d.answer[l]],[text(lang,'La pagina conferma modelli e disponibilità?','Does this page confirm models and availability?'),text(lang,'No: descrive una famiglia osservata nelle fotografie del negozio. Varianti, confezioni e disponibilità vanno verificate al momento della visita.','No: it describes a family observed in shop photographs. Check variants, packs and availability when visiting.')]];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Base lang={lang} slug={`assortimento/${id}`} title={`${item.name[l]} ${text(lang,'a Bologna','in Bologna')}`} description={text(lang,`${item.name[0]} da Guerrazzi, Via Guerrazzi 10/F, Bologna: dettagli pratici, domande e categoria di riferimento. Assortimento documentato, disponibilità da verificare.`,`${item.name[1]} at Guerrazzi, Via Guerrazzi 10/F, Bologna: practical details, questions and category links. Documented range; check availability.`)} schema={schema} image={photo?`/images/editorial/${photo}-desktop.webp`:'/images/games.webp'}>
<div class="breadcrumb wrap"><a href={pathFor('catalogo',lang)}>{text(lang,'Catalogo','Catalogue')}</a><span>/</span><a href={pathFor(item.page,lang)}>{label}</a></div>
<section class="family-hero wrap"><div><p class="eyebrow">{text(lang,'Le piccole cose, da Angela','The little things, at Angela’s')}</p><h1>{item.name[l]}</h1><p>{item.description[l]}</p>{item.brand&&<p class="family-brand">{text(lang,'Marchi identificati nelle foto:','Brands identified in the photos:')} {item.brand}.</p>}<BrandSignature lang={lang}/></div><img src={`/brand/ui/${item.art}.webp`} width="600" height="600" alt="" aria-hidden="true" fetchpriority="high"/></section>
<section class="family-checks wrap"><p class="eyebrow">{text(lang,'Prima di passare','Before your visit')}</p><h2>{text(lang,'Tre dettagli per una domanda chiara.','Three details for a clear question.')}</h2><ol>{d.checks[l].map((c,i)=><li><span aria-hidden="true">0{i+1}</span><h3>{c}</h3></li>)}</ol></section>
<section class="family-context wrap">{photo?<EditorialPhoto name={photo} lang={lang} alt={text(lang,'Ricreazione editoriale della categoria nel negozio Guerrazzi','Editorial recreation of the category in the Guerrazzi shop')}/>:<figure><img src="/images/games.webp" width="1536" height="1024" loading="lazy" alt={text(lang,'Composizione editoriale di giochi','Editorial toy composition')}/><figcaption>{text(lang,'Immagine editoriale, non una scheda del singolo gioco.','Editorial image, not a record of an individual toy.')}</figcaption></figure>}<div><h2>{d.question[l]}</h2><p>{d.answer[l]}</p><p class="family-note">{text(lang,'Il riferimento è la confezione precisa, non l’immagine illustrativa della categoria.','The reference is the exact pack, rather than the category illustration.')}</p><a class="text-link" href={pathFor(item.page,lang)}>{text(lang,'Esplora','Explore')} {label.toLowerCase()} ↗</a></div></section>
<section class="faq wrap"><h2>{text(lang,'Le risposte essenziali.','The essential answers.')}</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
{siblings.length>0&&<section class="family-siblings wrap"><h2>{text(lang,'Nello stesso percorso.','Along the same path.')}</h2><div>{siblings.map(p=><a href={pathFor(`assortimento/${p.id}`,lang)}>{p.name[l]} ↗</a>)}</div></section>}
<section class="family-visit wrap"><BrandSignature lang={lang} personal/><p>{shop.address}, {shop.postcode} {shop.city}</p><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Apri le indicazioni','Open directions')}</a></section>
</Base>
<style>.family-hero{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:2rem;padding:2rem 0 3rem}.family-hero h1{font-size:clamp(3rem,5vw,5.5rem);color:var(--blue);margin:1rem 0 1.3rem}.family-hero>img{width:100%;max-width:480px;justify-self:center;mix-blend-mode:multiply}.family-hero p{line-height:1.8;max-width:60ch}.family-brand{font-size:.85rem;margin-top:1rem}.family-checks h2,.family-context h2,.family-siblings h2{font-size:clamp(2.2rem,3.5vw,3.3rem);color:var(--blue);margin:1rem 0 1.8rem}.family-checks ol{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:0;margin:0;gap:1.5rem}.family-checks li{padding:1.5rem;border-top:1px solid var(--blue);background:#edf2fc}.family-checks li span{font-size:.75rem;color:var(--blue)}.family-checks h3{font-size:1.6rem;margin-top:1rem}.family-context{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;padding-top:4rem}.family-context p{line-height:1.8}.family-note{font-size:.85rem;margin:1rem 0 1.5rem}.family-context figcaption{font-size:.75rem;margin-top:.8rem}.family-siblings>div{display:flex;flex-wrap:wrap;gap:.7rem}.family-siblings a{padding:1rem 1.3rem;border:1px solid var(--line);color:var(--blue);min-height:44px}.family-visit{padding:3rem 0 4rem}.family-visit>p{margin-bottom:1.5rem}@media(max-width:680px){.family-hero{grid-template-columns:1fr;gap:0;padding-top:1rem}.family-hero>img{max-width:250px}.family-checks ol{grid-template-columns:1fr;gap:.8rem}.family-checks li{display:flex;align-items:baseline;gap:1rem;padding:1.2rem}.family-checks h3{margin:0;font-size:1.4rem}.family-context{grid-template-columns:1fr;gap:1.5rem;padding-top:3rem}.family-siblings>div{display:grid;grid-template-columns:1fr}.family-visit{padding-top:2rem}}</style>
