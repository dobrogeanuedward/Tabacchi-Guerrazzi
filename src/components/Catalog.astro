---
import Base from '../layouts/Base.astro';import Icon from './Icon.astro';import {getProducts} from '../lib/store.mjs';import {pathFor,text} from '../data/shop';import {catalogAssortment,catalogGroups} from '../data/catalog-assortment';
const {lang='it'}=Astro.props;const category=Astro.url.searchParams.get('categoria')||'';const query=(Astro.url.searchParams.get('q')||'').slice(0,200);const all=getProducts({publicOnly:true});const products=all;const l=lang==='it'?0:1;const categories=[...catalogGroups,...(all.some((p:any)=>p.category==='accessori')?[{id:'accessori',it:'Accessori regalo',en:'Gift accessories'}]:[])];
const catalogSchema={'@context':'https://schema.org','@type':'ItemList',name:text(lang,'Famiglie di articoli del negozio','Shop item families'),itemListElement:catalogAssortment.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name[l],...(import.meta.env.PUBLIC_SITE_URL?{url:new URL(pathFor(`assortimento/${p.id}`,lang),import.meta.env.PUBLIC_SITE_URL).href}:{})}))};
const availability=(value:string)=>text(lang,{available:'Disponibile',unavailable:'Non disponibile','on-request':'Da verificare'}[value]||'Da verificare',{available:'Available',unavailable:'Unavailable','on-request':'Check availability'}[value]||'Check availability');
---
<Base lang={lang} slug="catalogo" title={text(lang,'Il catalogo del negozio','The shop catalogue')} description={text(lang,'Cartoleria, souvenir di Bologna, biglietti, giochi, cavi e dolciumi: esplora l’assortimento documentato di Guerrazzi in Via Guerrazzi 10/F.','Stationery, Bologna souvenirs, cards, toys, cables and sweets: explore Guerrazzi’s documented range at Via Guerrazzi 10/F.')} noindex={!!query||!!category} schema={catalogSchema}>
<div class="wrap"><header class="catalog-heading"><h1>{text(lang,'Una prima occhiata.','A first look.')}</h1><p>{text(lang,'Parti da quello che ti serve: una penna, un biglietto, un piccolo regalo. Qui trovi le famiglie di articoli viste nel negozio, con i dettagli da controllare prima di scegliere.','Start with what you need: a pen, a card, a small gift. Here are the item families observed in the shop, with details to check before choosing.')}</p></header>
<div class="catalog-controls" data-catalog-controls><nav class="category-tabs" aria-label={text(lang,'Categorie del catalogo','Catalogue categories')}><a class="category-tab" href={pathFor('catalogo',lang)} aria-current={!category?'page':undefined}>{text(lang,'Tutto','All')}</a>{categories.map(c=><a class="category-tab" href={`${pathFor('catalogo',lang)}?categoria=${c.id}`} aria-current={category===c.id?'page':undefined}>{lang==='it'?c.it:c.en}</a>)}</nav><form method="get" data-catalog-search><label class="sr-only" for="search">{text(lang,'Cerca un prodotto','Search products')}</label><input id="search" name="q" placeholder={text(lang,'Cerca nel catalogo','Search the catalogue')} value={query}/>{category&&<input type="hidden" name="categoria" value={category}/>}<button type="submit"><Icon name="search"/>{text(lang,'Cerca','Search')}</button></form></div>
<p class="catalog-note">{text(lang,'Assortimento di riferimento, non giacenza in tempo reale. Le immagini sono illustrazioni editoriali delle categorie; prezzi, modelli e disponibilità si verificano in negozio.','Reference range, not live inventory. Images are editorial category illustrations; check prices, models and availability in store.')}</p>
<p data-catalog-count aria-live="polite">{catalogAssortment.length+products.length} {text(lang,'schede da esplorare','listings to explore')}</p>
<div class="product-grid" data-catalog-grid>
 {catalogAssortment.map(p=><a class="product-card assortment-card" data-category={p.category} data-search={`${p.name.join(' ')} ${p.description.join(' ')} ${p.brand}`} href={pathFor(`assortimento/${p.id}`,lang)}><div class="product-image"><img src={`/brand/ui/${p.art}.webp`} width="600" height="600" loading="lazy" alt="" aria-hidden="true"/></div><p class="assortment-label">{text(lang,'Famiglia di articoli','Item family')}</p><h2>{p.name[l]}</h2>{p.brand&&<p>{p.brand}</p>}<p>{p.description[l]}</p><span class="availability">{text(lang,'Leggi la scheda','Read the record')}</span></a>)}
 {products.map((p:any)=><a class="product-card" data-category={p.category} data-search={`${p.nameIt} ${p.nameEn} ${p.brand} ${p.descriptionIt} ${p.descriptionEn}`} href={pathFor(`catalogo/${p.slug}`,lang)}><div class="product-image"><img src={p.image} width="900" height="900" loading="lazy" alt={lang==='it'?p.nameIt:p.nameEn}/></div><h2>{lang==='it'?p.nameIt:p.nameEn}</h2>{p.brand&&<p>{p.brand}</p>}<p class="availability">{availability(p.availability)}</p>{p.price!==null&&<p>{new Intl.NumberFormat(lang==='it'?'it-IT':'en-GB',{style:'currency',currency:'EUR'}).format(p.price)}</p>}</a>)}
</div>
<div class="catalog-empty" data-catalog-empty hidden><div><h2>{text(lang,'Un’altra parola, un’altra possibilità.','Another word, another possibility.')}</h2><p>{text(lang,'Prova il nome dell’articolo, del marchio o una categoria diversa.','Try an item name, a brand or a different category.')}</p><a class="button primary" href={pathFor('catalogo',lang)} data-catalog-reset>{text(lang,'Mostra tutto','Show all')}</a></div></div>
<noscript><p>{text(lang,'Tutto l’assortimento è visibile qui sotto. Attiva JavaScript per ricerca e filtri.','The full range is shown below. Enable JavaScript to search and filter.')}</p></noscript>

</div></Base>

<script>
 const controls=document.querySelector('[data-catalog-controls]');
 const cards=[...document.querySelectorAll<HTMLElement>('[data-catalog-grid] .product-card')];
 const input=document.querySelector<HTMLInputElement>('#search');const empty=document.querySelector<HTMLElement>('[data-catalog-empty]');const count=document.querySelector('[data-catalog-count]');
 const lang=document.documentElement.lang;const base=lang==='en'?'/en/catalogo/':'/catalogo/';
 const normal=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 const filter=()=>{const params=new URLSearchParams(location.search);const category=params.get('categoria')||'';const q=params.get('q')||'';if(input)input.value=q;let total=0;
 cards.forEach(card=>{const match=(!category||card.dataset.category===category)&&normal(card.dataset.search||'').includes(normal(q));card.hidden=!match;if(match)total++});
 controls?.querySelectorAll<HTMLAnchorElement>('.category-tab').forEach(a=>{const selected=(new URL(a.href).searchParams.get('categoria')||'')===category;if(selected)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});
 if(empty)empty.hidden=total!==0;if(count)count.textContent=total+' '+(lang==='en'?'listings to explore':'schede da esplorare');};
 const navigate=(params:URLSearchParams)=>{history.pushState({},'',base+(params.size?'?'+params.toString():''));filter()};
 controls?.querySelectorAll<HTMLAnchorElement>('.category-tab').forEach(a=>a.addEventListener('click',e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();const p=new URLSearchParams(location.search);const category=new URL(a.href).searchParams.get('categoria');if(category)p.set('categoria',category);else p.delete('categoria');navigate(p)}));
 document.querySelector('[data-catalog-search]')?.addEventListener('submit',e=>{e.preventDefault();const p=new URLSearchParams(location.search);const q=(input?.value||'').trim();if(q)p.set('q',q);else p.delete('q');navigate(p)});
 document.querySelector('[data-catalog-reset]')?.addEventListener('click',e=>{e.preventDefault();navigate(new URLSearchParams())});
 window.addEventListener('popstate',filter);filter();
</script>
<style>
 .catalog-note{max-width:75ch;line-height:1.7;margin:2rem 0;color:#4d5560}
 [data-catalog-count]{margin:1.5rem 0}
 .assortment-card .product-image{background:linear-gradient(145deg,#edf3ff,#fff);padding:1rem}
 .assortment-card .product-image img{object-fit:contain}
 .assortment-label{font-size:.8rem;color:#0645c0;margin-top:1rem}
 .assortment-card>p{line-height:1.65}
 [data-catalog-grid] .product-card[hidden],[data-catalog-empty][hidden]{display:none!important}
</style>
