---
import Base from '../layouts/Base.astro';import {getProducts} from '../lib/store.mjs';import {categories,pathFor,text} from '../data/shop';
const {lang='it'}=Astro.props;const category=Astro.url.searchParams.get('categoria')||'';const query=(Astro.url.searchParams.get('q')||'').slice(0,200);const all=getProducts({publicOnly:true});const products=all.filter((p:any)=>(!category||p.category===category)&&(!query||`${p.nameIt} ${p.nameEn} ${p.brand} ${p.descriptionIt} ${p.descriptionEn}`.toLowerCase().includes(query.toLowerCase())));
const availability=(value:string)=>text(lang,{available:'Disponibile',unavailable:'Non disponibile','on-request':'Da verificare'}[value]||'Da verificare',{available:'Available',unavailable:'Unavailable','on-request':'Check availability'}[value]||'Check availability');
---
<Base lang={lang} slug="catalogo" title={text(lang,'Il catalogo del negozio','The shop catalogue')} description={text(lang,'Giochi e idee regalo: le schede pubblicate da Guerrazzi, con informazioni e disponibilità da verificare in negozio.','Games and gift ideas: listings published by Guerrazzi, with details and availability to check in store.')} noindex={!!query||!!category}>
<div class="wrap"><header class="catalog-heading"><h1>{text(lang,'Una prima occhiata.','A first look.')}</h1><p>{text(lang,'Sfoglia le schede del negozio. Se qualcosa ti incuriosisce, verifica la disponibilità e vieni a vederlo dal vivo.','Browse the shop listings. If something catches your eye, check availability and come see it in person.')}</p></header>
<div class="catalog-controls"><nav class="category-tabs" aria-label={text(lang,'Categorie del catalogo','Catalogue categories')}><a class="category-tab" href={pathFor('catalogo',lang)} aria-current={!category?'page':undefined}>{text(lang,'Tutto','All')}</a>{categories.map(c=><a class="category-tab" href={`${pathFor('catalogo',lang)}?categoria=${c.id}`} aria-current={category===c.id?'page':undefined}>{lang==='it'?c.it:c.en}</a>)}</nav><form method="get"><label class="sr-only" for="search">{text(lang,'Cerca un prodotto','Search products')}</label><input id="search" name="q" placeholder={text(lang,'Cerca nel catalogo','Search the catalogue')} value={query}/>{category&&<input type="hidden" name="categoria" value={category}/>}<button type="submit">{text(lang,'Cerca','Search')}</button></form></div>
{products.length?<><p style="margin-bottom:30px">{products.length} {text(lang,products.length===1?'prodotto':'prodotti',products.length===1?'item':'items')}</p><div class="product-grid">{products.map((p:any)=><a class="product-card" href={pathFor(`catalogo/${p.slug}`,lang)}><div class="product-image"><img src={p.image} width="900" height="900" loading="lazy" alt={lang==='it'?p.nameIt:p.nameEn}/></div><h2>{lang==='it'?p.nameIt:p.nameEn}</h2>{p.brand&&<p>{p.brand}</p>}<p class="availability">{availability(p.availability)}</p>{p.price!==null&&<p>{new Intl.NumberFormat(lang==='it'?'it-IT':'en-GB',{style:'currency',currency:'EUR'}).format(p.price)}</p>}</a>)}</div></>:<div class="catalog-empty"><img src={category==='giochi'?'/images/games.webp':'/images/gifts.webp'} width="1536" height="1024" alt={text(lang,'Composizione fotografica di un piccolo regalo','Editorial photograph of a small gift')}/><div><h2>{text(lang,all.length?'Nessun risultato, altre possibilità.':'La scelta continua in negozio.',all.length?'No results, more possibilities.':'The choice continues in store.')}</h2><p>{text(lang,all.length?'Prova un’altra parola oppure guarda tutte le categorie.':'Le schede dei prodotti sono in preparazione. Puoi già scoprire le idee regalo e i giochi, oppure passare dalla vetrina.',all.length?'Try another word or browse all categories.':'Product listings are being prepared. You can already explore gift ideas and toys, or stop by the shop window.')}</p><a class="button primary" href={all.length?pathFor('catalogo',lang):pathFor('contatti',lang)}>{text(lang,all.length?'Mostra tutto':'Vieni a trovarci',all.length?'Show all':'Visit us')}</a></div></div>}
</div></Base>
