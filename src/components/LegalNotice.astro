---
import {dependenceSupport,legalNotices,type LegalNoticeKind} from '../data/tobacco-information';
import type {Lang} from '../data/shop';
const {kind='tobacco',lang='it'}=Astro.props as {kind?:LegalNoticeKind;lang?:Lang};
const notice=legalNotices[kind];
const l=lang==='en'?1:0;
---
<aside class="legal-notice" aria-label={notice.title[l]}>
 <h2>{notice.title[l]}</h2>
 {notice.paragraphs.map(paragraph=><p>{paragraph[l]}</p>)}
 <p class="legal-notice-support">{dependenceSupport.label[l]}: <a href={`tel:${dependenceSupport.phone}`}>{dependenceSupport.number}</a>.</p>
 <p class="legal-notice-source"><a href={notice.source.url} target="_blank" rel="noopener">{notice.source.label[l]}</a>{kind!=='gambling'&&<> · <a href={dependenceSupport.url} target="_blank" rel="noopener">{lang==='en'?'ISS support service':'Il servizio di sostegno ISS'}</a></>}</p>
</aside>
<style>
 .legal-notice{margin-block:2rem;padding:1.5rem;border-block:1px solid var(--line);background:var(--paper,#faf7f0);max-width:78ch;color:#33435b}
 .legal-notice h2{font:400 1.5rem/1.3 var(--display);color:var(--blue);margin:0 0 1rem}
 .legal-notice p{font:400 .95rem/1.8 var(--sans);margin:0 0 .8rem}
 .legal-notice p:last-child{margin-bottom:0}.legal-notice a{text-decoration:underline;text-underline-offset:.18em;overflow-wrap:anywhere}
 .legal-notice a:focus-visible{outline:2px solid var(--blue);outline-offset:4px}
</style>
