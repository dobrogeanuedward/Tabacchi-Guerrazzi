---
import NeighborhoodLinks from './NeighborhoodLinks.astro';
import Base from '../layouts/Base.astro';import {guides,pages} from '../data/pages';import {pathFor,text,type Lang,mainPages} from '../data/shop';
import {guideCategoryLinks} from '../data/category-pathways';
import {tobaccoGuides} from '../data/tobacco-information';import {materialGuides} from '../data/materials-education';
import {visualForGuide} from '../data/editorial-visuals';
import OfficialSources from './OfficialSources.astro';import EditorialArt from './EditorialArt.astro';import ReadingIndex from './ReadingIndex.astro';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};const g=guides[slug];const l=lang==='it'?0:1;
const categories=(guideCategoryLinks[slug]||[]).map(s=>mainPages.find(p=>p.slug===s)).filter(Boolean);
const researchGuide=Object.prototype.hasOwnProperty.call(materialGuides,slug);
const technicalGuide=slug==='tipologie-di-sigaro';
const informationGuide=researchGuide||Object.prototype.hasOwnProperty.call(tobaccoGuides,slug);
const theme=pages[g.parent]?.theme||'utility';const visual=visualForGuide(slug);
const parentPage=mainPages.find(p=>p.slug===g.parent);
const parentLabel=parentPage?(lang==='it'?parentPage.it:parentPage.en):text(lang,'Informazioni','Information');
const domain=import.meta.env.PUBLIC_SITE_URL;
const schema=informationGuide?{'@context':'https://schema.org','@type':'Article',headline:g.title[l],description:g.intro[l],inLanguage:lang,isAccessibleForFree:true,citation:(g.sources||[]).map((s:any)=>s.url),...(domain?{url:new URL(pathFor('schede/'+slug,lang),domain).href}:{}),author:{'@type':'Organization',name:'Tabaccheria Guerrazzi di Angela'}}:undefined;
const readingMinutes=Math.max(1,Math.ceil([g.intro[l],...g.sections.flatMap((s:any)=>[s[0][l],s[1][l]])].join(' ').trim().split(/\s+/).length/190));
const indexEntries=g.sections.map((s:any,i:number)=>({href:'#informazione-'+i,title:s[0][l]}));
---
<Base image={visual.src} schema={schema} title={g.title[l]} description={g.intro[l]} lang={lang} slug={'schede/'+slug} theme={theme}>
<div class="reference-document">
 <div class="breadcrumb wrap"><a href={pathFor('',lang)}>Home</a><span>/</span><a href={pathFor(g.parent,lang)}>{parentLabel}</a></div>
 <header class="reference-cover wrap">
  <div class="reference-cover-copy">
   <p class="reference-kind">{informationGuide?text(lang,'Guida informativa','Information guide'):text(lang,'Guida pratica','Practical guide')}{informationGuide&&<span>18+</span>}</p>
   <p class="reference-category">{parentLabel}</p>
   <h1>{g.title[l]}</h1>
   <p class="reference-summary">{g.intro[l]}</p>
   <div class="reference-meta"><span>{readingMinutes} {text(lang,'min di lettura','min read')}</span></div>
   <a class="reference-start" href="#informazione-0">{text(lang,'Leggi la guida','Read the guide')} </a>
  </div>
  <div class="reference-cover-art"><EditorialArt visual={visual} lang={lang} loading="eager"/></div>
 </header>
 <div class="reference-reading wrap">
  <ReadingIndex entries={indexEntries} title={text(lang,'In questa guida','In this guide')} lang={lang}/>
  <article class="reference-content">
   {g.sections.map((s:any,i:number)=><section id={'informazione-'+i} class:list={['reference-section',i===0&&'reference-section--opening']}>
    <div><h2>{s[0][l]}</h2><p>{s[1][l]}</p></div>
   </section>)}
   {categories.length>0&&<section class="reference-related"><p class="reference-section-label">{text(lang,'Ti può interessare','You might also like')}</p><h2>{informationGuide?text(lang,'Continua a leggere.','Keep reading.'):text(lang,'Da Angela trovi anche.','Also at Angela’s.')}</h2><div class="reference-related-grid">{categories.map(p=><a href={pathFor(p!.slug,lang)}><span class="reference-link-type">{informationGuide?text(lang,'Area informativa','Information area'):text(lang,'Categoria','Category')}</span><strong>{lang==='it'?p!.it:p!.en}</strong><span class="reference-link-action">{informationGuide?text(lang,'Apri l’area','Open the area'):text(lang,'Esplora la categoria','Explore the category')} </span></a>)}</div></section>}
   <OfficialSources sources={g.sources||[]} lang={lang} research={researchGuide} technical={technicalGuide} checked={researchGuide||technicalGuide?'11 ottobre 2026':undefined}/>
   {informationGuide?<div class="reference-return"><a href={pathFor(g.parent,lang)}>{text(lang,'Torna all’area informativa','Back to the information area')}</a></div>:<div class="reference-visit"><div><p class="reference-section-label">{text(lang,'Ti aspettiamo','See you here')}</p><h2>{text(lang,'Parliamone da vicino.','Let’s talk in person.')}</h2><p>{text(lang,'Porta la tua domanda in Via Guerrazzi 10/F. Cominciamo da lì.','Bring your question to Via Guerrazzi 10/F. We will start there.')}</p></div><a class="button primary" href={pathFor('contatti',lang)}>{text(lang,'Informazioni per la visita','Plan your visit')}</a></div>}
  </article>
 </div>
</div>
{!informationGuide&&<div class="wrap"><NeighborhoodLinks topic={g.parent} lang={lang}/></div>}
</Base>
<style>
 .reference-document{--reference-line:color-mix(in srgb,var(--accent) 25%,#ded6c8);color:var(--ink)}
 .reference-document .breadcrumb{display:flex;flex-wrap:wrap;gap:10px;font-size:.95rem;line-height:1.6}
 .reference-cover{display:grid;grid-template-columns:minmax(0,1.07fr) minmax(0,.93fr);gap:64px;align-items:center;padding-block:25px 50px;border-bottom:1px solid var(--reference-line)}
 .reference-cover-copy{min-width:0}
 .reference-kind{display:flex;align-items:center;flex-wrap:wrap;gap:15px;font:600 .95rem/1.6 var(--sans);color:var(--accent);margin-bottom:24px}
 .reference-kind::before{content:'';width:34px;height:3px;background:var(--accent)}
 .reference-kind>span{border:1px solid currentColor;padding:2px 9px;font-size:.95rem;line-height:1.4}
 .reference-category{font:400 .95rem/1.6 var(--sans);color:#686157;margin-bottom:14px}
 .reference-cover h1{font:400 clamp(2.6rem,4.5vw,4.4rem)/1.06 var(--display);letter-spacing:-.04em;color:var(--accent);max-width:21ch;margin:0 0 28px}
 .reference-summary{max-width:57ch;padding-left:20px;border-left:2px solid var(--accent);font:400 1.1rem/1.85 var(--sans);color:var(--ink)}
 .reference-meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:24px;font-size:.95rem;line-height:1.6;color:#686157}
 .reference-meta>span+span{padding-left:22px;border-left:1px solid var(--reference-line)}
 .reference-start{display:inline-flex;align-items:center;gap:35px;min-height:44px;margin-top:20px;border-bottom:1px solid var(--accent);font:600 .95rem/1.6 var(--sans);color:var(--accent)}
 .reference-start>span{font-size:1.25rem}.reference-cover-art{min-width:0;padding-top:18px}
 .reference-reading{display:grid;grid-template-columns:240px minmax(0,1fr);gap:72px;padding-block:54px 75px;align-items:start}
 .reference-content{min-width:0}
 .reference-section{display:grid;grid-template-columns:minmax(0,1fr);gap:22px;padding:30px 0;border-top:1px solid var(--reference-line);scroll-margin-top:30px}
 .reference-section--opening{padding:30px;margin-bottom:12px;border-top:3px solid var(--accent);background:color-mix(in srgb,var(--surface) 62%,#fffdf8)}
 .reference-section-number{font:400 2.85rem/1 var(--display);color:var(--accent);letter-spacing:-.04em;padding-top:2px}
 .reference-section h2,.reference-related h2,.reference-visit h2{font:400 clamp(1.9rem,2.7vw,2.7rem)/1.15 var(--display);letter-spacing:-.025em;color:var(--accent);margin-bottom:20px}
 .reference-section p{font-size:1.05rem;line-height:1.95;max-width:67ch;margin:0}
 .reference-related{margin-top:30px;padding-top:30px;border-top:2px solid var(--accent)}
 .reference-section-label{font:600 .95rem/1.6 var(--sans);color:var(--accent);margin-bottom:14px}
 .reference-related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin-top:28px}
 .reference-related-grid>a{display:flex;min-width:0;flex-direction:column;gap:14px;padding:23px 0;border-top:1px solid var(--reference-line);color:var(--accent)}
 .reference-related-grid strong{font:400 1.65rem/1.2 var(--display)}
 .reference-link-type{font-size:.95rem;line-height:1.6;color:#686157}
 .reference-link-action{display:flex;justify-content:space-between;gap:20px;margin-top:auto;font:600 .95rem/1.6 var(--sans)}
 .reference-related-grid>a:hover .reference-link-action{text-decoration:underline;text-underline-offset:4px}
 .reference-visit{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;margin-top:35px;padding:30px;border-top:2px solid var(--accent);background:var(--surface)}
 .reference-visit h2{margin-bottom:13px}.reference-visit p:not(.reference-section-label){font-size:1rem;line-height:1.8}.reference-visit .button{font-size:.95rem}
 .reference-return{padding-top:25px;margin-top:35px;border-top:1px solid var(--reference-line)}
 .reference-return a{display:inline-flex;align-items:center;gap:14px;min-height:44px;color:var(--accent);font-size:.95rem;text-decoration:underline;text-underline-offset:4px}
 @media(max-width:1100px){.reference-cover{gap:35px;grid-template-columns:1.1fr .9fr}.reference-reading{grid-template-columns:210px minmax(0,1fr);gap:35px}.reference-section--opening{padding:25px}.reference-section{grid-template-columns:minmax(0,1fr);gap:17px}}
 @media(max-width:820px){.reference-cover{grid-template-columns:1fr;gap:30px;padding-bottom:35px}.reference-cover h1{max-width:24ch}.reference-cover-art{max-width:620px;width:100%;justify-self:end;padding-top:0}.reference-reading{grid-template-columns:1fr;gap:34px;padding-block:35px 55px}.reference-cover h1{font-size:clamp(2.6rem,7.4vw,3.8rem)}}
 @media(max-width:520px){.reference-cover{padding-top:12px}.reference-kind{margin-bottom:20px}.reference-summary{font-size:1rem;padding-left:16px}.reference-meta{gap:8px 15px}.reference-meta>span+span{padding-left:15px}.reference-section{grid-template-columns:minmax(0,1fr);gap:12px;padding-block:25px}.reference-section--opening{padding:22px 17px}.reference-section-number{font-size:2.1rem}.reference-section h2{font-size:1.95rem}.reference-section p{font-size:1rem;line-height:1.9}.reference-related-grid{grid-template-columns:1fr;gap:0}.reference-visit{padding:24px}.reference-visit .button{width:100%}}
 @media(max-width:370px){.reference-meta{display:grid;gap:5px}.reference-meta>span+span{padding:0;border:0}.reference-cover h1{font-size:2.5rem}.reference-kind{gap:10px}.reference-kind::before{width:22px}}
</style>
