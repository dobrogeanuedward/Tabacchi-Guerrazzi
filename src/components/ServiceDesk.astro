---
import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};
const guides=[{slug:'ricariche-telefoniche',title:['Numero, operatore e ricevuta','Phone number, network and transaction record']},{slug:'bollettini-e-pagopa',title:['Bollettino o pagoPA: prepara il documento','Bills or pagoPA: prepare the document']}];
---
<section id="page-guides" class="service-desk" aria-labelledby="service-desk-title"><header><p class="section-label">{text(lang,'Prima di passare','Before visiting')}</p><h2 id="service-desk-title">{text(lang,'Le guide per preparare la visita.','Guides to prepare your visit.')}</h2><p>{text(lang,'Le pagine dei servizi indicano cosa trovi al banco. Qui puoi approfondire i dati e i documenti da avere pronti.','The service pages describe what is available at the counter. These guides go into the details and documents to have ready.')}</p></header><nav aria-label={text(lang,'Guide pratiche ai servizi','Practical service guides')}>{guides.map(guide=><a class="text-link" href={pathFor(`schede/${guide.slug}`,lang)}>{guide.title[lang==='it'?0:1]}</a>)}</nav></section>
<style>
.service-desk{margin:35px 0 55px;padding-block:28px;border-block:1px solid var(--line);scroll-margin-top:30px}.service-desk header{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);align-items:end;gap:15px 40px}.service-desk .section-label{grid-column:1/-1;margin:0}.service-desk h2{font:400 clamp(1.8rem,2.6vw,2.4rem)/1.2 var(--display);color:var(--blue)}.service-desk header>p:last-child{font-size:.95rem;line-height:1.85;color:var(--ink)}.service-desk nav{display:flex;flex-wrap:wrap;gap:18px 30px;margin-top:25px}@media(max-width:680px){.service-desk header{grid-template-columns:1fr}.service-desk nav{flex-direction:column;align-items:flex-start}}
</style>