---
import {guides} from '../data/pages';import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};const l=lang==='it'?0:1;
const services=[{slug:'ricariche-telefoniche',title:['Ricariche telefoniche','Mobile top-ups'],ready:['Numero, operatore e importo.','Number, network and amount.']},{slug:'bollettini-e-pagopa',title:['Bollettini e pagoPA','Bills and pagoPA'],ready:['Avviso completo e leggibile.','Complete, legible notice.']}];
---
<section id="page-guides" class="service-desk" aria-labelledby="service-desk-title"><header><p class="section-label">{text(lang,'Prima di una richiesta','Before making a request')}</p><h2 id="service-desk-title">{text(lang,'Numero o avviso: cosa preparare.','Phone number or notice: what to prepare.')}</h2><p>{text(lang,'Queste guide aiutano a preparare numero e documenti. Per un operatore telefonico o un avviso specifico, verifica prima con il negozio se la richiesta può essere gestita.','These guides help you prepare numbers and documents. For a particular mobile network or payment notice, first ask the shop whether the request can be processed.')}</p></header><div class="service-desk-grid">{services.map((s,i)=><a class="guide-link service-card" href={pathFor(`schede/${s.slug}`,lang)}><div class="service-card-top"><span class="card-kind">{text(lang,'Guida pratica','Practical guide')}</span>{s.slug==='bollettini-e-pagopa'?<span class="pagopa-mark"><img src="/brand/partners/pagopa-official.svg" width="95" height="34" alt="pagoPA" loading="lazy"/></span>:<span class="service-card-number" aria-hidden="true">0{i+1}</span>}</div><h3>{s.title[l]}</h3><p class="service-intro">{guides[s.slug].intro[l]}</p><div class="service-ready"><span>{text(lang,'Da avere con te','Have it ready')}</span><strong>{s.ready[l]}</strong></div><span class="service-open">{text(lang,'Apri la guida','Open the guide')} </span></a>)}</div></section>
<style>
.pagopa-mark{display:inline-flex;background:#0645c0;padding:10px 14px}.pagopa-mark img{width:95px;height:34px;object-fit:contain}
 .service-desk{margin:45px 0 55px;scroll-margin-top:30px}.service-desk>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);align-items:end;gap:16px 55px;margin-bottom:30px}.service-desk .section-label{grid-column:1/-1;margin:0}.service-desk h2{font:400 clamp(2.1rem,3.2vw,3rem)/1.16 var(--display);letter-spacing:-.025em;color:var(--blue);max-width:25ch}.service-desk>header>p:last-child{font:400 .95rem/1.85 var(--sans);color:#42516a;max-width:62ch}.service-desk-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.service-card{display:flex;flex-direction:column;padding:28px 30px;border:1px solid #b5c3da;background:linear-gradient(#f8f5eceb,#f8f5eceb),url('/images/materials/paper-768.webp') center/cover}.service-card-top{display:flex;justify-content:space-between;gap:30px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:24px}.service-card-number{font:400 3.6rem/1 var(--display);letter-spacing:-.04em;color:var(--blue)}.service-card .card-kind{font:600 .95rem/1.6 var(--sans)}.service-card h3{font:400 2.2rem/1.15 var(--display);color:var(--blue);margin:0 0 18px}.service-card .service-intro{font:400 1rem/1.8 var(--sans);color:#33435b;margin:0 0 25px;max-width:56ch}.service-ready{margin:auto 0 25px;padding:18px 20px;border-left:3px solid var(--blue);background:#e9eef6}.service-ready>span{display:block;font:.95rem/1.6 var(--sans);color:#42516a;margin-bottom:6px}.service-ready strong{font:600 1rem/1.7 var(--sans);color:#243957}.service-open{display:flex;justify-content:space-between;gap:18px;border-top:1px solid var(--line);padding-top:18px;font:600 .95rem/1.6 var(--sans);color:var(--blue)}.service-card:hover{border-color:var(--blue);background:#eef2f8}.service-card:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
 @media(max-width:680px){.service-desk>header,.service-desk-grid{grid-template-columns:minmax(0,1fr)}.service-desk>header{gap:18px}.service-card{padding:24px}.service-card-number{font-size:3rem}.service-card h3{font-size:2rem}}
</style>
