---
import Base from '../layouts/Base.astro';import BrandSignature from './BrandSignature.astro';
import {neighborhoodAreas,neighborhoodServices,walkingDirections} from '../data/neighborhood';
import {shop,pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};const l=lang==='it'?0:1;
const faqs=[
 [text(lang,'Dove si trova Guerrazzi rispetto a Santo Stefano?','Where is Guerrazzi in relation to Santo Stefano?'),text(lang,'Siamo in Via Guerrazzi 10/F, la strada che collega Via Santo Stefano a Strada Maggiore. Da Via Santo Stefano imbocca Via Guerrazzi e cerca il civico 10/F.','We are at Via Guerrazzi 10/F, on the road linking Via Santo Stefano to Strada Maggiore. From Via Santo Stefano, turn into Via Guerrazzi and look for 10/F.')],
 [text(lang,'Come arrivo da Piazza Aldrovandi?','How do I get here from Piazza Aldrovandi?'),text(lang,'Raggiungi l’estremità della piazza verso Strada Maggiore e continua in Via Guerrazzi fino al 10/F. I link del percorso aprono le indicazioni a piedi.','Reach the end of the square towards Strada Maggiore, then continue along Via Guerrazzi to 10/F. The route links open walking directions.')],
 [text(lang,'Il deposito Bounce è dentro la tabaccheria?','Is Bounce storage inside the tobacconist’s shop?'),text(lang,'Sì. Il deposito bagagli è dentro Tabaccheria Guerrazzi di Angela, in Via Guerrazzi 10/F. Su Bounce trovi lo stesso indirizzo con il nome “Palazzo Ercolani”.','Yes. Luggage storage is inside Tabaccheria Guerrazzi di Angela at Via Guerrazzi 10/F. Bounce lists the same address under “Palazzo Ercolani”.')]
];
---
<Base lang={lang} slug="il-quartiere" theme="bottega" title={text(lang,'Via Guerrazzi, Santo Stefano e Strada Maggiore: il nostro quartiere a Bologna','Via Guerrazzi, Santo Stefano and Strada Maggiore: our Bologna neighbourhood')} description={text(lang,'Da Piazza Aldrovandi, San Petronio Vecchio e Santa Maria dei Servi a Via Guerrazzi 10/F: percorsi a piedi, servizi, regali e deposito Bounce da Angela.','Walking routes from Piazza Aldrovandi, San Petronio Vecchio and Santa Maria dei Servi to Via Guerrazzi 10/F: services, gifts and Bounce storage at Angela’s.')} image="/images/hero/portico.webp" schema={{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}}>
 <div class="wrap neighborhood-page"><header class="neighborhood-opening"><div><p class="eyebrow">{text(lang,'Bologna, da Angela','Bologna, at Angela’s')}</p><h1>{text(lang,'Una bottega. Le strade di ogni giorno.','One shop. The streets of everyday life.')}</h1><p>{text(lang,'Siamo in Via Guerrazzi 10/F, tra Via Santo Stefano e Strada Maggiore. C’è chi arriva per una commissione, chi cerca un regalo e chi lascia le valigie prima di continuare a conoscere Bologna.','We are at Via Guerrazzi 10/F, between Via Santo Stefano and Strada Maggiore. Some people stop for an errand, others for a gift or to leave their bags before exploring Bologna.')}</p><a class="button primary" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Portami da Angela','Take me to Angela’s')}</a></div><img src="/images/hero/portico.webp" width="1672" height="940" alt={text(lang,'La vetrina Guerrazzi sotto il portico','Guerrazzi’s shop window beneath the portico')} fetchpriority="high"/></header>
 <nav class="neighborhood-index" aria-label={text(lang,'Le strade del quartiere','Neighbourhood streets')}>{neighborhoodAreas.map(area=><a href={'#'+area.id}>{area.name}</a>)}</nav>
 <section class="neighborhood-services"><h2>{text(lang,'Per cosa puoi fermarti.','What you can stop for.')}</h2><div>{neighborhoodServices.map(service=><a href={pathFor(service.slug,lang)}><h3>{service.name[l]}</h3><p>{service.description[l]}</p><span>{text(lang,'Scopri di più','Find out more')}</span></a>)}</div></section>
 <div class="neighborhood-areas">{neighborhoodAreas.map(area=><section id={area.id}><div><p class="eyebrow">{text(lang,'Da qui alla bottega','From here to the shop')}</p><h2>{area.name}</h2></div><div><p>{area.intro[l]}</p><p class="neighborhood-route">{area.route[l]}</p><a class="text-link" href={walkingDirections(area)} target="_blank" rel="noopener">{text(lang,'Apri il percorso a piedi','Open walking directions')}</a><nav aria-label={`${text(lang,'Servizi vicino a','Services near')} ${area.name}`}>{neighborhoodServices.map(service=><a href={pathFor(service.slug,lang)}>{service.name[l]}</a>)}</nav></div></section>)}</div>
 <section class="faq neighborhood-faq"><h2>{text(lang,'Due indicazioni, prima di uscire.','A few pointers before heading out.')}</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
 <div class="neighborhood-signature"><BrandSignature lang={lang}/><p>{shop.address}, {shop.postcode} {shop.city}</p></div>
 <p class="neighborhood-references"><a href="https://www.bolognawelcome.com/it/luoghi/edifici-religiosi/chiesa-di-santa-maria-dei-servi" target="_blank" rel="noopener">{text(lang,'Santa Maria dei Servi · Bologna Welcome','Santa Maria dei Servi · Bologna Welcome')}</a></p>
 </div>
</Base>
<style>
 .neighborhood-page{padding-bottom:55px}.neighborhood-opening{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:50px;padding:35px 0 45px}.neighborhood-opening h1{font:400 clamp(2.9rem,4.8vw,4.4rem)/1.08 var(--display);color:var(--blue);margin:18px 0 24px;max-width:16ch}.neighborhood-opening p{max-width:58ch;line-height:1.85}.neighborhood-opening .button{margin-top:24px}.neighborhood-opening img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:3px}.neighborhood-index{display:flex;flex-wrap:wrap;gap:10px 24px;padding-block:22px;border-block:1px solid var(--line)}.neighborhood-index a{min-height:44px;display:flex;align-items:center;color:var(--blue);font-weight:600;font-size:.95rem}.neighborhood-services{padding-block:45px}.neighborhood-services h2,.neighborhood-areas h2,.neighborhood-faq h2{font:400 clamp(2rem,3vw,2.8rem)/1.15 var(--display);color:var(--blue);margin-bottom:24px}.neighborhood-services>div{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.neighborhood-services a{display:flex;flex-direction:column;padding:25px;border-top:2px solid var(--blue);background:var(--surface);color:var(--ink)}.neighborhood-services h3{font:400 1.8rem/1.2 var(--display);color:var(--blue);margin:0 0 15px}.neighborhood-services p{font-size:.95rem;line-height:1.8}.neighborhood-services span{margin-top:auto;padding-top:18px;font-weight:600;color:var(--blue);font-size:.95rem}.neighborhood-areas>section{display:grid;grid-template-columns:.8fr 1.2fr;gap:55px;padding-block:38px;border-top:1px solid var(--line);scroll-margin-top:28px}.neighborhood-areas .eyebrow{margin-bottom:15px}.neighborhood-areas p{line-height:1.9;max-width:66ch}.neighborhood-route{margin-top:15px;font-weight:600}.neighborhood-areas .text-link{margin-top:15px}.neighborhood-areas nav{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:22px}.neighborhood-areas nav a{display:inline-flex;align-items:center;min-height:44px;color:var(--blue);font-size:.9rem;text-decoration:underline;text-underline-offset:4px}.neighborhood-faq{padding-block:40px}.neighborhood-signature{padding-top:25px;border-top:1px solid var(--line)}.neighborhood-signature p{margin-top:16px}.neighborhood-references{font-size:.85rem;margin-top:30px}.neighborhood-references a{text-decoration:underline;text-underline-offset:3px}@media(max-width:850px){.neighborhood-opening,.neighborhood-areas>section{grid-template-columns:1fr;gap:25px}.neighborhood-services>div{grid-template-columns:1fr 1fr}.neighborhood-opening img{max-height:380px}}@media(max-width:520px){.neighborhood-services>div{grid-template-columns:1fr}.neighborhood-opening h1{font-size:2.9rem}.neighborhood-areas>section{padding-block:30px}.neighborhood-index{gap:2px 18px}}
</style>
