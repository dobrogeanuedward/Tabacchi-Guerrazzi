---
import {accessoryRecords} from '../data/counter-archive';
import {text,pathFor,type Lang} from '../data/shop';
import CommonsPhoto from './CommonsPhoto.astro';
import OfficialSources from './OfficialSources.astro';
const {kind,lang='it'}=Astro.props as {kind:'pipe'|'accessories'|'other';lang:Lang};const l=lang==='it'?0:1;
const lighterRecords=accessoryRecords.filter(item=>['clipper-metallo','clipper-lupin'].includes(item.id));
const museumSource={label:'Ministero della Cultura — Museo storico e scientifico del tabacco, San Giustino',url:'https://cultura.gov.it/luogo/museo-storico-e-scientifico-del-tabacco'};
const buendeSource={label:'Stadt Bünde — museo cittadino e Tabak- und Zigarrenmuseum',url:'https://www.buende.de/Freizeit-I-Tourismus/Museum/'};
---
<section class="counter-archive" aria-labelledby={'archive-'+kind}>
 {kind==='pipe'&&<><header><p class="section-label">{text(lang,'Oggetti, materiali e documenti · 18+','Objects, materials and documents · 18+')}</p><h2 id={'archive-'+kind}>{text(lang,'Dall’oggetto alla sua storia.','From an object to its history.')}</h2><p>{text(lang,'Il materiale di una pipa, la sua datazione e il contenuto di una confezione sono informazioni diverse. Le schede museali descrivono esemplari identificati: aiutano a leggere gli oggetti, senza attribuire quelle caratteristiche a ogni articolo del negozio.','A pipe’s material, its date and a pack’s contents are different information. Museum records describe identified specimens; they help interpret objects without attributing those characteristics to every shop item.')}</p></header><div class="archive-essays"><article><h3>{text(lang,'Argilla, legno e parti distinte','Clay, wood and separate components')}</h3><p>{text(lang,'Un fornello in argilla del British Museum e una pipa composita dello Smithsonian documentano due casi diversi. La loro lettura mette in evidenza l’importanza di distinguere il corpo, il bocchino e le altre parti prima di parlare di un materiale.','A British Museum clay bowl and a composite Smithsonian pipe document two different cases. Reading their records shows why the body, mouthpiece and other components must be distinguished before attributing a material.')}</p><a href={pathFor('schede/pipe-materiali-storia',lang)}>{text(lang,'Le due schede museali e le fonti','The two museum records and their sources')}</a></article><article><h3>{text(lang,'Radica e schiuma di mare','Briar and meerschaum')}</h3><p>{text(lang,'Radica è una denominazione da collegare alla struttura legnosa della pianta; schiuma di mare è un nome del lessico mineralogico. Fotografia e colore non bastano a identificarli in un esemplare.','Briar is a term connected with a plant’s woody structure; meerschaum belongs to mineral terminology. A photograph and colour alone cannot identify either material in a particular specimen.')}</p><a href={pathFor('schede/radica-erica-arborea',lang)}>{text(lang,'La struttura botanica della radica','The botanical structure of briar')}</a><a href={pathFor('schede/schiuma-di-mare-sepiolite',lang)}>{text(lang,'Il nome mineralogico della sepiolite','The mineral name sepiolite')}</a></article></div></>}
 {kind==='other'&&<><header><p class="section-label">{text(lang,'Storia del lavoro · 18+','Labour history · 18+')}</p><h2 id={'archive-'+kind}>{text(lang,'Una filiera raccontata nei musei.','An industry documented in museums.')}</h2></header><div class="archive-essays"><article><p>{text(lang,'Il Museo storico e scientifico del tabacco di San Giustino occupa un edificio dell’ex Consorzio Tabacchicoltori. La scheda del Ministero della Cultura distingue coltivazione, selezione e trattamento delle foglie, poi manifattura. Il percorso riguarda anche il ruolo economico della lavorazione nel territorio: un modo per seguire persone, strutture e trasformazioni del lavoro.','San Giustino’s Historical and Scientific Tobacco Museum occupies a former tobacco growers’ consortium building. The Italian Ministry of Culture’s record distinguishes cultivation, leaf selection and treatment, then manufacturing. It also documents the local economic role of this work, following people, buildings and changes in employment.')}</p><p>{text(lang,'La fotografia mostra invece il museo del tabacco e dei sigari di Bünde, in Germania: un secondo luogo dedicato alla memoria di questa industria.','The photograph shows the tobacco and cigar museum in Bünde, Germany: a second place preserving this industry’s history.')}</p><OfficialSources sources={[museumSource,buendeSource]} lang={lang}/></article><CommonsPhoto id="buende-museum" lang={lang}/></div></>}
 {kind==='accessories'&&<><header><p class="section-label">{text(lang,'Oggetti e istruzioni','Objects and instructions')}</p><h2 id={'archive-'+kind}>{text(lang,'Accendini: il modello e le indicazioni.','Lighters: the model and its instructions.')}</h2><p>{text(lang,'Decorazione, materiale e funzionamento sono aspetti distinti. Per uso e avvertenze, segui le istruzioni del produttore riferite al modello preciso.','Decoration, material and operation are separate aspects. Follow the manufacturer’s instructions and warnings for the exact model.')}</p></header><div class="accessory-grid">{lighterRecords.map(item=><article><img src={'/images/collection/'+item.id+'.webp'} width="1440" height="960" loading="lazy" alt={item.name[l]}/><div><h3>{item.name[l]}</h3><p>{item.detail[l]}</p></div></article>)}</div></>}
</section>
<style>
 .counter-archive{margin-block:45px 55px;padding-top:35px;border-top:1px solid var(--line)}.counter-archive header{max-width:760px;margin-bottom:28px}.counter-archive h2{font:400 clamp(2rem,3vw,3rem)/1.15 var(--display);color:var(--accent);margin-bottom:20px}.counter-archive p{font-size:.95rem;line-height:1.85}.archive-essays,.accessory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.archive-essays h3,.accessory-grid h3{font:400 1.8rem/1.2 var(--display);margin-bottom:20px;color:var(--accent)}.archive-essays a{display:block;min-height:44px;padding-block:12px;text-decoration:underline;text-underline-offset:4px}.accessory-grid article{border:1px solid var(--line);background:var(--surface)}.accessory-grid img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.accessory-grid article>div{padding:24px}.counter-archive a:focus-visible{outline:2px solid var(--blue);outline-offset:4px}@media(max-width:680px){.archive-essays,.accessory-grid{grid-template-columns:1fr}}
</style>
