---
import {pipeNames,otherAdultNames,accessoryRecords,otherAccessoryBrands} from '../data/counter-archive';
import {text,type Lang} from '../data/shop';
const {kind,lang='it'}=Astro.props as {kind:'pipe'|'accessories'|'other';lang:Lang};const l=lang==='it'?0:1;
---
<section class="counter-archive" aria-labelledby={`archive-${kind}`}>
 <header><p class="section-label">{text(lang,'Nomi e denominazioni · 18+','Names and terminology · 18+')}</p><h2 id={`archive-${kind}`}>{kind==='pipe'?text(lang,'Il nome e la linea.','The name and the line.'):kind==='accessories'?text(lang,'Modelli, grafica, misure.','Models, artwork, measurements.'):text(lang,'Altri nomi del banco.','Other counter names.')}</h2><p>{text(lang,'Un indice per distinguere marchi, linee e categorie. Non contiene prezzi, offerte o procedure di acquisto.','An index distinguishing brands, lines and categories. It contains no prices, offers or purchase procedures.')}</p></header>
 {kind==='pipe'&&<div class="pipe-name-grid">{pipeNames.map(item=><details><summary>{item.brand}<span>{item.names.length}</span></summary><div><p class="archive-terms">{item.names.join(' · ')}</p><p>{item.note[l]}</p></div></details>)}</div>}
 {kind==='accessories'&&<div class="accessory-grid">{accessoryRecords.map(item=><article><img src={`/images/collection/${item.id}.webp`} srcset={`/images/collection/${item.id}-720.webp 720w, /images/collection/${item.id}.webp 1440w`} sizes="(max-width:680px) 90vw,420px" width="1440" height="960" loading="lazy" alt={item.name[l]}/><div><p class="archive-terms">{item.brands.join(' · ')}</p><h3>{item.name[l]}</h3><p>{item.detail[l]}</p></div></article>)}</div>}
 {kind==='other'&&<div class="other-names">{otherAdultNames.map(group=><details><summary>{group.category[l]}</summary><p>{group.names.join(', ')}.</p></details>)}</div>}
 {kind==='accessories'&&<div class="other-names"><details><summary>{text(lang,'Altri marchi di accessori','Other accessory brands')}</summary><p>{otherAccessoryBrands.join(', ')}.</p></details></div>}
</section>
<style>
.counter-archive{margin-block:45px 55px;padding-top:35px;border-top:1px solid var(--line)}.counter-archive header{max-width:760px;margin-bottom:28px}.counter-archive h2{font:400 clamp(2rem,3vw,3rem)/1.15 var(--display);color:var(--accent);margin-bottom:20px}.counter-archive header>p:last-child,.counter-archive details p,.accessory-grid p{font-size:.95rem;line-height:1.85}.pipe-name-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pipe-name-grid details,.other-names details{border:1px solid var(--line);background:var(--surface)}.pipe-name-grid summary,.other-names summary{padding:20px;cursor:pointer;font-weight:600;display:flex;justify-content:space-between;gap:18px}.pipe-name-grid details>div,.other-names details>p{padding:0 20px 22px}.archive-terms{color:var(--accent);font-weight:600;margin-bottom:14px}.accessory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.accessory-grid article{border:1px solid var(--line);background:var(--surface)}.accessory-grid img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.accessory-grid article>div{padding:24px}.accessory-grid h3{font:400 1.9rem/1.2 var(--display);color:var(--accent);margin-bottom:17px}.other-names{display:grid;gap:14px}@media(max-width:680px){.pipe-name-grid,.accessory-grid{grid-template-columns:1fr}}
</style>
