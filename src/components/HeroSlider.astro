---
import {shop,text,pathFor,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};
const slides=[
 {src:'/images/scelta.webp',alt:text(lang,'Una famiglia davanti alla vetrina di Guerrazzi','A family at the Guerrazzi shop window'),label:text(lang,'Una sosta in Via Guerrazzi','A stop on Via Guerrazzi')},
 {src:'/images/incontro.webp',alt:text(lang,'Un incontro davanti al negozio di Angela','Meeting Angela outside her shop'),label:text(lang,'Il tempo di scegliere insieme','Time to choose together')},
 {src:'/images/regalo.webp',alt:text(lang,'La consegna di un piccolo gioco','A little toy changes hands'),label:text(lang,'La gioia delle piccole cose','The joy of little things')},
];
---
<section class="cinema-hero" data-hero-slider aria-label={text(lang,'Benvenuti da Guerrazzi','Welcome to Guerrazzi')} aria-roledescription={text(lang,'Carosello','Carousel')}>
 <div class="cinema-frames">{slides.map((s,i)=><div class:list={['cinema-frame',{'is-active':i===0}]} data-slide aria-hidden={i!==0}><img src={s.src} alt={s.alt} width="1122" height="1402" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'}/></div>)}</div>
 <div class="cinema-copy"><p class="location-label eyebrow">{shop.address} <span>Bologna</span></p><h1>{text(lang,'Le piccole cose.','Little things.')}<br/><em>{text(lang,'Il posto giusto.','The right place.')}</em></h1><p class="cinema-description">{text(lang,'Un regalo, un gioco, una commissione al volo. Da Angela, nel cuore di Bologna.','A gift, a toy, a quick errand. At Angela’s, in the heart of Bologna.')}</p><div class="hero-buttons"><a class="button light" href={pathFor('catalogo',lang)}>{text(lang,'Esplora il catalogo','Explore the catalogue')} ↗</a><a class="button cinema-directions" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come arrivare','Find us')}</a></div></div>
 <div class="cinema-bottom"><p data-slide-label>{slides[0].label}</p><div class="cinema-controls"><div class="cinema-dots" aria-label={text(lang,'Scegli immagine','Choose an image')}>{slides.map((s,i)=><button type="button" data-slide-to={i} data-label={s.label} aria-label={`${text(lang,'Immagine','Image')} ${i+1}: ${s.label}`} aria-pressed={i===0}><span class="sr-only">{i+1}</span></button>)}</div><button type="button" data-slide-pause data-play={text(lang,'Riprendi slideshow','Play slideshow')} data-pause={text(lang,'Pausa slideshow','Pause slideshow')} aria-label={text(lang,'Pausa slideshow','Pause slideshow')}>Ⅱ</button></div></div>
</section>
<script>
const root=document.querySelector<HTMLElement>('[data-hero-slider]');
if(root){
 const frames=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
 const dots=[...root.querySelectorAll<HTMLButtonElement>('[data-slide-to]')];
 const pause=root.querySelector<HTMLButtonElement>('[data-slide-pause]')!;
 const label=root.querySelector<HTMLElement>('[data-slide-label]')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 let current=0,paused=reduced.matches,hover=false,focused=false,timer:ReturnType<typeof setInterval>|undefined;
 const show=(index:number)=>{current=index;frames.forEach((f,i)=>{f.classList.toggle('is-active',i===index);f.setAttribute('aria-hidden',String(i!==index))});dots.forEach((d,i)=>d.setAttribute('aria-pressed',String(i===index)));label.textContent=dots[index].dataset.label||'';};
 const schedule=()=>{clearInterval(timer);pause.textContent=paused?'▶':'Ⅱ';pause.setAttribute('aria-label',(paused?pause.dataset.play:pause.dataset.pause)||'');if(!paused&&!hover&&!focused&&!document.hidden)timer=setInterval(()=>show((current+1)%frames.length),6500);};
 dots.forEach((dot,i)=>dot.addEventListener('click',()=>{show(i);schedule()}));
 pause.addEventListener('click',()=>{paused=!paused;schedule()});
 root.addEventListener('mouseenter',()=>{hover=true;schedule()});root.addEventListener('mouseleave',()=>{hover=false;schedule()});
 root.addEventListener('focusin',()=>{focused=true;schedule()});root.addEventListener('focusout',e=>{if(!root.contains(e.relatedTarget as Node)){focused=false;schedule()}});
 document.addEventListener('visibilitychange',schedule);reduced.addEventListener('change',()=>{paused=reduced.matches;schedule()});schedule();
}
</script>
<style>
.cinema-hero{position:relative;isolation:isolate;min-height:740px;min-height:min(850px,calc(100svh - 100px));background:#172333;color:#fff;overflow:hidden;display:flex;align-items:center}.cinema-frames,.cinema-frame{position:absolute;inset:0;z-index:-2}.cinema-frame{opacity:0;transition:opacity 1.5s ease}.cinema-frame.is-active{opacity:1}.cinema-frame img{width:100%;height:100%;object-fit:cover;object-position:50% 48%}.cinema-hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(9,18,29,.85),rgba(9,18,29,.4) 55%,rgba(9,18,29,.08)),linear-gradient(0deg,rgba(9,18,29,.65),transparent 35%)}.cinema-copy{width:min(1440px,calc(100% - 112px));margin:auto;padding:90px 0 140px}.cinema-copy .location-label{color:#151515;background:#f8f8f3ed;padding:8px 16px;display:inline-flex;margin-bottom:30px}.cinema-copy h1{font-size:clamp(4rem,7vw,7.7rem);max-width:1000px;color:#fff;letter-spacing:-.045em}.cinema-copy h1 em{font-weight:400}.cinema-description{max-width:410px;margin:28px 0 30px;color:#f4f0e8}.cinema-directions{border-color:#ffffff90;color:#fff}.cinema-directions:hover{background:#ffffff20}.cinema-bottom{position:absolute;left:56px;right:56px;bottom:32px;display:flex;justify-content:space-between;gap:25px;align-items:center}.cinema-bottom>p{font-size:.85rem}.cinema-controls,.cinema-dots{display:flex;align-items:center;gap:10px}.cinema-controls button{color:#fff;min-width:44px;min-height:44px}.cinema-dots button{position:relative}.cinema-dots button::after{content:'';position:absolute;left:4px;right:4px;top:21px;height:2px;background:#ffffff60}.cinema-dots button[aria-pressed=true]::after{background:#fff;height:4px}.cinema-hero :focus-visible{outline-color:white}.cinema-copy .button.light{color:var(--blue)}
@media(min-width:1600px){.cinema-copy{padding-inline:20px}}
@media(max-width:680px){.cinema-hero{min-height:760px;min-height:calc(100svh - 90px)}.cinema-copy{width:calc(100% - 40px);padding:65px 0 130px}.cinema-copy h1{font-size:clamp(3rem,11vw,4.5rem)}.cinema-copy .location-label{font-size:1.15rem;gap:12px;margin-bottom:24px}.cinema-copy .location-label span{padding-left:12px}.cinema-description{font-size:.95rem;max-width:300px}.cinema-frame img{object-position:58% center}.cinema-hero::after{background:linear-gradient(90deg,#09121dc9,#09121d45),linear-gradient(0deg,#09121dcc,transparent 50%)}.cinema-bottom{left:20px;right:20px;bottom:18px;gap:10px}.cinema-bottom>p{max-width:150px;font-size:.75rem}.hero-buttons{gap:12px}.hero-buttons .button{font-size:.85rem;padding-inline:16px}.cinema-dots{gap:0}}
@media(prefers-reduced-motion:reduce){.cinema-frame{transition:none}}
</style>
