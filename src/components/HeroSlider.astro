---
import {shop,text,pathFor,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};
const slides=[
 {src:'/images/hero/portico.webp',small:'/images/hero/portico-960.webp',focus:'62% center',alt:text(lang,'Ricostruzione editoriale del portico e della vetrina Guerrazzi dalla foto reale','Editorial reconstruction of the Guerrazzi portico and shopfront from the real photograph'),label:text(lang,'Sotto i portici, da Angela','Under the porticoes, at Angela’s'),line1:text(lang,'C’è un posto,','There’s a place,'),line2:text(lang,'sotto questi portici.','under these porticoes.'),description:text(lang,'Per i giorni di passaggio e quelli di sempre. Una bottega, una persona, tante piccole scoperte nel cuore di Bologna.','For the days you’re passing through and the ones you call your own. A shop, a person, little discoveries in the heart of Bologna.'),cta:text(lang,'Entra da Guerrazzi','Step inside Guerrazzi'),href:pathFor('il-negozio',lang)},
 {src:'/images/hero/regalo.webp',small:'/images/hero/regalo-960.webp',focus:'68% center',alt:text(lang,'Scena editoriale: mani che preparano un piccolo regalo sul banco','Editorial scene: hands wrapping a little gift at the counter'),label:text(lang,'Il tempo di scegliere un pensiero','Time to choose something thoughtful'),line1:text(lang,'Le cose scelte bene','Thoughtfully chosen things'),line2:text(lang,'parlano per noi.','say it for us.'),description:text(lang,'Un grazie, un compleanno, un invito. Il regalo giusto comincia dal pensiero che vuoi far arrivare.','A thank-you, a birthday, an invitation. The right gift starts with what you want to say.'),cta:text(lang,'Trova un’idea regalo','Find a gift idea'),href:pathFor('idee-regalo',lang)},
 {src:'/images/hero/viaggiatrice.webp',small:'/images/hero/viaggiatrice-960.webp',focus:'69% center',alt:text(lang,'Scena editoriale: una viaggiatrice con valigia davanti al negozio','Editorial scene: a traveller with a suitcase outside the shop'),label:text(lang,'Bounce · Deposito bagagli in centro','Bounce · Luggage storage in the centre'),line1:text(lang,'La città ti aspetta.','The city is waiting.'),line2:text(lang,'La valigia può aspettare.','Your suitcase can wait.'),description:text(lang,'Lascia i bagagli da Guerrazzi con Bounce. E riprenditi il piacere di camminare per Bologna senza trascinarti nulla.','Leave your bags at Guerrazzi with Bounce. Rediscover the pleasure of walking around Bologna with nothing to carry.'),cta:text(lang,'Organizza il deposito','Plan your bag drop'),href:pathFor('deposito-bagagli',lang)},
 {src:'/images/hero/cartoleria.webp',small:'/images/hero/cartoleria-960.webp',focus:'65% center',alt:text(lang,'Composizione editoriale di quaderni e matite sulle mensole bianche','Editorial composition of notebooks and pencils on white shelves'),label:text(lang,'Carta, colori, prossime idee','Paper, colours, ideas to come'),line1:text(lang,'Ogni nuova idea','Every new idea'),line2:text(lang,'merita una pagina.','deserves a page.'),description:text(lang,'Un quaderno per cominciare. Una penna per non perdere il filo. La cartoleria per lo studio, il lavoro e tutto quello che hai in mente.','A notebook to begin. A pen to keep the thread. Stationery for studying, working and everything you have in mind.'),cta:text(lang,'Scopri la cartoleria','Explore stationery'),href:pathFor('cartoleria',lang)},
 {width:1536,height:1024,smallWidth:1536,src:'/images/games.webp',small:'/images/games.webp',focus:'60% center',alt:text(lang,'Composizione editoriale di giochi colorati','Editorial composition of colourful toys'),label:text(lang,'La curiosità prende forma','Curiosity takes shape'),line1:text(lang,'Il bello è','The joy is'),line2:text(lang,'lasciarsi sorprendere.','in being surprised.'),description:text(lang,'Giochi, passatempi e piccole scoperte da scegliere pensando a chi li riceverà. Da Angela, si parte da una chiacchierata.','Toys, pastimes and little discoveries chosen with someone in mind. At Angela’s, it begins with a conversation.'),cta:text(lang,'Esplora giochi e giocattoli','Explore games and toys'),href:pathFor('giochi-e-giocattoli',lang)},
 {width:1600,height:900,smallWidth:800,src:'/images/editorial/souvenir-desktop.webp',small:'/images/editorial/souvenir-desktop-800.webp',focus:'60% center',alt:text(lang,'Composizione editoriale di piccoli souvenir di Bologna','Editorial composition of Bologna keepsakes'),label:text(lang,'Un ricordo da portare via','A memory to take away'),line1:text(lang,'Un po’ di Bologna.','A little Bologna.'),line2:text(lang,'Da portare con sé.','To take with you.'),description:text(lang,'Le torri, i portici, i giorni passati qui. A volte basta un piccolo ricordo per ritrovare una città.','The towers, the porticoes, the days spent here. Sometimes a little keepsake brings a whole city back.'),cta:text(lang,'Scopri i souvenir','Discover souvenirs'),href:pathFor('souvenir-bologna',lang)},
];
---
<section class="cinema-hero" data-hero-slider aria-label={text(lang,'Benvenuti da Guerrazzi','Welcome to Guerrazzi')} aria-roledescription={text(lang,'Carosello','Carousel')}>
 <div class="cinema-frames">{slides.map((s,i)=><div class:list={['cinema-frame',{'is-active':i===0}]} data-slide aria-hidden={i!==0}><img src={s.src} srcset={`${s.small} ${s.smallWidth||960}w, ${s.src} ${s.width||1672}w`} sizes="100vw" style={`object-position:${s.focus}`} alt={s.alt} width={s.width||1672} height={s.height||940} loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'}/></div>)}</div>
 <div class="cinema-copy"><p class="location-label eyebrow">{shop.address} <span>Bologna</span></p><h1><span data-hero-line1>{slides[0].line1}</span><br/><em data-hero-line2>{slides[0].line2}</em></h1><p class="cinema-description" data-hero-description>{slides[0].description}</p><div class="hero-buttons"><a class="button light" data-hero-cta href={slides[0].href}>{slides[0].cta} ↗</a><a class="button cinema-directions" href={shop.maps} target="_blank" rel="noopener">{text(lang,'Come arrivare','Find us')}</a></div></div>
 <div class="cinema-bottom"><p data-slide-label>{slides[0].label}</p><div class="cinema-controls"><div class="cinema-dots" aria-label={text(lang,'Scegli scena','Choose a scene')}>{slides.map((s,i)=><button type="button" data-slide-to={i} data-label={s.label} data-line1={s.line1} data-line2={s.line2} data-description={s.description} data-cta={s.cta} data-href={s.href} aria-label={`${text(lang,'Scena','Scene')} ${i+1}: ${s.label}`} aria-pressed={i===0}><span class="sr-only">{i+1}</span></button>)}</div><button type="button" data-slide-pause data-play={text(lang,'Riprendi slideshow','Play slideshow')} data-pause={text(lang,'Pausa slideshow','Pause slideshow')} aria-label={text(lang,'Pausa slideshow','Pause slideshow')}>Ⅱ</button></div></div>
</section>
<script>
const root=document.querySelector<HTMLElement>('[data-hero-slider]');
if(root){
 const frames=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
 const dots=[...root.querySelectorAll<HTMLButtonElement>('[data-slide-to]')];
 const pause=root.querySelector<HTMLButtonElement>('[data-slide-pause]')!;
 const label=root.querySelector<HTMLElement>('[data-slide-label]')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 let current=0,paused=reduced.matches,hover=false,focused=false,timer:ReturnType<typeof setInterval>|undefined;
 const show=(index:number)=>{current=index;frames.forEach((f,i)=>{f.classList.toggle('is-active',i===index);f.setAttribute('aria-hidden',String(i!==index))});dots.forEach((d,i)=>d.setAttribute('aria-pressed',String(i===index)));const data=dots[index].dataset;label.textContent=data.label||'';root.querySelector('[data-hero-line1]')!.textContent=data.line1||'';root.querySelector('[data-hero-line2]')!.textContent=data.line2||'';root.querySelector('[data-hero-description]')!.textContent=data.description||'';const cta=root.querySelector<HTMLAnchorElement>('[data-hero-cta]')!;cta.textContent=(data.cta||'')+' ↗';cta.href=data.href||'/';};
 const schedule=()=>{clearInterval(timer);pause.textContent=paused?'▶':'Ⅱ';pause.setAttribute('aria-pressed',String(paused));pause.setAttribute('aria-label',(paused?pause.dataset.play:pause.dataset.pause)||'');if(!paused&&!hover&&!focused&&!document.hidden)timer=setInterval(()=>show((current+1)%frames.length),7200);};
 dots.forEach((dot,i)=>dot.addEventListener('click',()=>{show(i);schedule()}));
 pause.addEventListener('click',()=>{paused=!paused;schedule()});
 root.addEventListener('mouseenter',()=>{hover=true;schedule()});root.addEventListener('mouseleave',()=>{hover=false;schedule()});
 root.addEventListener('focusin',()=>{focused=true;schedule()});root.addEventListener('focusout',e=>{if(!root.contains(e.relatedTarget as Node)){focused=false;schedule()}});
 document.addEventListener('visibilitychange',schedule);reduced.addEventListener('change',()=>{paused=reduced.matches;schedule()});schedule();
}
</script>
<style>
.cinema-hero{position:relative;isolation:isolate;min-height:740px;min-height:clamp(660px,calc(100svh - 160px),900px);background:#172333;color:#fff;overflow:hidden;display:flex;align-items:center}.cinema-frames,.cinema-frame{position:absolute;inset:0;z-index:-2}.cinema-frame{opacity:0;transition:opacity 1.5s ease}.cinema-frame.is-active{opacity:1}.cinema-frame img{width:100%;height:100%;object-fit:cover;object-position:50% 48%}.cinema-hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(9,18,29,.85),rgba(9,18,29,.4) 55%,rgba(9,18,29,.08)),linear-gradient(0deg,rgba(9,18,29,.65),transparent 35%)}.cinema-copy{width:min(1440px,calc(100% - 112px));margin:auto;padding:90px 0 140px}.cinema-copy .location-label{color:#151515;background:#f8f8f3ed;padding:8px 16px;display:inline-flex;margin-bottom:30px}.cinema-copy h1{font-size:clamp(3.6rem,5.6vw,6.1rem);max-width:1000px;color:#fff;letter-spacing:-.045em}.cinema-copy h1 em{font-weight:400}.cinema-description{max-width:460px;min-height:90px;margin:28px 0 30px;color:#f4f0e8}.cinema-directions{border-color:#ffffff90;color:#fff}.cinema-directions:hover{background:#ffffff20}.cinema-bottom{position:absolute;left:56px;right:56px;bottom:32px;display:flex;justify-content:space-between;gap:25px;align-items:center}.cinema-bottom>p{font-size:.85rem}.cinema-controls,.cinema-dots{display:flex;align-items:center;gap:10px}.cinema-controls button{color:#fff;min-width:44px;min-height:44px}.cinema-dots button{position:relative}.cinema-dots button::after{content:'';position:absolute;left:4px;right:4px;top:21px;height:2px;background:#ffffff60}.cinema-dots button[aria-pressed=true]::after{background:#fff;height:4px}.cinema-hero :focus-visible{outline-color:white}.cinema-copy .button.light{color:var(--blue)}
@media(min-width:1600px){.cinema-copy{padding-inline:20px}}
@media(max-width:680px){.cinema-hero{min-height:760px;min-height:max(740px,calc(100svh - 90px))}.cinema-copy{width:calc(100% - 40px);padding:65px 0 130px}.cinema-copy h1{font-size:clamp(2.7rem,9.7vw,4.5rem)}.cinema-copy .location-label{font-size:1.15rem;gap:12px;margin-bottom:24px}.cinema-copy .location-label span{padding-left:12px}.cinema-description{font-size:.95rem;max-width:300px}.cinema-frame img{object-position:58% center}.cinema-hero::after{background:linear-gradient(90deg,#09121dc9,#09121d45),linear-gradient(0deg,#09121dcc,transparent 50%)}.cinema-bottom{left:20px;right:20px;bottom:18px;gap:10px}.cinema-bottom{align-items:flex-start;flex-direction:column;gap:8px}.cinema-bottom>p{max-width:none;font-size:.75rem}.hero-buttons{gap:12px}.hero-buttons .button{font-size:.85rem;padding-inline:16px}.cinema-dots{gap:0}.cinema-controls{width:100%;justify-content:space-between}.cinema-dots button{min-width:36px}}
@media(prefers-reduced-motion:reduce){.cinema-frame{transition:none}}
</style>
