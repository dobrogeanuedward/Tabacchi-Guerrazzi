---
const {title,intro,items}=Astro.props as {title:string;intro:string;items:{id:string;label:string}[]};
---
<div class="legal-document wrap"><header class="legal-document-head"><p class="section-label">Informazioni del sito</p><h1>{title}</h1><p>{intro}</p></header><div class="legal-document-grid"><nav aria-label="Indice del documento"><p>In questa pagina</p><ol>{items.map((item,i)=><li><a href={`#${item.id}`}><span aria-hidden="true">0{i+1}</span>{item.label}</a></li>)}</ol><a class="document-return" href="/">Torna al negozio <span aria-hidden="true">→</span></a></nav><article><slot/></article></div></div>
<style>
 .legal-document{max-width:1150px;padding-block:36px 75px}.legal-document-head{padding:30px 35px 35px;border-block:1px solid var(--line);background:linear-gradient(#f9f5ecf2,#f9f5ecf2),url('/images/materials/paper-768.webp') center/cover}.legal-document-head .section-label{font-size:1rem;margin-bottom:18px}.legal-document h1{font:400 clamp(3rem,4.7vw,4.5rem)/1.08 var(--display);letter-spacing:-.04em;color:var(--blue);margin:0 0 24px}.legal-document-head>p:last-child{max-width:70ch;font:400 1rem/1.85 var(--sans);color:#42516a}.legal-document-grid{display:grid;grid-template-columns:240px minmax(0,1fr);gap:50px;padding-top:40px}.legal-document nav{align-self:start;position:sticky;top:25px}.legal-document nav>p{font:600 .95rem/1.7 var(--sans);color:var(--blue);margin-bottom:17px}.legal-document ol{list-style:none;padding:0;margin:0}.legal-document li a{display:flex;gap:12px;padding:12px 0;border-top:1px solid var(--line);font:.95rem/1.75 var(--sans);color:#33435b}.legal-document li span{color:#526889;font-variant-numeric:tabular-nums}.document-return{display:flex;justify-content:space-between;gap:16px;margin-top:28px;padding-top:18px;border-top:1px solid var(--line);font:600 .95rem/1.7 var(--sans);color:var(--blue)}.legal-document article{min-width:0}.legal-document :global(article>section){scroll-margin-top:30px;padding-bottom:30px;margin-bottom:30px;border-bottom:1px solid var(--line)}.legal-document :global(article h2){font:400 clamp(1.8rem,2.5vw,2.3rem)/1.2 var(--display);letter-spacing:-.025em;color:var(--blue);margin-bottom:20px}.legal-document :global(article p){font:400 1rem/1.9 var(--sans);color:#33435b;overflow-wrap:anywhere;max-width:72ch}
 @media(max-width:680px){.legal-document{padding-block:25px 50px}.legal-document-head{padding:24px}.legal-document h1{font-size:3rem}.legal-document-grid{grid-template-columns:minmax(0,1fr);gap:28px;padding-top:28px}.legal-document nav{position:static;padding:20px;border:1px solid var(--line)}.legal-document li a{min-height:44px}.legal-document :global(article>section){margin-bottom:24px;padding-bottom:24px}}
</style>
