---
import {catalogueBrands} from '../data/brand-catalogue';import {catalogGroups} from '../data/catalog-assortment';import {pathFor,text,type Lang} from '../data/shop';
import {getSiteOrigin} from '../lib/site-origin.mjs';
const {lang='it'}=Astro.props as {lang:Lang};
const groups=catalogGroups.map(group=>({...group,brands:catalogueBrands.filter(brand=>brand.items.some(item=>item.category===group.id))})).filter(group=>group.brands.length);
const origin=getSiteOrigin(import.meta.env.PUBLIC_SITE_URL);
const brandList={'@context':'https://schema.org','@type':'ItemList',name:text(lang,'I marchi del catalogo Guerrazzi','Brands in the Guerrazzi catalogue'),itemListElement:catalogueBrands.map((brand,index)=>({'@type':'ListItem',position:index+1,name:brand.name,url:new URL(pathFor(`marchi/${brand.slug}`,lang),origin).href}))};
---
<script type="application/ld+json" set:html={JSON.stringify(brandList).replace(/</g,'\\u003c')}/>
<section id="brand-directory" class="brand-directory" aria-labelledby="brand-directory-title">
<header><p class="section-label">{text(lang,'I brand della bottega','The shop’s brands')}</p><h2 id="brand-directory-title">{text(lang,'Un nome che riconosci.','A name you recognise.')}</h2><p>{text(lang,'Scegli una categoria oppure cerca il marchio. Ogni nome apre le sue schede, con gli articoli e i dettagli da guardare in negozio.','Choose a category or search for a brand. Each name opens its listings, with items and details to look at in store.')}</p></header>
<label class="brand-search"><span>{text(lang,'Cerca un brand','Search brands')}</span><input type="search" data-brand-search placeholder="LEGO, Ricola, Bburago…"/></label><p class="brand-total">{catalogueBrands.length} {text(lang,'nomi nel catalogo','names in the catalogue')}</p>
<div class="brand-category-list">{groups.map((group,i)=><details open={i<2} data-brand-group><summary><span>{lang==='it'?group.it:group.en}</span><span>{group.brands.length}</span></summary><div class="brand-name-grid">{group.brands.map(brand=><a data-brand-name={brand.name.toLowerCase()} href={pathFor(`marchi/${brand.slug}`,lang)}><strong>{brand.name}</strong><span>{text(lang,'Articoli e dettagli','Items and details')}</span></a>)}</div></details>)}</div><p data-brand-empty hidden>{text(lang,'Questo nome non è nell’indice. Prova una categoria o una parte del nome.','That name is not in the index. Try a category or part of the name.')}</p>
</section>
<script>
document.querySelectorAll<HTMLElement>('.brand-directory').forEach(root=>{const input=root.querySelector<HTMLInputElement>('[data-brand-search]');const groups=[...root.querySelectorAll<HTMLDetailsElement>('[data-brand-group]')];input?.addEventListener('input',()=>{const normal=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();const q=normal(input.value.trim());let total=0;groups.forEach(group=>{let count=0;group.querySelectorAll<HTMLElement>('[data-brand-name]').forEach(a=>{const match=normal(a.dataset.brandName||'').includes(q);a.hidden=!match;if(match)count++});group.hidden=count===0;if(q&&count)group.open=true;total+=count;});const empty=root.querySelector<HTMLElement>('[data-brand-empty]');if(empty)empty.hidden=total>0;});});
</script>
<style>
.brand-directory{margin:40px 0 60px;scroll-margin-top:30px}.brand-directory>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:15px 45px;align-items:end;margin-bottom:30px}.brand-directory .section-label{grid-column:1/-1}.brand-directory h2{font:400 clamp(2.2rem,3.5vw,3.3rem)/1.12 var(--display);color:var(--accent);max-width:18ch}.brand-directory header>p:last-child{line-height:1.85;font-size:.98rem}.brand-search{display:flex;align-items:center;gap:22px;padding:15px 22px;border:1px solid var(--line);background:#fffdfa}.brand-search>span{font-weight:600;color:var(--accent);white-space:nowrap}.brand-search input{width:100%;border:0;background:transparent;font-size:1rem;min-width:0;padding:10px}.brand-total{margin:17px 0 28px;color:#42516a;font-size:.9rem}.brand-category-list{border-bottom:1px solid var(--line)}.brand-category-list details{border-top:1px solid var(--line)}.brand-category-list summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:24px;padding:22px 0;font:400 1.7rem/1.2 var(--display);color:var(--accent)}.brand-category-list summary>span:last-child{font:600 .9rem/1.7 var(--sans);border:1px solid var(--line);border-radius:50%;width:32px;height:32px;text-align:center}.brand-name-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding-bottom:28px}.brand-name-grid>a{padding:23px;border:1px solid var(--line);background:#fffdfa;display:flex;flex-direction:column;gap:16px}.brand-name-grid strong{overflow-wrap:anywhere;font:400 1.8rem/1.2 var(--display);color:var(--accent)}.brand-name-grid a>span{font-size:.85rem;color:#4d5b6c}.brand-name-grid>a:hover{background:var(--surface);border-color:var(--accent)}.brand-name-grid>a:focus-visible{outline:3px solid var(--blue);outline-offset:4px}.brand-directory [hidden]{display:none!important}@media(max-width:680px){.brand-directory>header{grid-template-columns:1fr}.brand-name-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-name-grid>a{padding:18px}.brand-name-grid strong{font-size:1.45rem}.brand-search{display:block}.brand-search input{padding-left:0;margin-top:8px}}
</style>
