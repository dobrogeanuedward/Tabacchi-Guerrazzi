---
import {assortmentPages} from '../data/assortment';
import {pathFor,text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};const l=lang==='it'?0:1;
const entries=assortmentPages.filter(p=>p.brands?.length&&!['accendini-e-accessori','ricevitoria'].includes(p.slug));
---
<section id="brand-directory" class="brand-directory" aria-labelledby="brand-directory-title"><header><p class="section-label">{text(lang,'Categorie e riferimenti','Categories and references')}</p><h2 id="brand-directory-title">{text(lang,'Un nome, il suo contesto.','A name, in context.')}</h2><p>{text(lang,'I marchi citati nelle categorie del negozio, raccolti per orientarti. Le schede aiutano a identificare una famiglia; modelli, varianti e confezioni si verificano sul singolo articolo.','The brands mentioned in the shop categories, grouped to help you navigate. Records identify a family; check models, variants and packaging on the individual item.')}</p></header><div class="brand-directory-grid">{entries.map((entry,i)=><a href={pathFor(entry.slug,lang)} class="brand-directory-card"><div class="brand-directory-top"><span>{String(i+1).padStart(2,'0')}</span><span>{text(lang,'Categoria','Category')}</span></div><h3>{entry.label[l]}</h3><ul aria-label={text(lang,'Marchi citati','Brands mentioned')}>{entry.brands!.map(brand=><li>{brand}</li>)}</ul><span class="brand-directory-action">{text(lang,'Apri la categoria','Open category')} </span></a>)}</div></section>
<style>
 .brand-directory{margin:40px 0 55px;scroll-margin-top:30px}.brand-directory>header{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 50px;align-items:end;margin-bottom:28px}.brand-directory .section-label{grid-column:1/-1;margin:0}.brand-directory h2{font-size:clamp(2.1rem,3vw,3rem);color:var(--accent);max-width:20ch;line-height:1.15}.brand-directory>header>p:last-child{font-size:.95rem;line-height:1.85;max-width:62ch}
 .brand-directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.brand-directory-card{display:flex;flex-direction:column;min-width:0;padding:26px;border:1px solid var(--line);background:linear-gradient(#fbf8f0ed,#fbf8f0ed),url('/images/materials/paper-768.webp') center/cover}.brand-directory-top{display:flex;justify-content:space-between;gap:16px;align-items:baseline;color:#40516c;font:.95rem/1.5 var(--sans);padding-bottom:18px;border-bottom:1px solid var(--line)}.brand-directory-top>span:first-child{font:400 1.8rem/1 var(--display);color:var(--accent)}.brand-directory h3{font-size:1.95rem;line-height:1.2;margin:22px 0;color:var(--accent)}.brand-directory ul{display:flex;flex-wrap:wrap;gap:9px 15px;list-style:none;margin:0 0 28px;padding:0}.brand-directory li{font:.95rem/1.75 var(--sans);color:#33435b;border-bottom:1px solid #b3bdcc}.brand-directory-action{display:flex;justify-content:space-between;gap:16px;margin-top:auto;padding-top:17px;border-top:1px solid var(--line);font:600 .95rem/1.5 var(--sans);color:var(--accent)}.brand-directory-card:hover{border-color:var(--accent);background:var(--surface)}.brand-directory-card:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
 @media(max-width:960px){.brand-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.brand-directory>header{gap:20px}}
 @media(max-width:680px){.brand-directory>header,.brand-directory-grid{grid-template-columns:minmax(0,1fr)}.brand-directory-card{padding:23px}.brand-directory>header{gap:17px}.brand-directory h2{font-size:2.3rem}}
</style>
