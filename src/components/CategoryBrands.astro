---
import {brandsForCategory} from '../data/category-brands';
import {pathFor,text,type Lang} from '../data/shop';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};
const brands=brandsForCategory(slug);
const titleId=`category-brands-${slug}`;
---
{brands.length>0&&<section class="category-brands" aria-labelledby={titleId}>
 <header><h2 id={titleId}>{text(lang,slug==='idee-regalo'?'Un interesse, un marchio.':'I marchi di questa categoria.',slug==='idee-regalo'?'An interest, a brand.':'Brands in this category.')}</h2><p>{text(lang,'Dal nome alle schede: confronta le famiglie, poi verifica il modello o il formato che cerchi.','Follow a name to its listings: compare the families, then check the model or size you need.')}</p></header>
 <nav aria-label={text(lang,'Esplora i marchi','Explore brands')}>{brands.map(brand=><a href={pathFor(`marchi/${brand.slug}`,lang)}>{brand.name}</a>)}</nav>
</section>}
<style>
.category-brands{border-block:1px solid var(--line);padding:28px 0;margin:38px 0}.category-brands h2{font:400 clamp(1.8rem,3vw,2.5rem)/1.2 var(--display);color:var(--accent);margin-bottom:14px}.category-brands header p{font-size:.95rem;line-height:1.8;max-width:65ch}.category-brands nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.category-brands a{display:flex;align-items:center;min-height:44px;padding:10px 16px;border:1px solid var(--line);background:#fffdfa;color:var(--accent);font-size:.95rem;line-height:1.5}.category-brands a:hover{border-color:var(--accent);background:var(--surface)}.category-brands a:focus-visible{outline:2px solid var(--blue);outline-offset:3px}@media(max-width:680px){.category-brands{margin-block:28px;padding-block:24px}.category-brands nav{gap:8px}.category-brands a{padding-inline:12px}}
</style>
