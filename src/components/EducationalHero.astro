---
import {text,type Lang} from '../data/shop';
import VisualStudy from './VisualStudy.astro';
const {slug,lang='it'}=Astro.props as {slug:string;lang:Lang};
const pipe=slug==='pipe-e-tabacchi-da-pipa';
---
<header class:list={['education-hero',pipe?'education-forest':'education-wood']}>
 <div class="education-edition wrap"><span>{text(lang,'Quaderni Guerrazzi','Guerrazzi notebooks')}</span><span>{pipe?text(lang,'Botanica / materia / storia','Botany / materials / history'):text(lang,'Lessico / denominazioni / fonti','Terminology / names / sources')}</span></div>
 <div class="education-opening wrap">
  <div class="education-copy">
   <p class="education-series">{text(lang,'Area informativa','Information area')} <span>18+</span></p>
   <h1>{pipe?text(lang,'Pipe e tabacco da pipa.','Pipes and pipe tobacco.'):text(lang,'Sigari.','Cigars.')}</h1>
   <p class="education-subtitle">{pipe?text(lang,'Materiali, botanica e storia.','Materials, botany and history.'):text(lang,'Struttura, termini e fonti.','Structure, terminology and sources.')}</p>
   <p class="education-intro">{pipe?text(lang,'Dall’Erica arborea alla sepiolite: guide brevi per leggere i materiali e distinguere l’oggetto dal suo contenuto.','From Erica arborea to sepiolite: concise guides to materials and the distinction between an object and its contents.'):text(lang,'Un percorso nel linguaggio: le parti, le denominazioni e le informazioni da verificare nelle fonti.','A path through the language: components, names and information to check against the sources.')}</p>
   <nav class="education-paths" aria-label={text(lang,'Esplora questa area','Explore this area')}>
    <a href="#atlante">{text(lang,'Apri le guide','Open the guides')} <span aria-hidden="true">↓</span></a>
    <a href="#norme">{text(lang,'Norme e confezioni','Rules and packaging')} <span aria-hidden="true">↓</span></a>
   </nav>
  </div>
  <div class="education-material"><VisualStudy id={pipe?'botanical-erica-study':'archive-folio'} lang={lang} variant="inset" loading="eager"/></div>
 </div>
</header>
<style>
.education-hero{--education-ink:#5a402b;--education-border:#cbb99f;--education-material:url('/images/materials/wood-768.webp');background:#f5efe3;background-image:linear-gradient(#f5efe3d9,#f5efe3d9),url('/images/materials/paper-768.webp');background-size:auto,1100px;color:var(--education-ink);border-block:1px solid var(--education-border);position:relative;isolation:isolate}
.education-hero:before{content:'';position:absolute;z-index:-1;inset:0 0 0 auto;width:24%;background:#765037 var(--education-material) center/cover}
.education-forest{--education-ink:#294535;--education-border:#b9c4b0;--education-material:url('/images/materials/forest-768.webp')}
.education-edition{display:flex;justify-content:space-between;gap:24px;padding-block:20px;border-bottom:1px solid var(--education-border);font:500 .95rem/1.5 var(--sans)}
.education-edition>span:last-child{padding:3px 12px;background:#f5efe3}
.education-opening{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);align-items:center;gap:clamp(35px,5vw,80px);padding-block:46px 58px}
.education-series{display:flex;align-items:center;gap:18px;font:600 1.05rem/1.5 var(--sans);margin-bottom:22px}
.education-series span{font-size:.9rem;border:1px solid currentColor;border-radius:30px;padding:4px 10px;line-height:1.2}
.education-copy h1{font-size:clamp(3.2rem,5.1vw,4.7rem);line-height:1.04;color:var(--education-ink);max-width:14ch;margin-bottom:22px;letter-spacing:-.04em;text-wrap:balance}
.education-subtitle{font:400 clamp(1.6rem,2.4vw,2.35rem)/1.25 var(--display);margin-bottom:24px;max-width:24ch}
.education-intro{font-size:1rem;line-height:1.8;max-width:54ch;color:#354039}
.education-paths{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.education-paths a{display:inline-flex;align-items:center;justify-content:space-between;gap:20px;min-height:48px;padding:12px 18px;border:1px solid var(--education-ink);font-size:.95rem;font-weight:600;color:var(--education-ink);background:#fffaf3}
.education-paths a:first-child{background:var(--education-ink);color:#fffaf3}
.education-paths a:hover{text-decoration:underline;text-underline-offset:4px}
.education-paths a:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
.education-material{min-width:0;padding:26px;background:#fbf7ec;border:1px solid var(--education-border);box-shadow:9px 9px 0 #f5efe37a}
@media(max-width:960px){.education-opening{gap:30px}.education-copy h1{font-size:clamp(3.1rem,5vw,4.5rem)}.education-material{padding:18px}.education-edition{font-size:.875rem}}
@media(max-width:680px){.education-hero:before{width:8px}.education-edition{flex-direction:column;gap:4px;padding-block:16px}.education-edition>span:last-child{padding:0;background:none;font-size:.875rem}.education-opening{grid-template-columns:1fr;gap:30px;padding-block:28px 38px}.education-copy h1{font-size:clamp(3rem,11vw,4.2rem)}.education-subtitle{font-size:1.85rem}.education-series{margin-bottom:20px}.education-paths{margin-top:24px}.education-paths a{font-size:.9rem;gap:12px;padding:12px 14px}.education-material{width:100%;max-width:480px;margin-inline:auto;padding:16px;box-shadow:4px 4px 0 #d9ceba}}
</style>
