---
import {text} from '../data/shop';
const {sources=[],lang='it'}=Astro.props;
---
{sources.length>0&&<aside class="official-sources"><details><summary>{text(lang,'Per approfondire: le fonti','Read more: the sources')}</summary><ul>{sources.map((s:any)=><li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul></details></aside>}
<style>.official-sources{margin:2.5rem 0;padding:1.5rem 0;border-top:1px solid #cad6e5;max-width:72ch}.official-sources summary{cursor:pointer;font-weight:600;font-size:.95rem;min-height:44px;display:list-item;align-content:center}.official-sources li{font-size:.95rem;line-height:1.75;margin:.7rem 0}.official-sources a{text-decoration:underline;text-underline-offset:.2em;overflow-wrap:anywhere}.official-sources summary:focus-visible{outline:2px solid var(--blue);outline-offset:5px}</style>
