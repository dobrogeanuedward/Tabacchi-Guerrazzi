---
import {text} from '../data/shop';
const {sources=[],lang='it',research=false,checked}=Astro.props;
const sourceNote=research?text(lang,'Repertori botanici, studi e schede museali: ogni fonte documenta il tema o l’esemplare indicato.','Botanical records, research and museum records: each source documents its stated subject or specimen.'):text(lang,'Testi pubblicati dagli enti indicati; le schede non sostituiscono il testo normativo vigente.','Texts published by the listed public bodies; these guides do not replace current legislation.');
const checkedLabel=checked?text(lang,checked,checked==='11 ottobre 2026'?'11 October 2026':checked):text(lang,'9 ottobre 2026','9 October 2026');
---
{sources.length>0&&<aside class="official-sources"><h2>{research?text(lang,'Fonti e documentazione','Sources and documentation'):text(lang,'Fonti ufficiali','Official sources')}</h2><p>{`${sourceNote} ${text(lang,'Verifica editoriale:','Editorial check:')} ${checkedLabel}.`}</p><ul>{sources.map((s:any)=><li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul></aside>}
<style>.official-sources{margin:2.5rem 0;padding:1.5rem 0;border-top:1px solid #cad6e5;max-width:72ch}.official-sources p,.official-sources li{font-size:.9rem;line-height:1.75}.official-sources a{text-decoration:underline;text-underline-offset:.2em;overflow-wrap:anywhere}.official-sources li{margin:.7rem 0}</style>
