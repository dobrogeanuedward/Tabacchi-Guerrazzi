---
interface Props {entries:{href:string;title:string}[];title:string;lang?:'it'|'en';}
const {entries,title,lang='it'}=Astro.props;
---
<nav class="reading-index" data-reading-index aria-label={title}>
 <div class="reading-index-heading"><h2>{title}</h2><span data-reading-step aria-hidden="true">0 / {entries.length}</span></div>
 <progress class="reading-progress" data-reading-progress max={entries.length} value="0" aria-label={lang==='it'?'Sezione raggiunta':'Current section'}></progress>
 <ol>{entries.map((entry,i)=><li><a href={entry.href}><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{entry.title}</span></a></li>)}</ol>
</nav>
<script>
 document.querySelectorAll<HTMLElement>('[data-reading-index]').forEach(root=>{
  const links=[...root.querySelectorAll<HTMLAnchorElement>('ol a')];
  const sections=links.map(link=>document.getElementById(link.hash.slice(1)));
  const progress=root.querySelector<HTMLProgressElement>('[data-reading-progress]');
  const step=root.querySelector<HTMLElement>('[data-reading-step]');
  let scheduled=false;
  const update=()=>{
   scheduled=false;let active=-1;
   sections.forEach((section,i)=>{if(section&&section.getBoundingClientRect().top<=window.innerHeight*.38)active=i;});
   links.forEach((link,i)=>{if(i===active)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');});
   if(progress)progress.value=active+1;
   if(step)step.textContent=`${active+1} / ${links.length}`;
  };
  const schedule=()=>{if(!scheduled){scheduled=true;requestAnimationFrame(update);}};
  window.addEventListener('scroll',schedule,{passive:true});window.addEventListener('resize',schedule);update();
 });
</script>
<style>
 .reading-index{position:sticky;top:28px;min-width:0;padding:24px 0 12px;border-top:2px solid var(--accent);align-self:start;color:var(--accent)}
 .reading-index-heading{display:flex;gap:15px;justify-content:space-between;align-items:baseline;margin-bottom:16px}
 .reading-index-heading h2{font:600 .95rem/1.6 var(--sans);letter-spacing:0;margin:0;color:inherit}
 .reading-index-heading>span{font:400 .95rem/1.6 var(--sans);white-space:nowrap;font-variant-numeric:tabular-nums}
 .reading-progress{appearance:none;display:block;width:100%;height:2px;border:0;background:#dcd8cf;color:var(--accent);margin:0 0 13px}
 .reading-progress::-webkit-progress-bar{background:#dcd8cf}
 .reading-progress::-webkit-progress-value{background:var(--accent)}
 .reading-progress::-moz-progress-bar{background:var(--accent)}
 .reading-index ol{list-style:none;padding:0;margin:0}
 .reading-index li+li{border-top:1px solid color-mix(in srgb,var(--accent) 18%,transparent)}
 .reading-index a{display:grid;grid-template-columns:27px minmax(0,1fr);gap:9px;align-items:start;min-height:48px;margin:0;padding:13px 7px 13px 0;font:400 .95rem/1.65 var(--sans);color:#666056}
 .reading-index a>span:first-child{font-variant-numeric:tabular-nums;color:var(--accent)}
 .reading-index a[aria-current]{color:var(--accent);font-weight:600;background:color-mix(in srgb,var(--surface) 65%,transparent)}
 .reading-index a:hover{text-decoration:underline;text-underline-offset:4px;color:var(--accent)}
 .reading-index a:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
 @media(max-width:820px){.reading-index{position:static;padding:21px;border:1px solid color-mix(in srgb,var(--accent) 25%,#ddd4c5);background:var(--surface)}.reading-index a{color:var(--ink);min-height:44px;padding-block:10px}}
</style>
