---
import PhotoGallery from './PhotoGallery.astro';
import {categoryPhotosFor,withHistoricalPhoto} from '../data/fototeca';
import {text,type Lang} from '../data/shop';
const {lang='it'}=Astro.props as {lang:Lang};
const spacePhotos=(id:string)=>id==='interno-negozio'?[]:categoryPhotosFor(id==='esterno-portico'?'contatti':'giochi-e-giocattoli');
const spaces=[{id:'esterno-portico',title:['Sotto il portico.','Under the portico.'],body:['Due vetrine, l’ingresso e la piccola cabina rossa. Il nostro punto di Via Guerrazzi si riconosce anche passando a piedi.','Two windows, the entrance and the little red telephone box. Our place on Via Guerrazzi is easy to recognise on a walk.']},{id:'interno-negozio',title:['Una bottega, tante piccole cose.','One shop, lots of little things.'],body:['Mensole illuminate, vetrine in legno e vetro, il banco sul fondo. Fra il papiro e l’orologio, gli oggetti e le abitudini di chi passa ogni giorno.','Illuminated shelves, wood-and-glass cabinets and the counter at the back. Between the papyrus and clock, objects and the routines of everyday visitors.']},{id:'vetrina-giochi',title:['La prima scoperta è in vetrina.','The first discovery is in the window.'],body:['Modellini, costruzioni, piccoli personaggi, colori e sorprese. Fermarsi a guardare è già un modo di cominciare la visita.','Models, building sets, little characters, colours and surprises. Stopping to look is already the beginning of a visit.']}];const l=lang==='it'?0:1;
---
<section class="shop-spaces" aria-labelledby="shop-spaces-title"><header><p class="section-label">{text(lang,'Via Guerrazzi 10/F','Via Guerrazzi 10/F')}</p><h2 id="shop-spaces-title">{text(lang,'Ti facciamo entrare.','Come inside.')}</h2></header>{spaces.map((space,i)=><figure class:list={['space-scene',{'is-reverse':i===1}]}><PhotoGallery photos={withHistoricalPhoto(spacePhotos(space.id),{src:`/images/collection/${space.id}.webp`,srcset:`/images/collection/${space.id}-720.webp 720w, /images/collection/${space.id}.webp 1440w`,width:1440,height:960,alt:{it:space.title[0],en:space.title[1]}})} lang={lang} caption={false}/><figcaption><span class="space-index">0{i+1}</span><h3>{space.title[l]}</h3><p>{space.body[l]}</p></figcaption></figure>)}</section>
<section class="shop-orientation" aria-labelledby="shop-orientation-title"><header><p class="section-label">{text(lang,'Gli spazi della bottega','The shop’s spaces')}</p><h2 id="shop-orientation-title">{text(lang,'Per orientarti, entrando.','Finding your way inside.')}</h2><p>{text(lang,'Uno schema orientativo, senza scala: le aree principali guardando il negozio dal portico.','An orientation sketch, not to scale: the main areas when looking into the shop from the portico.')}</p></header><div class="orientation-sketch"><div class="orientation-counter"><strong>{text(lang,'Banco e scaffali','Counter and shelves')}</strong><span>{text(lang,'Sul fondo del negozio','At the back of the shop')}</span></div><div class="orientation-left"><strong>{text(lang,'Regali e calamite','Gifts and magnets')}</strong><span>{text(lang,'Parete sinistra interna','Inside left wall')}</span></div><div class="orientation-centre"><strong>{text(lang,'Espositori in vetro e legno','Glass-and-wood cabinets')}</strong><span>{text(lang,'Zona centrale','Central area')}</span></div><div class="orientation-window"><strong>{text(lang,'Vetrina giochi','Toy window')}</strong><span>{text(lang,'Modellini, costruzioni e personaggi','Models, building sets and characters')}</span></div><div class="orientation-entrance"><strong>{text(lang,'Ingresso','Entrance')}</strong><span>{text(lang,'Cabina rossa al lato','Red telephone box beside it')}</span></div><div class="orientation-dispenser"><strong>{text(lang,'Distributore h24','24-hour dispenser')}</strong><span>{text(lang,'A destra dell’ingresso','To the right of the entrance')}</span></div><div class="orientation-portico">{text(lang,'Portico · Via Guerrazzi','Portico · Via Guerrazzi')}</div></div></section>
<style>
.shop-orientation{margin-block:20px 60px;border-top:1px solid var(--line);padding-top:35px}.shop-orientation header{max-width:720px;margin-bottom:30px}.shop-orientation h2{font:400 clamp(2rem,3vw,3rem)/1.16 var(--display);color:var(--accent);margin-bottom:20px}.shop-orientation header>p:last-child{line-height:1.85;font-size:.95rem}.orientation-sketch{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;padding:24px;background:var(--surface);border:1px solid var(--line)}.orientation-sketch>div{min-width:0;padding:24px;border:1px solid var(--line);display:flex;flex-direction:column;justify-content:center;gap:12px;background:#fffdfa}.orientation-sketch strong{font:400 clamp(1.35rem,2.1vw,1.8rem)/1.2 var(--display);color:var(--accent);overflow-wrap:anywhere}.orientation-sketch span{font-size:.85rem;line-height:1.7}.orientation-counter{grid-column:1/-1;text-align:center}.orientation-left{grid-column:1/3}.orientation-centre{grid-column:3/-1;min-height:155px}.orientation-window{grid-column:1/4}.orientation-entrance{grid-column:4/-1}.orientation-sketch>.orientation-dispenser{grid-column:4/-1;background:#eaf0fa}.orientation-sketch>.orientation-portico{grid-column:1/-1;background:transparent;border:0;padding:10px;text-align:center;font-size:.9rem;color:var(--accent)}@media(max-width:680px){.orientation-sketch{grid-template-columns:repeat(2,minmax(0,1fr));padding:14px;gap:10px}.orientation-sketch>div{padding:17px}.orientation-left,.orientation-window{grid-column:1/2}.orientation-centre,.orientation-entrance{grid-column:2/3}.orientation-sketch>.orientation-dispenser{grid-column:1/-1}}
.shop-spaces{margin-block:45px 60px}.shop-spaces>header{margin-bottom:35px}.shop-spaces h2{font:400 clamp(2.3rem,4vw,3.5rem)/1.12 var(--display);color:var(--accent)}.space-scene{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);align-items:center;gap:40px;margin:0 0 45px}.space-scene.is-reverse{grid-template-columns:minmax(0,1fr) minmax(0,1.6fr)}.is-reverse>:global(.photo-gallery){order:2}.space-scene img{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}.space-index{font:400 2.6rem/1 var(--display);color:var(--accent);display:block;margin-bottom:20px}.space-scene h3{font:400 clamp(1.8rem,2.7vw,2.5rem)/1.18 var(--display);color:var(--accent);margin-bottom:18px}.space-scene p{font-size:.98rem;line-height:1.9}@media(max-width:720px){.space-scene,.space-scene.is-reverse{grid-template-columns:1fr;gap:23px}.is-reverse>:global(.photo-gallery){order:0}.space-index{margin-bottom:12px}}
</style>
