# Canonical public domain. Without it, production stays noindex.
PUBLIC_SITE_URL=
# A durable directory for database and uploaded photos, outside the source checkout.
DATA_DIR=./data
# Set true ONLY after shop data, rights and legal text have been verified.
PUBLIC_LAUNCH_READY=false
# Optional approved hero videos. Leave blank until delivered.
PUBLIC_HERO_VIDEO=
PUBLIC_HERO_VIDEO_MOBILE=
# DOGO R2: configure these as server secrets, never PUBLIC_ variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dogostudio
# Production local uploads require an explicitly persistent DATA_DIR.
ALLOW_LOCAL_UPLOADS=false
