# Confirmed canonical public domain; preview builds remain noindex by default.
PUBLIC_SITE_URL=https://guerrazzidiangela.it
# A durable directory for database and uploaded photos, outside the source checkout.
DATA_DIR=./data
# Production launch was explicitly authorized on 20 October 2026.
# The readiness report keeps owner-deferred identity/privacy work as warnings.
# Keep false for unlaunched preview environments.
PUBLIC_LAUNCH_READY=false
# Optional approved hero videos. Leave blank until delivered.
PUBLIC_HERO_VIDEO=
PUBLIC_HERO_VIDEO_MOBILE=
# DOGO R2: configure these as server secrets, never PUBLIC_ variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dogostudio
# Production local uploads require an explicitly persistent DATA_DIR.
ALLOW_LOCAL_UPLOADS=false
